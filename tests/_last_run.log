    def _attend_termine(client, job_id: str, timeout: int = 300):
        deadline = time.time() + timeout
        while time.time() < deadline:
            r = client.get(f"/api/jobs/{job_id}")
            if r.status_code == 200:
                etat = r.json().get("status")
                if etat in ("done", "failed"):
                    return r.json()
            time.sleep(0.5)
