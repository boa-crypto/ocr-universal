{
  "$defs": {
    "SourceMesuresDocumentaires": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "titre": {
          "minLength": 1,
          "title": "Titre",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "organisme": {
          "minLength": 1,
          "title": "Organisme",
          "type": "string"
        },
        "version_source": {
          "minLength": 1,
          "title": "Version Source",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "format": {
          "enum": [
            "json",
            "csv",
            "xlsx",
            "xls",
            "pdf"
          ],
          "title": "Format",
          "type": "string"
        },
        "date_publication": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date Publication"
        },
        "verification": {
          "const": "non_verifiee",
          "default": "non_verifiee",
          "title": "Verification",
          "type": "string"
        }
      },
      "required": [
        "id",
        "titre",
        "url",
        "organisme",
        "version_source",
        "sha256",
        "format"
      ],
      "title": "SourceMesuresDocumentaires",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/SourceMesuresDocumentaires"
    },
    "statut": {
      "const": "quarantaine",
      "default": "quarantaine",
      "title": "Statut",
      "type": "string"
    },
    "validation_juridique": {
      "const": "non_validee",
      "default": "non_validee",
      "title": "Validation Juridique",
      "type": "string"
    },
    "publication_active": {
      "const": false,
      "default": false,
      "title": "Publication Active",
      "type": "boolean"
    },
    "colonnes": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Colonnes"
    },
    "delimiteur": {
      "default": ";",
      "title": "Delimiteur",
      "type": "string"
    },
    "feuille": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Feuille"
    },
    "ligne_entete": {
      "default": 1,
      "maximum": 50,
      "minimum": 1,
      "title": "Ligne Entete",
      "type": "integer"
    }
  },
  "required": [
    "source"
  ],
  "title": "ConfigurationMesuresAutonomes",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Préparation autonome de mesures déclarées, aucune validation ou applicabilité juridique."
}
