{
  "$defs": {
    "ArchivesExport": {
      "additionalProperties": false,
      "properties": {
        "avant": {
          "$ref": "#/$defs/ProvenanceExport"
        },
        "apres": {
          "$ref": "#/$defs/ProvenanceExport"
        }
      },
      "required": [
        "avant",
        "apres"
      ],
      "title": "ArchivesExport",
      "type": "object"
    },
    "JsonValue": {},
    "ProvenanceExport": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "properties": {
        "manifest_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        }
      },
      "required": [
        "manifest_sha256"
      ],
      "title": "ProvenanceExport",
      "type": "object"
    },
    "RapportDiffExport": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "properties": {
        "archives": {
          "$ref": "#/$defs/ArchivesExport"
        }
      },
      "required": [
        "archives"
      ],
      "title": "RapportDiffExport",
      "type": "object"
    },
    "RapportSimpleExport": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "properties": {
        "archive": {
          "$ref": "#/$defs/ProvenanceExport"
        }
      },
      "required": [
        "archive"
      ],
      "title": "RapportSimpleExport",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "type_export": {
      "const": "rapport_revue_documentaire_non_valide",
      "title": "Type Export",
      "type": "string"
    },
    "lecture_seule": {
      "const": true,
      "title": "Lecture Seule",
      "type": "boolean"
    },
    "publication_active": {
      "const": false,
      "title": "Publication Active",
      "type": "boolean"
    },
    "validation_juridique": {
      "const": "non_validee",
      "title": "Validation Juridique",
      "type": "string"
    },
    "perimetre": {
      "const": "rapport_ou_page_uniquement_pas_corpus_complet",
      "title": "Perimetre",
      "type": "string"
    },
    "horodatage_client_non_certifie": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "title": "Horodatage Client Non Certifie",
      "type": "string"
    },
    "requete_relative": {
      "maxLength": 16384,
      "pattern": "^/api/v1/customs-review/(?:diff|article-diff|lots/[A-Za-z0-9][A-Za-z0-9_-]{0,63}/(?:check|search|history|coverage|tree|article|article-diff|article-pdf-match|code-tree|pdf|tariff/[0-9]{10}))(?:\\?[^#\\x00-\\x20]*)?$",
      "title": "Requete Relative",
      "type": "string"
    },
    "resultat": {
      "anyOf": [
        {
          "$ref": "#/$defs/RapportSimpleExport"
        },
        {
          "$ref": "#/$defs/RapportDiffExport"
        }
      ],
      "title": "Resultat"
    }
  },
  "required": [
    "schema_version",
    "type_export",
    "lecture_seule",
    "publication_active",
    "validation_juridique",
    "perimetre",
    "horodatage_client_non_certifie",
    "requete_relative",
    "resultat"
  ],
  "title": "ExportRevue",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Structure export revue v1, non preuve d’authenticité. Le CLI applique aussi les contrôles de calendrier, route/provenance, marqueurs et limites JSON."
}
