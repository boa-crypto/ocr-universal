{
  "$defs": {
    "DocumentJuridique": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "titre": {
          "minLength": 1,
          "title": "Titre",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "organisme": {
          "minLength": 1,
          "title": "Organisme",
          "type": "string"
        },
        "version_source": {
          "minLength": 1,
          "title": "Version Source",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "format": {
          "const": "pdf",
          "title": "Format",
          "type": "string"
        },
        "date_publication": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date Publication"
        },
        "verification": {
          "const": "non_verifiee",
          "default": "non_verifiee",
          "title": "Verification",
          "type": "string"
        },
        "nature_document": {
          "enum": [
            "code_original",
            "acte_modificatif",
            "compilation"
          ],
          "title": "Nature Document",
          "type": "string"
        }
      },
      "required": [
        "id",
        "titre",
        "url",
        "organisme",
        "version_source",
        "sha256",
        "format",
        "nature_document"
      ],
      "title": "DocumentJuridique",
      "type": "object"
    },
    "DocumentJuridiqueRecu": {
      "additionalProperties": false,
      "description": "Copie utilisateur sans URL inventée ; distincte d'une référence officielle.",
      "properties": {
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "titre": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Titre",
          "type": "string"
        },
        "url": {
          "default": null,
          "title": "Url",
          "type": "null"
        },
        "organisme": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Organisme",
          "type": "string"
        },
        "version_source": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Version Source",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "format": {
          "const": "pdf",
          "default": "pdf",
          "title": "Format",
          "type": "string"
        },
        "nature_document": {
          "enum": [
            "code_original",
            "acte_modificatif",
            "compilation"
          ],
          "title": "Nature Document",
          "type": "string"
        },
        "date_publication": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date Publication"
        },
        "verification": {
          "const": "non_verifiee",
          "default": "non_verifiee",
          "title": "Verification",
          "type": "string"
        },
        "provenance": {
          "const": "piece_jointe_utilisateur",
          "title": "Provenance",
          "type": "string"
        },
        "nom_fichier_recu": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Nom Fichier Recu",
          "type": "string"
        }
      },
      "required": [
        "id",
        "titre",
        "organisme",
        "version_source",
        "sha256",
        "nature_document",
        "provenance",
        "nom_fichier_recu"
      ],
      "title": "DocumentJuridiqueRecu",
      "type": "object"
    },
    "EntreeDocument": {
      "additionalProperties": false,
      "properties": {
        "document": {
          "anyOf": [
            {
              "$ref": "#/$defs/DocumentJuridique"
            },
            {
              "$ref": "#/$defs/DocumentJuridiqueRecu"
            }
          ],
          "title": "Document"
        },
        "fichier_recu": {
          "minLength": 1,
          "title": "Fichier Recu",
          "type": "string"
        }
      },
      "required": [
        "document",
        "fichier_recu"
      ],
      "title": "EntreeDocument",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "documents": {
      "items": {
        "$ref": "#/$defs/EntreeDocument"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Documents",
      "type": "array"
    }
  },
  "required": [
    "documents"
  ],
  "title": "MetadataCode",
  "type": "object"
}
