{
  "name": "port_bl",
  "label": "Portuaire — Bill of Lading",
  "description": "Connaissement maritime : BL, conteneurs (validation ISO 6346), navire, ports, marchandises.",
  "document_types": [
    "bill_of_lading"
  ],
  "fields": [
    {
      "key": "bl_number",
      "label": "Bill of Lading (BL)",
      "patterns": [
        "(?:B/?L|Bill\\s*of\\s*Lading)(?:\\s*(?:No\\.?|N[°o]|Number))?\\s*[:#]?\\s*([A-Z0-9][A-Z0-9\\-/_]{4,20})",
        "^([A-Z]{4}\\d{6,12})$"
      ],
      "required": true,
      "validators": [
        "not_empty"
      ],
      "category": "identifiants",
      "normalize": "upper"
    },
    {
      "key": "booking_number",
      "label": "Booking Number",
      "patterns": [
        "(?:Booking|BKG|BK\\s*No\\.?|R[ée]servation)\\s*(?:Number|N[°o]|No\\.?)?\\s*[:#]?\\s*([A-Z0-9][A-Z0-9\\-/_]{4,20})"
      ],
      "category": "identifiants",
      "normalize": "upper"
    },
    {
      "key": "container_number",
      "label": "N° de conteneur",
      "patterns": [
        "\\b([A-Z]{4}[\\s-]?\\d{7})\\b"
      ],
      "required": true,
      "validators": [
        "iso6346"
      ],
      "category": "identifiants",
      "normalize": "upper",
      "multiline": true
    },
    {
      "key": "iso_type_code",
      "label": "ISO Container Type Code",
      "patterns": [
        "(?:ISO|type|type\\s*code|code\\s*type)\\s*[:#]?\\s*(\\d{2}[A-Z]\\d)\\b"
      ],
      "validators": [
        "container_type"
      ],
      "category": "identifiants",
      "normalize": "upper"
    },
    {
      "key": "seal_number",
      "label": "Seal Number",
      "patterns": [
        "(?:Seal|Sceau|N°\\s*sceau)\\s*(?:Number|N[°o]|No\\.?)?\\s*[:#]?\\s*([A-Z0-9\\-]{4,20})"
      ],
      "category": "identifiants",
      "normalize": "upper"
    },
    {
      "key": "vessel_name",
      "label": "Vessel Name",
      "patterns": [
        "(?:Vessel(?:\\s*Name)?|Navire|M/V|MV|Ship)\\b\\s*[:#]?\\s*([A-Z][A-Z \\t'’\\.\\-]{2,40})"
      ],
      "category": "transport",
      "normalize": "upper"
    },
    {
      "key": "voyage_number",
      "label": "Voyage Number",
      "patterns": [
        "(?:Voyage|Voy\\.?|N°\\s*voyage)\\s*(?:Number|No\\.?|N[°o])?\\s*[:#]?\\s*([A-Z0-9\\-]{2,15})"
      ],
      "category": "transport",
      "normalize": "upper"
    },
    {
      "key": "shipping_line",
      "label": "Shipping Line",
      "patterns": [
        "(?:Carrier|Shipping\\s*Line|Armateur|Ligne)\\s*[:#]?\\s*([A-Z][A-Z \\t&'’\\.\\-]{2,50})"
      ],
      "category": "transport",
      "normalize": "upper"
    },
    {
      "key": "shipper",
      "label": "Shipper (expéditeur)",
      "patterns": [
        "(?:Shipper|Exp[ée]diteur|Exporter)\\s*[:#]?\\s*([^\\n]{3,120})"
      ],
      "category": "parties",
      "normalize": "generic"
    },
    {
      "key": "consignee",
      "label": "Consignee (destinataire)",
      "patterns": [
        "(?:Consignee|Destinataire|Consignataire)\\s*[:#]?\\s*([^\\n]{3,120})"
      ],
      "category": "parties",
      "normalize": "generic"
    },
    {
      "key": "notify_party",
      "label": "Notify Party",
      "patterns": [
        "(?:Notify\\s*Party|Partie\\s*notifi[ée]e|Notifier)\\s*[:#]?\\s*([^\\n]{3,120})"
      ],
      "category": "parties",
      "normalize": "generic"
    },
    {
      "key": "port_of_loading",
      "label": "Port of Loading",
      "patterns": [
        "(?:Port\\s*of\\s*Loading|Port\\s*d['’]embarquement|POL)\\s*[:#]?\\s*([^\\n]{2,60})"
      ],
      "category": "transport",
      "normalize": "generic"
    },
    {
      "key": "port_of_discharge",
      "label": "Port of Discharge",
      "patterns": [
        "(?:Port\\s*of\\s*Discharge|Port\\s*de\\s*d[ée]chargement|POD)\\s*[:#]?\\s*([^\\n]{2,60})"
      ],
      "category": "transport",
      "normalize": "generic"
    },
    {
      "key": "place_of_receipt",
      "label": "Place of Receipt",
      "patterns": [
        "(?:Place\\s*of\\s*Receipt|Lieu\\s*de\\s*r[ée]ception)\\s*[:#]?\\s*([^\\n]{2,60})"
      ],
      "category": "transport",
      "normalize": "generic"
    },
    {
      "key": "place_of_delivery",
      "label": "Place of Delivery",
      "patterns": [
        "(?:Place\\s*of\\s*Delivery|Lieu\\s*de\\s*livraison)\\s*[:#]?\\s*([^\\n]{2,60})"
      ],
      "category": "transport",
      "normalize": "generic"
    },
    {
      "key": "goods_description",
      "label": "Description des marchandises",
      "patterns": [
        "(?:Description\\s*of\\s*[Gg]oods|Description\\s*des\\s*marchandises|Goods|Marchandises)\\s*[:#]?\\s*([^\\n]{5,200})"
      ],
      "category": "cargaison",
      "normalize": "generic"
    },
    {
      "key": "packages_count",
      "label": "Nombre de colis",
      "patterns": [
        "(?:Packages|Colis|Nb\\s*colis|Number\\s*of\\s*packages)\\s*[:#]?\\s*(\\d{1,6})"
      ],
      "category": "cargaison",
      "normalize": "digits"
    },
    {
      "key": "gross_weight",
      "label": "Poids brut",
      "patterns": [
        "(?:Gross\\s*[Ww]eight|Poids\\s*brut|Gross\\s*Wt\\.?)\\s*[:#]?\\s*(\\d{1,3}(?:[ .,\\u00a0\\u202f]\\d{3})+(?:[.,]\\d{1,3})?|\\d+(?:[.,]\\d{1,3})?)\\s*(KG|kg|KGS|T|MT|LB)?"
      ],
      "category": "cargaison",
      "normalize": "amount"
    },
    {
      "key": "net_weight",
      "label": "Poids net",
      "patterns": [
        "(?:Net\\s*[Ww]eight|Poids\\s*net|Net\\s*Wt\\.?)\\s*[:#]?\\s*(\\d{1,3}(?:[ .,\\u00a0\\u202f]\\d{3})+(?:[.,]\\d{1,3})?|\\d+(?:[.,]\\d{1,3})?)\\s*(KG|kg|KGS|T|MT|LB)?"
      ],
      "category": "cargaison",
      "normalize": "amount"
    },
    {
      "key": "volume",
      "label": "Volume",
      "patterns": [
        "(?:Volume|CBM|M3|m³)\\s*[:#]?\\s*(\\d+(?:[.,]\\d{1,3})?)\\s*(M3|m3|m³|CBM)?"
      ],
      "category": "cargaison",
      "normalize": "generic"
    },
    {
      "key": "hs_code",
      "label": "HS Code",
      "patterns": [
        "(?:HS\\s*Code|Code\\s*SH|SH\\s*Code|Commodity\\s*code)\\s*[:#]?\\s*(\\d{4}[\\s.\\-]?\\d{2}(?:[\\s.\\-]?\\d{2})?)"
      ],
      "category": "cargaison",
      "normalize": "digits"
    },
    {
      "key": "marks_numbers",
      "label": "Marks and Numbers",
      "patterns": [
        "(?:Marks\\s*(?:&|and)\\s*Numbers|Marques\\s*et\\s*num[ée]ros|Marks)\\s*[:#]?\\s*([^\\n]{2,120})"
      ],
      "category": "cargaison",
      "normalize": "generic"
    },
    {
      "key": "eta",
      "label": "ETA",
      "patterns": [
        "(?:ETA|Estimated\\s*[Aa]rrival|Arriv[ée]e\\s*estim[ée]e)\\s*[:#]?\\s*(\\d{1,2}[/.\\-]\\d{1,2}[/.\\-]\\d{2,4}|\\d{4}-\\d{2}-\\d{2})"
      ],
      "category": "dates",
      "normalize": "date"
    },
    {
      "key": "etd",
      "label": "ETD",
      "patterns": [
        "(?:ETD|Estimated\\s*[Dd]eparture|D[ée]part\\s*estim[ée])\\s*[:#]?\\s*(\\d{1,2}[/.\\-]\\d{1,2}[/.\\-]\\d{2,4}|\\d{4}-\\d{2}-\\d{2})"
      ],
      "category": "dates",
      "normalize": "date"
    },
    {
      "key": "manifest_number",
      "label": "N° de manifeste",
      "patterns": [
        "(?:Manifest(?:e)?|MAN)\\s*(?:Number|N[°o]|No\\.?)?\\s*[:#]?\\s*([A-Z0-9\\-/_]{4,25})"
      ],
      "category": "douane",
      "normalize": "upper"
    },
    {
      "key": "customs_reference",
      "label": "Référence douanière",
      "patterns": [
        "(?:Customs|Douane|D[ée]claration)\\s*(?:Ref[érence]*\\.?|N[°o]|No\\.?)?\\s*[:#]?\\s*([A-Z0-9\\-/_]{4,25})"
      ],
      "category": "douane",
      "normalize": "upper"
    },
    {
      "key": "invoice_number",
      "label": "Référence facture",
      "patterns": [
        "(?:Invoice\\s*(?:No\\.?|N[°o]|Number|ref\\w*)|Facture\\s*(?:N[°o]|num[ée]ro)?)\\s*[:#]?\\s*(?!(?:invoice|facture|num[ée]ro|number|n[°o]\\b|no\\b|ref\\b|B/?L\\b)[:\\s])([A-Z0-9][A-Z0-9\\-/_]{2,30})"
      ],
      "required": false,
      "validators": [],
      "normalize": "upper",
      "category": "identifiants",
      "multiline": false
    }
  ],
  "relations": [
    {
      "type": "date_order",
      "before": "etd",
      "after": "eta",
      "message": "ETA antérieur à ETD"
    }
  ],
  "consistency_checks": [],
  "export_rules": {
    "primary_keys": [
      "bl_number",
      "container_number"
    ],
    "keep_row_relations": true
  }
}
