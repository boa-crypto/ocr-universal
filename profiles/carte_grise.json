{
  "name": "carte_grise",
  "label": "Carte grise / certificat d'immatriculation",
  "description": "Carte grise (FR/DZ) : plaque, VIN, marque, modèle, énergie, date de 1re immatriculation, puissances, PTAC, couleur, titulaire.",
  "document_types": [
    "vehicle_registration",
    "carte_grise"
  ],
  "fields": [
    {
      "key": "plate_number",
      "label": "Plaque d'immatriculation",
      "patterns": [
        "(?:Plaque|Immat(?:riculation)?|Registration|Num[ée]ro\\s*de\\s*plaqu|الرقم التسجيلي?)\\s*[:#]\\s*([A-Z0-9][A-Z0-9 \\t\\-.]{3,15})",
        "\\b([A-Z]{2}[\\s-]?\\d{3}[\\s-]?[A-Z]{2})\\b",
        "\\b(\\d{3,6}[\\s-]?[A-Z\\u0621-\\u064A]{1,2}[\\s-]?\\d{2})\\b"
      ],
      "required": true,
      "validators": [
        "plate"
      ],
      "category": "identifiants",
      "normalize": "upper"
    },
    {
      "key": "vin",
      "label": "N° d'identification (VIN / châssis)",
      "patterns": [
        "(?:N[°o]\\s*d['’]identification|Num[ée]ro\\s*d['’]identification|VIN|Ch[âa]ssis|الهيكل)\\s*[:#]\\s*([A-HJ-NPR-Z0-9]{15,17})",
        "\\b([A-HJ-NPR-Z0-9]{17})\\b"
      ],
      "validators": [
        "vin",
        "vin_check"
      ],
      "category": "identifiants",
      "normalize": "upper"
    },
    {
      "key": "make",
      "label": "Marque",
      "patterns": [
        "(?:Marque|Make|Brand|الماركة)\\s*[:#]\\s*([A-Za-z0-9][A-Za-z0-9 \\t\\-.]{1,25})"
      ],
      "category": "vehicule",
      "normalize": "generic"
    },
    {
      "key": "model",
      "label": "Désignation / modèle",
      "patterns": [
        "(?:D[ée]signation(?:\\s*commerciale)?|Mod[èe]le|Model|Type\\s*commercial)\\s*[:#]\\s*([^\\n]{2,40})"
      ],
      "category": "vehicule",
      "normalize": "generic"
    },
    {
      "key": "fuel",
      "label": "Énergie / carburant",
      "patterns": [
        "(?:Énergie|Energie|Energy|Carburant|Fuel|الطاقة|الوقود)\\s*[:#]\\s*([A-Za-zÀ-ÿ0-9 \\-/]{2,24})"
      ],
      "validators": [
        "energy"
      ],
      "category": "vehicule",
      "normalize": "generic"
    },
    {
      "key": "first_reg_date",
      "label": "Date de 1re immatriculation (mise en circulation)",
      "patterns": [
        "(?:[1lI]\\s*è?re?\\s*immat(?:riculation)?|Premi[èe]re\\s*immat(?:riculation)?|Date\\s*de\\s*mise\\s*en\\s*circulation|Mise\\s*en\\s*circulation|In\\s*service|تاريخ الاستغلال)[^\\n]{0,14}?(\\d{1,2}[/.-]\\d{1,2}[/.-]\\d{2,4}|\\d{4}-\\d{2}-\\d{2}|\\d{1,2}[/.-]\\d{4})"
      ],
      "validators": [
        "date_iso"
      ],
      "category": "dates",
      "normalize": "date"
    },
    {
      "key": "certif_date",
      "label": "Date du certificat",
      "patterns": [
        "(?:Date\\s*du\\s*certificat|Certificat\\s*du|Date\\s*d['’]immatriculation\\s*du\\s*certificat)[^\\n]{0,14}?(\\d{1,2}[/.-]\\d{1,2}[/.-]\\d{2,4}|\\d{4}-\\d{2}-\\d{2}|\\d{1,2}[/.-]\\d{4})"
      ],
      "validators": [
        "date_iso"
      ],
      "category": "dates",
      "normalize": "date"
    },
    {
      "key": "fiscal_power",
      "label": "Puissance fiscale (CV)",
      "patterns": [
        "(?:Puissance\\s*fiscale|P\\.?\\s*F\\.?|Fiscal\\s*power)\\s*[:#]\\s*(\\d{1,3})\\s*(?:CV|ch|HP)?"
      ],
      "category": "vehicule",
      "normalize": "digits"
    },
    {
      "key": "power_kw",
      "label": "Puissance DIN (kW)",
      "patterns": [
        "(?:Puissance\\s*DIN|P\\.?\\s*DIN)\\s*[:#]\\s*(\\d{1,4})\\s*(?:kW)?"
      ],
      "category": "vehicule",
      "normalize": "digits"
    },
    {
      "key": "ptac",
      "label": "PTAC (poids total autorisé en charge)",
      "patterns": [
        "(?:PTAC|P\\.?T\\.?A\\.?C\\.?|Poids\\s*total\\s*autoris[ée]\\s*en\\s*charge)\\s*[:#]\\s*(\\d{2,5})\\s*(?:kg|KG|kgs)?"
      ],
      "category": "vehicule",
      "normalize": "digits"
    },
    {
      "key": "seats",
      "label": "Nombre de places",
      "patterns": [
        "(?:Places|Nombre\\s*de\\s*places|Nb\\s*places|Seats)\\s*[:#]\\s*(\\d{1,2})"
      ],
      "category": "vehicule",
      "normalize": "digits"
    },
    {
      "key": "color",
      "label": "Couleur",
      "patterns": [
        "(?:Couleur|Color|اللون)\\s*[:#]\\s*([A-Za-zÀ-ÿ]{3,15})"
      ],
      "category": "vehicule",
      "normalize": "generic"
    },
    {
      "key": "co2",
      "label": "Émissions de CO2",
      "patterns": [
        "(?:CO2|CO₂|[ÉE]missions?\\s*de\\s*CO2)\\s*[:#]\\s*(\\d{1,3})\\s*(?:g/km|g)?"
      ],
      "category": "vehicule",
      "normalize": "digits"
    },
    {
      "key": "holder",
      "label": "Titulaire",
      "patterns": [
        "(?:Titulaire|Propri[ée]taire|Owner|Holder|Donneur\\s*d['’]ordre)\\s*[:#]\\s*([^\\n]{3,60})"
      ],
      "category": "parties",
      "normalize": "generic"
    },
    {
      "key": "engine_number",
      "label": "N° moteur",
      "patterns": [
        "(?:N[°o]\\s*(?:du?\\s*)?moteur|Engine|Motor|رقم المحرك)\\s*[:#]\\s*([A-Z0-9]{4,20})"
      ],
      "category": "identifiants",
      "normalize": "upper"
    },
    {
      "key": "cylinder",
      "label": "Cylindrée (cm3)",
      "patterns": [
        "(?:Cylindr[ée]e|السعة)\\s*[:#]\\s*(\\d{2,5})\\s*(?:cm3|cm³|CC)?"
      ],
      "category": "vehicule",
      "normalize": "digits"
    },
    {
      "key": "empty_weight",
      "label": "Poids à vide (kg)",
      "patterns": [
        "(?:Poids\\s*[àa]\\s*vide|PV|الوزن الفارغ)\\s*[:#]\\s*(\\d{2,5})\\s*(?:kg|KG)?"
      ],
      "category": "vehicule",
      "normalize": "digits"
    },
    {
      "key": "genre",
      "label": "Genre (usage)",
      "patterns": [
        "(?:Genre|Usage|الصنف)\\s*[:#]\\s*([A-Za-zÀ-ÿ]{3,20})"
      ],
      "category": "vehicule",
      "normalize": "generic"
    },
    {
      "key": "doc_number",
      "label": "N° de la carte / de série",
      "patterns": [
        "(?:N[°o]\\s*de\\s*(?:la\\s*)?carte|N[°o]\\s*de\\s*s[ée]rie|Card\\s*(?:No|Number)|رقم البطاقة)\\s*[:#]\\s*([A-Z0-9\\-]{4,20})"
      ],
      "category": "identifiants",
      "normalize": "upper"
    }
  ],
  "relations": [],
  "consistency_checks": [],
  "export_rules": {
    "primary_keys": [
      "plate_number",
      "vin"
    ],
    "keep_row_relations": false
  }
}