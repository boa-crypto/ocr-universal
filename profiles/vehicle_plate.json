{
  "name": "vehicle_plate",
  "label": "Photo plaque / véhicule",
  "description": "Photo d'une plaque d'immatriculation ou d'un véhicule : plaque (FR, DZ…), n° de châssis VIN, marquages.",
  "document_types": [
    "license_plate",
    "vehicle_photo"
  ],
  "fields": [
    {
      "key": "plate_number",
      "label": "Plaque d'immatriculation",
      "patterns": [
        "(?:Plaque|Immat(?:riculation)?|Registration|Plate|Licen[cs]e)\\s*(?:N[°o]|Number|No\\.?)?\\s*[:#]\\s*([A-Z0-9][A-Z0-9 \\t\\-.]{3,15})",
        "\\b([A-Z]{2}[\\s-]?\\d{3}[\\s-]?[A-Z]{2})\\b",
        "\\b([A-Z]{1,2}[\\s-]?\\d{2,3}[\\s-]?[A-Z]{2})\\b",
        "\\b(\\d{3,6}[\\s-]?[A-Z\\u0621-\\u064A]{1,2}[\\s-]?\\d{2})\\b",
        "\\b(\\d{4}[\\s-]?[A-Z]{3})\\b",
        "\\b([A-Z]{2}[\\s-]?\\d{2}[\\s-]?[A-Z]{2,3})\\b",
        "\\b([1-7][\\s-]?[A-Z]{3}[\\s-]?\\d{2,3})\\b",
        "\\b(\\d{2}[\\s-]?[A-Z]{1,3}[\\s-]?\\d{2,4})\\b",
        "\\b([A-Z]{1,3}[\\s-]?[A-Z]{1,2}[\\s-]?\\d{1,4})\\b",
        "\\b(\\d{1,5}[\\s-]?[A-Z][\\s-]?\\d{1,2})\\b",
        "\\b(\\d{1,4}[\\s-]?[\\u0621-\\u064A]{2,10}[\\s-]?\\d{1,2})\\b"
      ],
      "required": true,
      "validators": [
        "plate"
      ],
      "category": "identifiants",
      "normalize": "upper"
    },
    {
      "key": "vin",
      "label": "N° de châssis (VIN)",
      "patterns": [
        "\\b([A-HJ-NPR-Z0-9]{15,17})\\b"
      ],
      "validators": [
        "vin",
        "vin_check"
      ],
      "category": "identifiants",
      "normalize": "upper"
    },
    {
      "key": "make_model",
      "label": "Marque / modèle (si marqué)",
      "patterns": [
        "(?:Marque|Make|Mod[èe]le|Model)\\s*[:#]\\s*([A-Z0-9][A-Za-z0-9 \\t\\-]{1,30})"
      ],
      "category": "general",
      "normalize": "generic"
    }
  ],
  "relations": [],
  "consistency_checks": [],
  "export_rules": {
    "primary_keys": [
      "plate_number"
    ],
    "keep_row_relations": false
  }
}