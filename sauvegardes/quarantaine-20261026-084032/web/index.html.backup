<!DOCTYPE html>
<html lang="fr" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="manifest" href="/manifest.webmanifest">
    <link rel="icon" type="image/svg+xml" href="/icon.svg">
    <meta name="theme-color" content="#101A19">
    <meta name="description" content="UniOCR — moteur OCR universel local : texte, structure, champs, tableaux, codes-barres.">
<title>UniOCR — Poste de contrôle documentaire</title>
<!-- Polices embarquées (SIL Open Font License 1.1) — déploiement 100 % hors ligne -->
<style id="embedded-fonts">
@font-face {
  font-family: 'Instrument Serif';
  font-style: italic;
  font-weight: 400;
  font-display: swap;
  src: url(data:font/woff2;base64,) format('woff2');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}
@font-face {
  font-family: 'Instrument Serif';
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url(data:font/woff2;base64,) format('woff2');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}
@font-face {
  font-family: 'Inter';
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url(data:font/woff2;base64,) format('woff2');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}
@font-face {
  font-family: 'Inter';
  font-style: normal;
  font-weight: 500;
  font-display: swap;
  src: url(data:font/woff2;base64,) format('woff2');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}
@font-face {
  font-family: 'Inter';
  font-style: normal;
  font-weight: 600;
  font-display: swap;
  src: url(data:font/woff2;base64,) format('woff2');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}
@font-face {
  font-family: 'Inter';
  font-style: normal;
  font-weight: 700;
  font-display: swap;
  src: url(data:font/woff2;base64,) format('woff2');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}
@font-face {
  font-family: 'JetBrains Mono';
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url(data:font/woff2;base64,) format('woff2');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}
@font-face {
  font-family: 'JetBrains Mono';
  font-style: normal;
  font-weight: 500;
  font-display: swap;
  src: url(data:font/woff2;base64,) format('woff2');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}
@font-face {
  font-family: 'JetBrains Mono';
  font-style: normal;
  font-weight: 600;
  font-display: swap;
  src: url(data:font/woff2;base64,) format('woff2');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}
    /* ═══ i18n / RTL (C3) ═══ */
    .lang-switch { display: inline-flex; gap: 2px; padding: 3px;
      background: var(--surface-2, rgba(255,255,255,.05)); border-radius: 999px;
      border: 1px solid var(--line, rgba(255,255,255,.09)); }
    .lang-btn { border: 0; background: transparent; color: inherit; opacity: .55;
      font: 600 11px/1 var(--mono, ui-monospace, monospace); letter-spacing: .06em;
      padding: 5px 8px; border-radius: 999px; cursor: pointer; min-width: 30px; }
    .lang-btn:hover { opacity: .85; }
    .lang-btn[aria-pressed="true"] { opacity: 1; background: var(--accent, #8B9DFF);
      color: #0A0C10; }
    /* miroir de la mise en page en RTL : propriétés logiques uniquement,
       pour ne jamais casser la mise en page LTR existante */
    [dir="rtl"] .nav-ic { margin-right: 0; margin-left: 10px; }
    [dir="rtl"] .nav-item { flex-direction: row-reverse; }
    [dir="rtl"] .nav-idx { margin-left: 0; margin-right: auto; }
    [dir="rtl"] .crumb { text-align: right; }
    [dir="rtl"] .lang-switch { flex-direction: row-reverse; }
    /* le texte extrait garde toujours sa propre direction */
    [dir="rtl"] .doc-text, [dir="rtl"] .field-value, [dir="rtl"] pre {
      direction: rtl; text-align: right; unicode-bidi: isolate; }
    /* fin i18n */
/* ═══════════════ CONNECTEUR HUB ═══════════════ */
.cnx { margin-top: 8px; }

.cnx-subnav { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 18px;
  padding-bottom: 14px; border-bottom: 1px solid var(--line-soft); }
.cnx-sub { background: var(--surface-2); border: 1px solid var(--line);
  color: var(--text-2); font: 500 12px/1 var(--font-ui); padding: 8px 11px;
  border-radius: 8px; cursor: pointer; display: flex; align-items: center; gap: 7px;
  transition: border-color .18s, color .18s, background .18s; }
.cnx-sub:hover { color: var(--text); border-color: var(--accent); }
.cnx-sub.on { color: var(--bg-deep); background: var(--accent);
  border-color: var(--accent); font-weight: 600; }
.cnx-sub i { font-style: normal; font: 600 10px/1 var(--font-mono); opacity: .75; }

.cnx-note { color: var(--muted); font: 400 13px/1.6 var(--font-ui);
  max-width: 74ch; margin: 0 0 16px; }
.cnx-note strong { color: var(--text-2); font-weight: 600; }

.cnx-grid { display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(215px, 1fr)); }
.cnx-cards { display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); }

.cnx-card { background: var(--surface); border: 1px solid var(--line);
  border-radius: 12px; padding: 16px; display: flex; flex-direction: column; gap: 10px; }
.cnx-card h4 { margin: 0; font: 500 15px/1.3 var(--font-ui); color: var(--text);
  display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.cnx-card p { margin: 0; color: var(--muted); font: 400 12.5px/1.55 var(--font-ui); }
.cnx-card .mono { font: 500 11.5px/1.5 var(--font-mono); color: var(--text-2); }
.cnx-kv { display: grid; grid-template-columns: auto 1fr; gap: 5px 12px;
  font: 400 12px/1.5 var(--font-ui); }
.cnx-kv dt { color: var(--faint); white-space: nowrap; }
.cnx-kv dd { margin: 0; color: var(--text-2); }
.cnx-acts { display: flex; flex-wrap: wrap; gap: 7px; margin-top: auto; padding-top: 4px; }

.cnx-badge { font: 600 10.5px/1 var(--font-mono); padding: 4px 8px; border-radius: 999px;
  border: 1px solid var(--line); color: var(--muted); white-space: nowrap; }
.cnx-badge.ok { color: var(--ok); border-color: rgba(97,230,224,.45);
  background: rgba(97,230,224,.12); }
.cnx-badge.warn { color: var(--warn); border-color: rgba(230,196,97,.45);
  background: rgba(230,196,97,.12); }
.cnx-badge.err { color: var(--err); border-color: rgba(230,122,122,.45);
  background: rgba(230,122,122,.12); }
.cnx-badge.info { color: var(--accent); border-color: rgba(139,157,255,.45);
  background: rgba(139,157,255,.12); }
.cnx-badge.off { opacity: .55; }

.cnx-steps { list-style: none; counter-reset: cnx; display: flex; flex-wrap: wrap;
  gap: 6px; padding: 0; margin: 0 0 16px; }
.cnx-steps li { counter-increment: cnx; font: 500 11.5px/1 var(--font-ui);
  color: var(--muted); background: var(--surface-2); border: 1px solid var(--line);
  border-radius: 999px; padding: 7px 12px 7px 9px; display: flex; gap: 7px; align-items: center; }
.cnx-steps li::before { content: counter(cnx); font: 600 9.5px/1 var(--font-mono);
  width: 15px; height: 15px; border-radius: 50%; display: grid; place-items: center;
  background: var(--line); color: var(--text-2); }
.cnx-steps li.on { color: var(--text); border-color: var(--accent); }
.cnx-steps li.on::before { background: var(--accent); color: var(--bg-deep); }
.cnx-steps li.done::before { content: "\2713"; background: var(--ok); color: var(--bg-deep); }

.cnx-wizard { background: var(--surface); border: 1px solid var(--line);
  border-radius: 12px; padding: 18px; display: flex; flex-direction: column; gap: 14px; }
.cnx-wizard h4 { margin: 0; font: 500 16px/1.3 var(--font-ui); }
.cnx-wizard p { margin: 0; color: var(--muted); font: 400 13px/1.6 var(--font-ui); max-width: 72ch; }
.cnx-wizacts { display: flex; gap: 8px; flex-wrap: wrap; }

.cnx-form { display: grid; gap: 12px; max-width: 640px; }
.cnx-form label { display: grid; gap: 5px; font: 500 12px/1 var(--font-ui); color: var(--muted); }
.cnx-form input, .cnx-form select, .cnx-form textarea { background: var(--bg-deep);
  border: 1px solid var(--line); color: var(--text); border-radius: 8px;
  padding: 9px 11px; font: 400 13px/1.5 var(--font-ui); }
.cnx-form input:focus, .cnx-form select:focus, .cnx-form textarea:focus {
  outline: none; border-color: var(--accent); }

.cnx-table { width: 100%; border-collapse: collapse; font: 400 12.5px/1.5 var(--font-ui); }
.cnx-table th { text-align: left; color: var(--faint); font-weight: 500; font-size: 11px;
  text-transform: uppercase; letter-spacing: .06em; padding: 8px 10px;
  border-bottom: 1px solid var(--line); }
.cnx-table td { padding: 9px 10px; border-bottom: 1px solid var(--line-soft);
  color: var(--text-2); vertical-align: top; }
.cnx-table tr:hover td { background: var(--surface-2); }
.cnx-table .mono { font: 500 11.5px/1.5 var(--font-mono); }

.cnx-empty { border: 1px dashed var(--line); border-radius: 12px; padding: 26px;
  text-align: center; color: var(--faint); font: 400 13px/1.6 var(--font-ui); }

.cnx-modes { display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
.cnx-mode { background: var(--surface); border: 1px solid var(--line); border-radius: 12px;
  padding: 16px; display: flex; flex-direction: column; gap: 9px; }
.cnx-mode h4 { margin: 0; font: 500 15px/1.3 var(--font-ui); display: flex; gap: 8px; align-items: center; }
.cnx-mode .tag { font: 600 10px/1 var(--font-mono); padding: 3px 7px; border-radius: 5px;
  background: var(--line); color: var(--text-2); }

.cnx-pill { font: 500 11px/1 var(--font-mono); padding: 4px 8px; border-radius: 6px;
  border: 1px solid var(--line); color: var(--muted); background: var(--bg-deep); }

.cnx-check { display: flex; gap: 9px; align-items: flex-start; font: 400 12.5px/1.55 var(--font-ui);
  color: var(--text-2); }
.cnx-check input { margin-top: 2px; accent-color: var(--accent); }

.cnx-warnbox { border: 1px solid rgba(230,196,97,.4);
  background: rgba(230,196,97,.09); border-radius: 10px;
  padding: 12px 14px; color: var(--warn); font: 400 12.5px/1.6 var(--font-ui); }
.cnx-errbox { border: 1px solid rgba(230,122,122,.4);
  background: rgba(230,122,122,.09); border-radius: 10px;
  padding: 12px 14px; color: var(--err); font: 400 12.5px/1.6 var(--font-ui); }
.cnx-okbox { border: 1px solid rgba(97,230,224,.4);
  background: rgba(97,230,224,.09); border-radius: 10px;
  padding: 12px 14px; color: var(--ok); font: 400 12.5px/1.6 var(--font-ui); }

@media (max-width: 860px) {
  .cnx-subnav { gap: 5px; }
  .cnx-sub { font-size: 11.5px; padding: 7px 9px; }
}

  </style>
<style>
/* ═══════════════════════════════════════════════════════════════
   UNICR — FUTURE EDITORIAL INTELLIGENCE
   Design system : obsidienne / ivoire · accents électriques rares
   Typographie : Instrument Serif (éditorial) · Inter (interface)
                 JetBrains Mono (données techniques)
   ═══════════════════════════════════════════════════════════════ */

/* ---------- 01 · JETONS ---------- */
:root {
  --obsidian: #101A19;
  --graphite: #192624;
  --mineral:  #2B3B38;
  --ivory:    #F4F7F5;
  --silver:   #A9B8B2;
  --electric: #83D3C3;
  --cyan:     #E0A17D;

  --bg:        #101A19;
  --bg-deep:   #0B1413;
  --surface:   #192624;
  --surface-2: #202F2C;
  --line:      rgba(190, 207, 199, .17);
  --line-soft: rgba(190, 207, 199, .10);
  --text:      #F4F7F5;
  --text-2:    #D1DDD7;
  --muted:     #B3C1BB;
  --faint:     #9AA9A2;

  --ok:   #7BD1A1;
  --warn: #F0C36A;
  --err:  #F08A7B;

  --accent:   var(--electric);
  --accent-2: var(--cyan);

  --font-display: "Instrument Serif", ui-serif, Georgia, "Times New Roman", serif;
  --font-ui: "Inter", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  --font-mono: "JetBrains Mono", ui-monospace, "SF Mono", "Cascadia Code", Consolas, monospace;

  --xs: 4px; --sm: 8px; --md: 12px; --lg: 16px; --xl: 24px;
  --2xl: 32px; --3xl: 48px; --4xl: 64px;

  --r-xs: 3px; --r-sm: 5px; --r-md: 8px; --r-lg: 8px;
  /* `--r` est utilisé par plusieurs composants (modale, champ de licence) :
     sans cette définition, `border-radius: var(--r)` est invalide et le
     navigateur retombe silencieusement sur 0 — des coins carrés, sans
     aucune erreur console pour le signaler. */
  --r: 8px;
  /* `--fg` est le texte principal ; `--text` en est l'alias historique. */
  --fg: var(--text);
  /* `--dim` est le texte secondaire atténué. */
  --dim: var(--muted);

  --shadow-1: 0 1px 2px rgba(0,0,0,.18);
  --shadow-2: 0 12px 32px rgba(0,0,0,.24);
  --shadow-glow: 0 0 0 1px color-mix(in srgb, var(--accent) 32%, transparent), 0 6px 22px color-mix(in srgb, var(--accent) 10%, transparent);

  --sidebar-w: 248px;
  --topbar-h: 68px;

  --ease: cubic-bezier(.2, .7, .2, 1);
  --dur: .18s;
}

[data-theme="light"] {
  --bg:        #F2F6F4;
  --bg-deep:   #E8EFEB;
  --surface:   #FFFFFF;
  --surface-2: #EAF0ED;
  --line:      rgba(28, 45, 39, .15);
  --line-soft: rgba(28, 45, 39, .09);
  --text:      #1C2B26;
  --text-2:    #33453E;
  --muted:     #52645C;
  --faint:     #5D6E66;
  --electric:  #126B61;
  --cyan:      #B95E3C;
  --accent:    #126B61;
  --accent-2:  #B95E3C;
  --ok:   #23744A;
  --warn: #895A08;
  --err:  #A73C32;
  --shadow-2: 0 12px 32px rgba(28,45,39,.10);
  --shadow-glow: 0 0 0 1px rgba(18,107,97,.22), 0 6px 20px rgba(18,107,97,.08);
}

/* ---------- 02 · BASE ---------- */
*, *::before, *::after { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }
body {
  font-family: var(--font-ui);
  font-size: 14px;
  line-height: 1.55;
  color: var(--text);
  background: var(--bg);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}
h1, h2, h3, h4, p { margin: 0; }
button { font-family: inherit; color: inherit; background: none; border: none; cursor: pointer; }
input, select, textarea { font-family: inherit; color: inherit; }
a { color: var(--accent); text-decoration: none; }
a:hover { text-decoration: underline; }
::selection { background: rgba(139,157,255,.30); }
:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
  border-radius: var(--r-xs);
}
.hidden { display: none !important; }
.mono { font-family: var(--font-mono); font-size: .92em; letter-spacing: -.01em; }
.muted { color: var(--muted); }
.grad-text {
  background: linear-gradient(100deg, var(--accent), var(--accent-2));
  -webkit-background-clip: text; background-clip: text;
  -webkit-text-fill-color: transparent; color: transparent;
}

/* ---------- 03 · ARCHITECTURE ---------- */
.app { display: flex; min-height: 100vh; }

.sidebar {
  width: var(--sidebar-w);
  flex: none;
  display: flex; flex-direction: column;
  background: var(--bg-deep);
  border-right: 1px solid var(--line);
  position: sticky; top: 0; height: 100vh;
  transition: width var(--dur) var(--ease);
  z-index: 40;
}
.app.collapsed .sidebar { width: 72px; }
.app.collapsed .nav-label,
.app.collapsed .brand-txt,
.app.collapsed .nav-item .nav-txt { display: none; }
.app.collapsed .nav-item { justify-content: center; padding: 10px 0; }

.brand {
  display: flex; align-items: center; gap: 11px;
  padding: 20px 18px 18px;
  border-bottom: 1px solid var(--line-soft);
}
.brand-mark {
  width: 34px; height: 34px; flex: none;
  border: 1px solid var(--line);
  border-radius: var(--r-sm);
  display: grid; place-items: center;
  background:
    linear-gradient(135deg, rgba(139,157,255,.18), rgba(97,230,224,.10));
  font-family: var(--font-display);
  font-size: 17px; color: var(--text);
}
.brand-txt .name {
  font-family: var(--font-display);
  font-size: 19px; letter-spacing: .01em; line-height: 1.1;
}
.brand-txt .tag {
  font-family: var(--font-mono);
  font-size: 8.5px; letter-spacing: .18em; text-transform: uppercase;
  color: var(--faint); margin-top: 1px;
}

.nav { flex: 1; overflow-y: auto; padding: 14px 10px; }
.nav-group + .nav-group { margin-top: 22px; }
.nav-label {
  font-family: var(--font-mono);
  font-size: 9px; letter-spacing: .22em; text-transform: uppercase;
  color: var(--faint);
  padding: 0 10px 8px;
}
.nav-item {
  width: 100%;
  display: flex; align-items: center; gap: 11px;
  padding: 9px 10px;
  border-radius: var(--r-sm);
  color: var(--muted);
  font-size: 13px; font-weight: 550;
  position: relative;
  transition: color var(--dur) var(--ease), background var(--dur) var(--ease);
  text-align: left;
}
.nav-item:hover { color: var(--text); background: rgba(139,157,255,.07); }
.nav-item.active {
  color: var(--text);
  background: rgba(139,157,255,.10);
}
.nav-item.active::before {
  content: "";
  position: absolute; left: -10px; top: 7px; bottom: 7px;
  width: 2px; background: var(--accent);
  border-radius: 2px;
}
.nav-item .nav-ic { width: 17px; height: 17px; flex: none; opacity: .85; }
.nav-item .nav-idx {
  margin-left: auto;
  font-family: var(--font-mono);
  font-size: 9px; color: var(--faint); letter-spacing: .08em;
}
.app.collapsed .nav-idx { display: none; }

.sidebar-foot {
  border-top: 1px solid var(--line-soft);
  padding: 12px 10px;
  display: flex; gap: 8px;
}
.foot-btn {
  flex: 1;
  display: flex; align-items: center; justify-content: center; gap: 8px;
  padding: 9px 10px;
  border: 1px solid var(--line);
  border-radius: var(--r-sm);
  color: var(--muted); font-size: 11px; font-weight: 600;
  letter-spacing: .04em;
  transition: color var(--dur), border-color var(--dur);
}
.foot-btn:hover { color: var(--text); border-color: var(--accent); }

/* ---------- 04 · BARRE SUPÉRIEURE ---------- */
.main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.topbar {
  height: var(--topbar-h);
  display: flex; align-items: center; gap: var(--xl);
  padding: 0 var(--2xl);
  border-bottom: 1px solid var(--line);
  background: color-mix(in srgb, var(--bg) 86%, transparent);
  backdrop-filter: blur(14px);
  position: sticky; top: 0; z-index: 30;
}
.crumb { min-width: 0; }
.crumb h2 {
  font-family: var(--font-display);
  font-size: 21px; font-weight: 400; line-height: 1.15;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.crumb .sub {
  font-size: 11px; color: var(--faint);
  letter-spacing: .02em;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.top-search { flex: 1; max-width: 420px; margin-left: auto; position: relative; }
.top-search input {
  width: 100%;
  padding: 9px 14px 9px 36px;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--r-md);
  font-size: 12.5px;
  transition: border-color var(--dur), box-shadow var(--dur);
}
.top-search input:focus {
  outline: none; border-color: var(--accent);
  box-shadow: var(--shadow-glow);
}
.top-search .s-ic {
  position: absolute; left: 12px; top: 50%; transform: translateY(-50%);
  width: 14px; height: 14px; color: var(--faint); pointer-events: none;
}
.top-chips { display: flex; gap: 10px; align-items: center; flex: none; }
.chip {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 7px 13px;
  border: 1px solid var(--line);
  border-radius: 99px;
  font-family: var(--font-mono);
  font-size: 10.5px; letter-spacing: .05em;
  color: var(--muted);
  white-space: nowrap;
}
.chip .dot {
  width: 7px; height: 7px; border-radius: 50%;
  background: var(--faint);
  transition: background var(--dur);
}
.chip.glow { border-color: rgba(97,230,224,.35); }
.chip.glow .dot { background: var(--ok); box-shadow: 0 0 10px var(--ok); }

/* ---------- résultats de recherche globale ---------- */
.search-results {
  position: absolute; top: calc(100% + 8px); left: 0; right: 0;
  max-height: min(62vh, 460px); overflow-y: auto;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--r-md);
  box-shadow: var(--shadow-2);
  z-index: 120;
}
.search-results .sr-head {
  padding: 9px 14px;
  border-bottom: 1px solid var(--line);
  font-family: var(--font-mono); font-size: 9.5px;
  letter-spacing: .16em; text-transform: uppercase; color: var(--faint);
}
.search-results .sr-item {
  display: block; width: 100%; text-align: left;
  padding: 10px 14px; border: none; border-bottom: 1px solid var(--line);
  background: none; color: inherit; cursor: pointer;
  font: inherit; font-size: 12px;
}
.search-results .sr-item:last-child { border-bottom: none; }
.search-results .sr-item:hover,
.search-results .sr-item:focus-visible {
  background: color-mix(in srgb, var(--accent) 10%, transparent);
  outline: none;
}
.search-results .sr-item .sr-file { font-weight: 600; }
.search-results .sr-item .sr-meta {
  display: flex; gap: 8px; align-items: center; margin-top: 3px;
  font-family: var(--font-mono); font-size: 10px; color: var(--muted);
}
.search-results .sr-snip {
  margin-top: 4px; color: var(--muted); font-size: 11.5px;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
  overflow: hidden;
}
.search-results .sr-snip mark {
  background: color-mix(in srgb, var(--cyan) 30%, transparent);
  color: inherit; padding: 0 2px; border-radius: 2px;
}

/* ---------- panneau « carte » : halo qui suit le curseur ----------
   Le JS métier positionne --mx/--my sur .card et .drop au survol. */
.card {
  position: relative;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--r-lg);
  padding: 22px 24px;
  overflow: hidden;
}
.card::before {
  content: ""; position: absolute; inset: 0; pointer-events: none;
  background: radial-gradient(360px circle at var(--mx, 50%) var(--my, 0%),
              rgba(139,157,255,.10), transparent 68%);
  opacity: 0; transition: opacity var(--dur);
}
.card:hover::before { opacity: 1; }
.card-head {
  display: flex; justify-content: space-between; align-items: baseline;
  gap: 12px; flex-wrap: wrap; margin-bottom: 16px;
}
.card-title { font-family: var(--font-display); font-size: 19px; font-weight: 400; }
.card-sub {
  font-family: var(--font-mono); font-size: 10px; color: var(--faint);
  letter-spacing: .08em;
}

/* ---------- en-tête de page ---------- */
.page-head {
  display: flex; justify-content: space-between; align-items: flex-end;
  gap: 24px; flex-wrap: wrap; margin-bottom: 26px;
}
.ph-kicker {
  font-family: var(--font-mono); font-size: 9.5px;
  letter-spacing: .2em; text-transform: uppercase; color: var(--faint);
}
.ph-title {
  font-family: var(--font-display); font-weight: 400;
  font-size: clamp(26px, 3vw, 36px); line-height: 1.05; margin: 6px 0 8px;
}
.ph-sub {
  margin: 0; max-width: 62ch; font-size: 13px; color: var(--muted); line-height: 1.6;
}
.ph-actions { display: flex; align-items: flex-end; gap: 10px; flex-wrap: wrap; }
.ph-field {
  font-family: var(--font-mono); font-size: 9.5px; letter-spacing: .14em;
  text-transform: uppercase; color: var(--faint); margin-bottom: 6px;
}
.ph-check {
  display: inline-flex; align-items: center; gap: 8px;
  font-size: 11.5px; color: var(--muted); cursor: pointer;
  padding-bottom: 7px; user-select: none;
}
.ph-check input { accent-color: var(--accent); width: 14px; height: 14px; cursor: pointer; }

/* ---------- file de révision ---------- */
.stat-row {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: 1px; background: var(--line);
  border: 1px solid var(--line); border-radius: var(--r-md);
  margin-bottom: 22px; overflow: hidden;
}
.stat-row .stat { background: var(--surface); padding: 16px 18px; }
.stat-row .stat .big { font-size: 30px; }
.review-doc { border-bottom: 1px solid var(--line); padding: 18px 0; }
.review-doc:last-child { border-bottom: none; }
.review-doc-head {
  display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; margin-bottom: 12px;
}
.review-doc-head .fn {
  font-family: var(--font-display); font-size: 19px; font-weight: 400;
}
.review-doc-head .meta {
  font-family: var(--font-mono); font-size: 10px; color: var(--faint);
  letter-spacing: .06em;
}
.review-row {
  display: grid; grid-template-columns: minmax(180px, 1.1fr) minmax(150px, 1fr) auto;
  gap: 16px; align-items: center;
  padding: 11px 12px; border-radius: var(--r-sm);
  border: 1px solid transparent;
  transition: background var(--dur), border-color var(--dur);
}
.review-row:hover { background: color-mix(in srgb, var(--accent) 6%, transparent); }
.review-row.focused {
  background: color-mix(in srgb, var(--accent) 9%, transparent);
  border-color: color-mix(in srgb, var(--accent) 45%, transparent);
}
/* une ligne focalisée au clavier est marquée, pas seulement survolée : sans
   distinction visible, l'opérateur ne sait pas quelle ligne Entrée valide */
.review-row.focused .rr-label::after {
  content: "⏎"; margin-left: 6px; font-size: 11px; color: var(--accent);
}
.rr-btn-row { display: flex; gap: 6px; align-items: center; }
.kbd-hint { display: flex; flex-wrap: wrap; gap: 12px; align-items: center;
  padding: 8px 12px; margin-bottom: 10px; border-radius: var(--r-sm);
  background: color-mix(in srgb, var(--accent) 4%, transparent);
  border: 1px solid var(--line); font-size: 11.5px; color: var(--muted); }
.kbd-hint kbd {
  font-family: var(--font-mono); font-size: 10.5px; padding: 2px 6px;
  border-radius: 4px; border: 1px solid var(--line);
  background: var(--surface); color: var(--text);
}
.kbd-hint .sep { color: var(--faint); }
.review-row .rr-label { font-size: 12.5px; font-weight: 600; }
.review-row .rr-name {
  display: block; font-family: var(--font-mono); font-size: 9.5px;
  color: var(--faint); margin-top: 2px;
}
.review-row .rr-value { font-family: var(--font-mono); font-size: 12px; }
.review-row .rr-reasons {
  font-family: var(--font-mono); font-size: 9.5px; color: var(--warn);
  letter-spacing: .04em; margin-top: 4px;
}
.review-row .rr-actions { display: flex; gap: 8px; align-items: center; }
.review-row .rr-conf {
  display: flex; align-items: center; gap: 8px;
  font-family: var(--font-mono); font-size: 11px; color: var(--muted);
}
.review-row.done { opacity: .5; }
.review-row.done .rr-actions { pointer-events: none; }

/* ---------- aide raccourcis ---------- */
/* Modale de saisie du jeton : n'apparaît que si l'API en exige un. */
.modal-voile { position: fixed; inset: 0; background: rgba(0,0,0,.55);
  display: flex; align-items: center; justify-content: center; z-index: 90; }
.modal-voile.hidden { display: none; }
.modal { background: var(--surface); border: 1px solid var(--line);
  border-radius: var(--r); padding: 22px; width: min(420px, 92vw);
  box-shadow: 0 18px 50px rgba(0,0,0,.35); }
.modal h3 { margin: 0 0 6px; font-size: 16px; }
.modal p { margin: 0 0 14px; font-size: 12.5px; color: var(--muted); line-height: 1.5; }
.modal .row { display: flex; gap: 8px; }
.modal input { flex: 1; }
.rbac-ligne { display: flex; align-items: center; gap: 8px; padding: 7px 0;
  border-bottom: 1px solid var(--line); font-size: 12.5px; }
.rbac-ligne:last-child { border-bottom: 0; }
.rbac-ligne .nom { font-weight: 600; min-width: 90px; }
.rbac-ligne .roles { display: flex; gap: 4px; flex-wrap: wrap; }
.rbac-ligne .scope { color: var(--faint); font-family: var(--font-mono);
  font-size: 10.5px; margin-left: auto; }
.kbd-help {
  margin-top: 18px; padding: 12px 16px;
  border: 1px dashed var(--line); border-radius: var(--r-md);
  font-size: 11.5px; color: var(--muted);
}
.kbd-help b { color: var(--fg); font-family: var(--font-mono); font-weight: 600; }
.kbd {
  display: inline-block; min-width: 22px; padding: 2px 7px;
  border: 1px solid var(--line); border-bottom-width: 2px;
  border-radius: 5px; background: var(--surface-2);
  font-family: var(--font-mono); font-size: 10.5px; color: var(--fg);
  text-align: center;
}
.kbd-grid {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 10px 24px; margin-top: 6px; font-size: 12.5px; color: var(--muted);
}
.kbd-note {
  margin-top: 18px; font-size: 11px; color: var(--faint);
  border-top: 1px solid var(--line); padding-top: 12px;
}
.modal-head {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 16px;
}

/* ---------- traitement par lots ---------- */
.batch-bar { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
.batch-files { margin-top: 14px; display: grid; gap: 6px; }
.batch-file {
  display: flex; align-items: center; gap: 10px;
  padding: 8px 12px; border: 1px solid var(--line); border-radius: var(--r-sm);
  font-size: 12px; background: var(--surface-2);
}
.batch-file .bf-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
.batch-file .bf-size {
  font-family: var(--font-mono); font-size: 10px; color: var(--faint); flex: none;
}
.batch-file .bf-rm {
  border: none; background: none; color: var(--faint); cursor: pointer;
  font-size: 13px; padding: 0 4px; flex: none;
}
.batch-file .bf-rm:hover { color: var(--err, #ff8b8b); }
.batch-result { margin-top: 18px; display: grid; gap: 12px; }
.batch-summary {
  display: flex; gap: 18px; flex-wrap: wrap; align-items: baseline;
  padding: 12px 14px; border: 1px solid var(--line); border-radius: var(--r-md);
  background: var(--surface-2); font-size: 12px;
}
.batch-summary .bs-n {
  font-family: var(--font-display); font-size: 22px; margin-right: 6px;
}
.batch-row {
  display: flex; align-items: center; gap: 10px; font-size: 12px;
  padding: 7px 10px; border-bottom: 1px solid var(--line);
}
.batch-row:last-child { border-bottom: none; }
.batch-row .br-file { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
.batch-export { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 4px; }

/* ---------- journal d'audit ---------- */
.audit-bar { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 12px; }
.audit-bar .inp { flex: 1; min-width: 180px; }
.audit-bar select.inp { flex: 0 0 220px; }
.audit-entry {
  display: flex; gap: 10px; align-items: baseline;
  padding: 5px 0; border-bottom: 1px solid var(--line);
  font-family: var(--font-mono); font-size: 10.5px; line-height: 1.6;
}
.audit-entry:last-child { border-bottom: none; }
.audit-entry .ae-ts { color: var(--faint); flex: none; }
.audit-entry .ae-ev {
  flex: none; min-width: 130px; color: var(--accent);
  text-transform: uppercase; letter-spacing: .06em;
}
.audit-entry .ae-det { color: var(--muted); word-break: break-word; }

/* ---------- sélection de champs ---------- */
.sel-bar {
  display: flex; gap: 12px; align-items: center; flex-wrap: wrap;
  margin: 0 0 12px; padding-bottom: 12px; border-bottom: 1px solid var(--line);
}
/* ---------- éditeur de profils ---------- */
.prof-layout {
  display: grid; grid-template-columns: 250px 1fr; gap: 22px; align-items: start;
}
.prof-col { min-width: 0; }
.prof-list { display: grid; gap: 5px; }
.prof-item {
  display: flex; align-items: baseline; gap: 8px; width: 100%; text-align: left;
  padding: 9px 11px; border: 1px solid var(--line); border-radius: var(--r-sm);
  background: none; color: inherit; cursor: pointer; font: inherit; font-size: 12px;
}
.prof-item:hover { background: var(--surface-2); }
.prof-item.on {
  border-color: color-mix(in srgb, var(--accent) 50%, transparent);
  background: color-mix(in srgb, var(--accent) 10%, transparent);
}
.prof-item .pi-name { flex: 1; min-width: 0; font-weight: 600; }
.prof-item .pi-src {
  font-family: var(--font-mono); font-size: 8.5px; letter-spacing: .08em;
  text-transform: uppercase; color: var(--faint); flex: none;
}
.prof-item .pi-src.user { color: var(--cyan); }
.prof-form .lb { display: block; margin: 14px 0 5px; }
.prof-meta { max-width: 520px; }
.prof-actions {
  display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin-top: 16px;
}
.prof-fields { display: grid; gap: 10px; }
.prof-field {
  border: 1px solid var(--line); border-radius: var(--r-md);
  background: var(--surface-2); padding: 13px 15px;
}
.prof-field-head {
  display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin-bottom: 8px;
}
.prof-field-head .pf-key { font-weight: 600; font-size: 12.5px; }
.prof-field-head .pf-rm {
  margin-left: auto; border: none; background: none; color: var(--faint);
  cursor: pointer; font-size: 12px;
}
.prof-field-head .pf-rm:hover { color: var(--err, #ff8b8b); }
.prof-field-grid {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
  gap: 10px;
}
.prof-field .lb { margin: 0 0 4px; font-size: 9.5px; }
.prof-test { display: grid; gap: 10px; max-width: 640px; }
.prof-test-out { margin-top: 16px; display: grid; gap: 8px; }
.prof-test-row {
  display: flex; gap: 12px; align-items: baseline; flex-wrap: wrap;
  padding: 8px 11px; border: 1px solid var(--line); border-radius: var(--r-sm);
  font-size: 12px;
}
.prof-test-row .ptr-key {
  font-family: var(--font-mono); font-size: 10px; color: var(--faint);
  min-width: 120px;
}
.prof-test-row .ptr-val { font-family: var(--font-mono); flex: 1; min-width: 0; }
.prof-test-summary {
  font-family: var(--font-mono); font-size: 10.5px; color: var(--muted);
  letter-spacing: .04em;
}
.offline-banner {
  display: none;
  align-items: center; gap: 12px; flex-wrap: wrap;
  padding: 11px var(--2xl);
  background: color-mix(in srgb, var(--warn) 12%, var(--bg));
  border-bottom: 1px solid color-mix(in srgb, var(--warn) 35%, transparent);
  font-size: 12.5px;
}
.offline-banner .anom-ic { color: var(--warn); font-weight: 800; }
.offline-banner input {
  flex: 1; min-width: 220px; max-width: 460px;
  padding: 8px 12px;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--r-sm);
  font-family: var(--font-mono); font-size: 11.5px;
}

/* ---------- 05 · ESPACE ÉDITORIAL ---------- */
.workspace {
  flex: 1;
  padding: var(--3xl) var(--2xl) var(--4xl);
  max-width: 1560px;
  width: 100%; margin: 0 auto;
}
.page-enter { animation: pageIn .32s var(--ease) both; }
@keyframes pageIn {
  from { opacity: 0; transform: translateY(10px); }
  to   { opacity: 1; transform: none; }
}
@keyframes riseIn {
  from { opacity: 0; transform: translateY(8px); }
  to   { opacity: 1; transform: none; }
}

.page-head { margin-bottom: var(--2xl); max-width: 880px; }
.page-index {
  font-family: var(--font-mono);
  font-size: 10px; letter-spacing: .26em; text-transform: uppercase;
  color: var(--faint);
  display: flex; align-items: center; gap: 12px;
  margin-bottom: var(--lg);
}
.page-index::after {
  content: ""; height: 1px; flex: 1; max-width: 120px;
  background: var(--line);
}
.display {
  font-family: var(--font-display);
  font-weight: 400;
  font-size: clamp(34px, 4.6vw, 56px);
  line-height: 1.04;
  letter-spacing: -.01em;
}
.display em {
  font-style: italic;
  color: var(--accent);
}
.lede {
  margin-top: var(--lg);
  font-size: 15.5px;
  color: var(--muted);
  max-width: 620px;
  line-height: 1.65;
}
.sec-title {
  font-family: var(--font-display);
  font-size: 23px; font-weight: 400;
  margin-bottom: 6px;
}
.sec-sub { font-size: 12px; color: var(--faint); margin-bottom: var(--lg); }

.rule {
  height: 1px; background: var(--line);
  margin: var(--2xl) 0;
  position: relative;
}
.rule::before {
  content: ""; position: absolute; left: 0; top: -1px;
  width: 42px; height: 3px; background: var(--accent);
  border-radius: 2px;
}

/* ---------- 06 · COMPOSITIONS ---------- */
.hero-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.65fr) minmax(320px, 1fr);
  gap: var(--2xl);
  align-items: start;
}
.hero-grid.cols-source { grid-template-columns: minmax(0, 1.3fr) minmax(260px, .8fr); }
.hero-grid.cols-half { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.hero-grid.cols-third { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.hero-grid.cols-dashboard { grid-template-columns: repeat(4, minmax(0, 1fr)); }
@media (max-width: 1120px) { .hero-grid { grid-template-columns: 1fr; } }
.col-side { display: flex; flex-direction: column; gap: var(--lg); position: sticky; top: calc(var(--topbar-h) + 18px); }
@media (max-width: 1120px) { .col-side { position: static; } }

.panel {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--r-md);
  padding: var(--xl);
}
.panel-flush { background: transparent; border: none; padding: 0; }
.panel-head {
  display: flex; align-items: baseline; gap: 12px;
  margin-bottom: var(--lg);
}
.panel-head .sec-title { margin: 0; }
.panel-head .idx {
  font-family: var(--font-mono); font-size: 9.5px;
  letter-spacing: .2em; color: var(--faint); text-transform: uppercase;
}

/* Instrument d'importation */
.instrument {
  position: relative;
  border: 1px solid var(--line);
  border-radius: var(--r-lg);
  background:
    radial-gradient(120% 120% at 20% 0%, rgba(139,157,255,.07), transparent 55%),
    var(--surface);
  overflow: hidden;
  transition: border-color var(--dur) var(--ease), box-shadow .28s var(--ease),
              transform .28s var(--ease);
}
.instrument:hover {
  border-color: rgba(139,157,255,.42);
  box-shadow: var(--shadow-glow);
  transform: translateY(-2px);
}
.instrument.drag {
  border-color: var(--accent-2);
  box-shadow: 0 0 0 1px var(--accent-2), 0 16px 48px rgba(97,230,224,.16);
}
.drop {
  padding: var(--3xl) var(--2xl);
  text-align: center;
  cursor: pointer;
  position: relative;
}
/* repères de grille technique */
.drop::before {
  content: "";
  position: absolute; inset: 14px;
  border: 1px solid var(--line-soft);
  border-radius: var(--r-md);
  pointer-events: none;
  background-image:
    linear-gradient(var(--line-soft) 1px, transparent 1px),
    linear-gradient(90deg, var(--line-soft) 1px, transparent 1px);
  background-size: 28px 28px;
  opacity: .5;
}
/* coins instrument */
.instrument .corner {
  position: absolute; width: 16px; height: 16px;
  border: 1px solid var(--accent);
  opacity: .55; pointer-events: none;
}
.instrument .corner.tl { top: 10px; left: 10px; border-right: 0; border-bottom: 0; }
.instrument .corner.tr { top: 10px; right: 10px; border-left: 0; border-bottom: 0; }
.instrument .corner.bl { bottom: 10px; left: 10px; border-right: 0; border-top: 0; }
.instrument .corner.br { bottom: 10px; right: 10px; border-left: 0; border-top: 0; }
.instrument .scanline {
  position: absolute; left: 14px; right: 14px; top: 14px;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--accent-2), transparent);
  opacity: 0; pointer-events: none;
}
.instrument:hover .scanline { animation: scan 1.6s var(--ease) infinite; }
@keyframes scan {
  0% { opacity: 0; transform: translateY(0); }
  12% { opacity: .8; }
  88% { opacity: .8; }
  100% { opacity: 0; transform: translateY(290px); }
}
.drop .ring {
  width: 66px; height: 66px; margin: 0 auto var(--lg);
  border: 1px solid var(--line);
  border-radius: 18px;
  display: grid; place-items: center;
  background: rgba(139,157,255,.08);
  color: var(--accent);
  position: relative;
}
.drop h4 {
  font-family: var(--font-display);
  font-size: 23px; font-weight: 400;
  position: relative;
}
.drop p {
  margin-top: 6px;
  color: var(--faint); font-size: 12.5px;
  letter-spacing: .02em;
  position: relative;
}
.file-name {
  margin-top: 14px; font-family: var(--font-mono);
  font-size: 11.5px; color: var(--accent-2);
  position: relative;
}

.cam-row {
  display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
  padding: 14px var(--xl) 18px;
  border-top: 1px solid var(--line-soft);
}

/* boutons */
.btn {
  display: inline-flex; align-items: center; gap: 9px;
  padding: 12px 22px;
  border-radius: var(--r-md);
  background: linear-gradient(135deg, var(--electric), #5F78FF);
  color: #0B0E14;
  font-weight: 750; font-size: 13px;
  letter-spacing: .015em;
  transition: transform var(--dur) var(--ease), box-shadow .25s var(--ease),
              opacity var(--dur);
}
[data-theme="light"] .btn { color: #FBFAF7; }
.btn:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 14px 34px rgba(139,157,255,.35); }
.btn:active:not(:disabled) { transform: translateY(0); }
.btn:disabled { opacity: .38; cursor: not-allowed; }
.btn.ghost {
  background: transparent;
  color: var(--muted);
  border: 1px solid var(--line);
}
.btn.ghost:hover:not(:disabled) {
  color: var(--text); border-color: var(--accent);
  box-shadow: none; transform: none;
}
.btn.sm { padding: 8px 14px; font-size: 11.5px; border-radius: var(--r-sm); }

/* champs de formulaire */
.lb {
  display: block;
  font-family: var(--font-mono);
  font-size: 9.5px; font-weight: 600;
  letter-spacing: .18em; text-transform: uppercase;
  color: var(--faint);
  margin: var(--lg) 0 7px;
}
.inp, select.inp, textarea.inp {
  width: 100%;
  padding: 11px 13px;
  background: var(--surface-2);
  border: 1px solid var(--line);
  border-radius: var(--r-sm);
  font-size: 13px;
  transition: border-color var(--dur), box-shadow var(--dur);
  appearance: none;
}
select.inp {
  background-image: linear-gradient(45deg, transparent 50%, var(--faint) 50%),
                    linear-gradient(135deg, var(--faint) 50%, transparent 50%);
  background-position: calc(100% - 18px) 55%, calc(100% - 13px) 55%;
  background-size: 5px 5px;
  background-repeat: no-repeat;
  padding-right: 32px;
}
.inp:focus {
  outline: none; border-color: var(--accent);
  box-shadow: var(--shadow-glow);
}
.field-row {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: var(--lg);
}
@media (max-width: 720px) { .field-row { grid-template-columns: 1fr; } }

.seg {
  display: flex; gap: 5px;
  background: var(--surface-2);
  padding: 5px;
  border: 1px solid var(--line);
  border-radius: var(--r-md);
}
.seg button {
  flex: 1; padding: 9px 10px;
  border-radius: var(--r-sm);
  font-size: 12px; font-weight: 700;
  color: var(--muted);
  transition: background var(--dur), color var(--dur);
}
.seg button:hover { color: var(--text); }
.seg button.on {
  background: linear-gradient(135deg, var(--electric), #5F78FF);
  color: #0B0E14;
}
[data-theme="light"] .seg button.on { color: #FBFAF7; }

.langchip {
  display: inline-flex; align-items: center; gap: 7px;
  padding: 6px 12px;
  margin: 3px;
  border-radius: 99px;
  border: 1px solid var(--line);
  background: transparent;
  font-size: 11.5px; font-weight: 600;
  color: var(--muted);
  cursor: pointer; user-select: none;
  transition: all var(--dur) var(--ease);
}
.langchip:hover { color: var(--text); border-color: var(--accent); transform: translateY(-1px); }
.langchip.on {
  background: color-mix(in srgb, var(--electric) 18%, transparent);
  border-color: color-mix(in srgb, var(--electric) 55%, transparent);
  color: var(--text);
}
.langchip .ok { font-size: 9px; opacity: .85; }
.fmt-chips { display: flex; flex-wrap: wrap; gap: 4px; }

.mini-switch {
  display: flex; align-items: center; gap: 10px;
  padding: 11px 13px;
  border: 1px solid var(--line);
  border-radius: var(--r-sm);
  cursor: pointer; user-select: none;
  transition: border-color var(--dur), transform var(--dur);
}
.mini-switch:hover { border-color: var(--accent); transform: translateY(-1px); }
.mini-switch input { display: none; }
.mini-switch .track {
  width: 34px; height: 19px; flex: none;
  border-radius: 99px;
  background: var(--surface-2);
  border: 1px solid var(--line);
  position: relative;
  transition: background .22s var(--ease);
}
.mini-switch .track::after {
  content: ""; position: absolute; top: 2px; left: 2.5px;
  width: 13px; height: 13px; border-radius: 50%;
  background: var(--faint);
  transition: left .22s var(--ease), background .22s;
}
.mini-switch input:checked + .track {
  background: color-mix(in srgb, var(--electric) 40%, transparent);
  border-color: var(--electric);
}
.mini-switch input:checked + .track::after { left: 17px; background: var(--ivory); }
.mini-switch .lbl { font-size: 11.5px; font-weight: 650; color: var(--text-2); }
.toggles { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
@media (max-width: 720px) { .toggles { grid-template-columns: 1fr; } }

input[type=range] {
  width: 100%; height: 4px;
  appearance: none;
  background: var(--surface-2);
  border: 1px solid var(--line);
  border-radius: 99px;
  outline: none;
}
input[type=range]::-webkit-slider-thumb {
  appearance: none;
  width: 17px; height: 17px; border-radius: 50%;
  background: var(--accent);
  border: 2px solid var(--bg);
  cursor: pointer;
  box-shadow: 0 4px 14px rgba(139,157,255,.4);
}
.range-row { display: flex; align-items: center; gap: 13px; }
.range-row input[type=range] { flex: 1; }
.range-val {
  min-width: 56px; text-align: center;
  padding: 6px 9px;
  border: 1px solid var(--line);
  border-radius: var(--r-sm);
  font-family: var(--font-mono); font-size: 11.5px; font-weight: 700;
  color: var(--accent);
}

/* panneau avancé */
.adv-head {
  display: flex; align-items: center; gap: 10px;
  padding: 13px 15px;
  border: 1px solid var(--line);
  border-radius: var(--r-sm);
  cursor: pointer; user-select: none;
  font-family: var(--font-mono);
  font-size: 10px; font-weight: 700;
  letter-spacing: .16em; text-transform: uppercase;
  color: var(--muted);
  transition: color var(--dur), border-color var(--dur);
}
.adv-head:hover { color: var(--text); border-color: var(--accent); }
.adv-head .chev { margin-left: auto; transition: transform .3s var(--ease); font-size: 12px; }
.adv.open .adv-head .chev { transform: rotate(180deg); }
.adv-body { display: none; padding-top: 14px; animation: pageIn .3s var(--ease); }
.adv.open .adv-body { display: block; }

/* ---------- 07 · PIPELINE & JOURNAUX ---------- */
.progress {
  height: 3px;
  background: var(--surface-2);
  border-radius: 99px;
  overflow: hidden;
  margin: var(--lg) 0 var(--xl);
}
.progress i {
  display: block; height: 100%; width: 0;
  background: linear-gradient(90deg, var(--electric), var(--cyan));
  border-radius: 99px;
  transition: width .5s var(--ease);
}
.steps { display: flex; flex-direction: column; gap: 2px; }
.step {
  display: flex; align-items: center; gap: 13px;
  padding: 11px 12px;
  border-radius: var(--r-sm);
  color: var(--faint);
  font-size: 12.5px;
  transition: all var(--dur) var(--ease);
}
.step .st-idx {
  font-family: var(--font-mono); font-size: 9px;
  width: 22px; flex: none; letter-spacing: .1em;
}
.step .st-dot {
  width: 6px; height: 6px; border-radius: 50%;
  background: var(--line); flex: none;
  transition: all var(--dur);
}
.step.on { color: var(--text); background: rgba(139,157,255,.08); }
.step.on .st-dot { background: var(--accent); box-shadow: 0 0 10px var(--accent); }
.step.done { color: var(--muted); }
.step.done .st-dot { background: var(--ok); }
.step.err { color: var(--err); }
.step.err .st-dot { background: var(--err); box-shadow: 0 0 10px var(--err); }

.logbox {
  margin-top: var(--lg);
  max-height: 190px; overflow-y: auto;
  border: 1px solid var(--line-soft);
  border-radius: var(--r-sm);
  background: var(--bg-deep);
  padding: 12px 14px;
  font-family: var(--font-mono); font-size: 10.5px;
  color: var(--faint); line-height: 1.8;
}
.logbox .ok { color: var(--ok); }
.logbox .err { color: var(--err); }
.logbox .lt { color: var(--faint); opacity: .7; margin-right: 8px; }

/* ---------- 08 · TABLEAUX ÉDITORIAUX ---------- */
.tbl { width: 100%; border-collapse: collapse; font-size: 12.5px; }
.table-scroll { width: 100%; max-width: 100%; overflow-x: auto; overscroll-behavior-inline: contain; }
#jobsTable { min-width: 720px; }
.tbl th {
  text-align: left;
  font-family: var(--font-mono);
  font-size: 9.5px; font-weight: 650;
  letter-spacing: .16em; text-transform: uppercase;
  color: var(--faint);
  padding: 10px 12px;
  border-bottom: 1px solid var(--line);
  white-space: nowrap;
}
.tbl td {
  padding: 13px 12px;
  border-bottom: 1px solid var(--line-soft);
  vertical-align: middle;
}
.tbl tbody tr {
  transition: background var(--dur) var(--ease), transform var(--dur) var(--ease);
}
.tbl tbody tr:hover { background: rgba(139,157,255,.05); }
.tbl tbody tr.sel {
  background: rgba(139,157,255,.10);
  box-shadow: inset 2px 0 0 var(--accent);
}
.tbl .num, .tbl .mono { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
.tbl .edit {
  width: 100%;
  background: transparent;
  border: 1px dashed transparent;
  border-radius: var(--r-xs);
  padding: 4px 7px;
  font-family: var(--font-mono); font-size: 11.5px;
}
.tbl .edit:hover { border-color: var(--line); }
.tbl .edit:focus {
  outline: none; border-color: var(--accent);
  background: var(--surface-2);
}

.meter {
  width: 72px; height: 3px;
  background: var(--surface-2);
  border-radius: 99px; overflow: hidden;
}
.meter i {
  display: block; height: 100%;
  background: var(--accent);
  border-radius: 99px;
  transition: width .4s var(--ease);
}
.meter.hi i { background: var(--ok); }
.meter.lo i { background: var(--warn); }
.rowflex { display: flex; gap: 8px; align-items: center; min-width: 170px; }
.rowflex .edit { flex: 1; min-width: 0; }
.scroll { overflow-x: auto; }
.pg { flex: none; }
.big { font-family: var(--font-display); font-size: 26px; line-height: 1.1; }

.badge {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 3.5px 10px;
  border-radius: 99px;
  font-family: var(--font-mono);
  font-size: 9.5px; font-weight: 700;
  letter-spacing: .08em; text-transform: uppercase;
  border: 1px solid transparent;
  white-space: nowrap;
}
.badge::before {
  content: ""; width: 5px; height: 5px; border-radius: 50%;
  background: currentColor;
}
.badge.detected, .badge.validated, .badge.done, .badge.ok {
  color: var(--ok);
  background: color-mix(in srgb, var(--ok) 10%, transparent);
  border-color: color-mix(in srgb, var(--ok) 30%, transparent);
}
.badge.invalid, .badge.error, .badge.err {
  color: var(--err);
  background: color-mix(in srgb, var(--err) 10%, transparent);
  border-color: color-mix(in srgb, var(--err) 30%, transparent);
}
.badge.ambiguous, .badge.warning, .badge.processing, .badge.done_with_warnings {
  color: var(--warn);
  background: color-mix(in srgb, var(--warn) 10%, transparent);
  border-color: color-mix(in srgb, var(--warn) 30%, transparent);
}
.badge.not_detected, .badge.queued, .badge.info {
  color: var(--muted);
  background: color-mix(in srgb, var(--muted) 8%, transparent);
  border-color: var(--line);
}

.pill {
  display: inline-flex; align-items: center; gap: 5px;
  padding: 3px 9px;
  border: 1px solid var(--line);
  border-radius: 99px;
  font-family: var(--font-mono); font-size: 9.5px;
  color: var(--muted);
  letter-spacing: .05em;
}
.pill.lang { color: var(--accent-2); border-color: color-mix(in srgb, var(--accent-2) 35%, transparent); }

.anom {
  display: flex; gap: 11px; align-items: flex-start;
  padding: 13px 15px;
  border: 1px solid color-mix(in srgb, var(--warn) 28%, transparent);
  border-left: 2px solid var(--warn);
  border-radius: var(--r-sm);
  background: color-mix(in srgb, var(--warn) 6%, transparent);
  font-size: 12.5px; color: var(--text-2);
  margin: 8px 0;
}
.anom .msg { flex: 1; line-height: 1.55; }

.empty {
  padding: var(--2xl);
  text-align: center;
  color: var(--faint);
  font-size: 12.5px;
  border: 1px dashed var(--line);
  border-radius: var(--r-md);
  margin: var(--lg) 0;
}
.empty b { color: var(--muted); font-weight: 650; }

.engine-row {
  display: flex; align-items: center; gap: 13px;
  padding: 12px 0;
  border-bottom: 1px solid var(--line-soft);
  font-size: 12.5px;
}
.engine-row .meta {
  margin-left: auto; text-align: right;
  font-family: var(--font-mono); font-size: 10px; color: var(--faint);
}
.stat {
  display: flex; flex-direction: column; gap: 4px;
}
.stat .big {
  font-family: var(--font-display);
  font-size: 42px; line-height: 1;
  font-variant-numeric: tabular-nums;
}
.stat .lbl {
  font-family: var(--font-mono); font-size: 9.5px;
  letter-spacing: .18em; text-transform: uppercase;
  color: var(--faint);
}

.gv .v {
  font-family: var(--font-display);
  font-size: 38px; line-height: 1.05;
  font-variant-numeric: tabular-nums;
}
.gv .sub { font-size: 11px; color: var(--faint); margin-top: 4px; }

.bar-chart {
  display: flex; align-items: flex-end; gap: 10px;
  height: 120px; margin: var(--lg) 0;
}
.bar-chart .b {
  flex: 1; display: flex; flex-direction: column; justify-content: flex-end;
  gap: 6px; text-align: center;
}
.bar-chart .b em {
  display: block; width: 100%;
  background: linear-gradient(180deg, var(--electric), rgba(139,157,255,.18));
  border-radius: 3px 3px 0 0;
  min-height: 2px;
  transition: height .5s var(--ease);
  font-style: normal;
}

/* exports */
.export-grid { display: flex; flex-wrap: wrap; gap: 9px; }
.fmt {
  display: inline-flex; align-items: center; gap: 9px;
  padding: 9px 15px;
  border: 1px solid var(--line);
  border-radius: var(--r-sm);
  font-family: var(--font-mono); font-size: 11px;
  color: var(--muted);
  background: transparent;
  transition: all var(--dur) var(--ease);
}
.fmt:hover {
  color: var(--text); border-color: var(--accent);
  transform: translateY(-1px);
}
.fmt .ic { font-size: 14px; }
.fmt .sz { color: var(--faint); font-size: 9px; }

/* visionneuse */
.viewer {
  position: relative;
  background: var(--bg-deep);
  border: 1px solid var(--line);
  border-radius: var(--r-md);
  min-height: 420px;
  display: flex; align-items: center; justify-content: center;
  overflow: auto;
}
.viewer img { max-width: 100%; display: block; margin: auto; }
.viewer .empty { border: 0; }
.viewer-toolbar {
  display: flex; align-items: center; gap: 10px;
  margin-bottom: var(--md); flex-wrap: wrap;
}
.viewer-toolbar .pg-label {
  font-family: var(--font-mono); font-size: 11px; color: var(--muted);
  min-width: 90px; text-align: center;
}

/* ---------- 09 · MODALE CAMÉRA & TOASTS ---------- */
.cam-overlay {
  position: fixed; inset: 0;
  background: rgba(4,6,10,.78);
  backdrop-filter: blur(10px);
  display: flex; align-items: center; justify-content: center;
  z-index: 200;
  animation: pageIn .22s var(--ease);
}
.cam-modal {
  width: min(600px, 94vw);
  border: 1px solid var(--line);
  border-radius: var(--r-lg);
  background: var(--surface);
  padding: var(--xl);
  box-shadow: var(--shadow-2);
}
.cam-modal h4 { font-family: var(--font-display); font-size: 22px; font-weight: 400; }
.cam-modal video {
  width: 100%; border-radius: var(--r-md);
  background: var(--bg-deep);
  margin-top: var(--lg); display: block;
}
.cam-actions { display: flex; gap: 10px; margin-top: var(--lg); }
.cam-shot {
  flex: 1;
  padding: 13px 18px;
  border-radius: var(--r-md);
  background: linear-gradient(135deg, var(--electric), var(--cyan));
  color: #0B0E14;
  font-weight: 800; font-size: 13px;
  transition: transform var(--dur) var(--ease), box-shadow .25s;
}
[data-theme="light"] .cam-shot { color: #FBFAF7; }
.cam-shot:hover { transform: translateY(-2px); box-shadow: 0 16px 40px rgba(97,230,224,.30); }
.cam-shot.ghost {
  flex: 0 0 auto;
  background: transparent;
  border: 1px solid var(--line);
  color: var(--muted);
}

#toasts {
  position: fixed; right: 18px; bottom: 18px;
  display: flex; flex-direction: column; gap: 10px;
  z-index: 300;
}
.toast {
  display: flex; gap: 11px; align-items: center;
  min-width: 260px; max-width: 380px;
  padding: 13px 17px;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--r-md);
  box-shadow: var(--shadow-2);
  font-size: 12.5px;
  animation: toastIn .28s var(--ease);
  transition: opacity .35s, transform .35s;
}
.toast.hide { opacity: 0; transform: translateX(14px); }
.toast .ic { width: 20px; height: 20px; flex: none; display: grid; place-items: center;
  border-radius: 50%; font-size: 11px; font-weight: 800; }
.toast.success .ic { background: color-mix(in srgb, var(--ok) 18%, transparent); color: var(--ok); }
.toast.error .ic   { background: color-mix(in srgb, var(--err) 18%, transparent); color: var(--err); }
.toast.info .ic    { background: color-mix(in srgb, var(--electric) 18%, transparent); color: var(--electric); }
@keyframes toastIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; } }

/* ---------- 10 · DIVERS ---------- */
.footer-note {
  text-align: center;
  color: var(--faint);
  font-family: var(--font-mono);
  font-size: 9.5px; letter-spacing: .18em; text-transform: uppercase;
  padding: var(--2xl) 0 var(--xl);
}
.hero-meta {
  display: flex; flex-wrap: wrap; gap: 10px;
  margin-top: var(--xl);
}
.hero-meta .hm {
  display: flex; flex-direction: column; gap: 3px;
  padding: 13px 17px;
  border: 1px solid var(--line);
  border-radius: var(--r-sm);
  min-width: 150px; max-width: 100%;
}
.hero-meta .hm .k {
  font-family: var(--font-mono); font-size: 8.5px;
  letter-spacing: .2em; text-transform: uppercase; color: var(--faint);
}
.hero-meta .hm .val {
  font-family: var(--font-mono); font-size: 11px; color: var(--text-2);
  word-break: break-word;
}
.recent-item {
  display: flex; align-items: center; gap: 13px;
  padding: 11px 12px;
  border-bottom: 1px solid var(--line-soft);
  cursor: pointer;
  transition: background var(--dur);
}
.recent-item:hover { background: rgba(139,157,255,.06); }
.recent-item .fn {
  flex: 1; min-width: 0;
  font-size: 12.5px;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}

/* ---------- 11 · RESPONSIVE ---------- */
@media (max-width: 980px) {
  .app { flex-direction: column; }
  .sidebar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: "brand controls" "nav nav";
    width: 100% !important;
    height: auto;
    position: sticky;
    top: 0;
    overflow: visible;
    align-items: center;
    background: color-mix(in srgb, var(--bg-deep) 94%, transparent);
    backdrop-filter: blur(14px);
  }
  .brand { grid-area: brand; min-width: 0; border-bottom: 0; padding: 8px 12px; }
  .brand-mark { width: 30px; height: 30px; }
  .nav {
    grid-area: nav;
    display: flex;
    gap: 6px;
    width: 100%;
    min-width: 0;
    padding: 7px 10px 9px;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scrollbar-width: thin;
    border-top: 1px solid var(--line-soft);
  }
  .nav-group { display: flex; flex: 0 0 auto; gap: 4px; }
  .nav-group + .nav-group { margin-top: 0; }
  .nav-label { display: none; }
  .nav-item { flex: 0 0 auto; width: auto; min-height: 38px; white-space: nowrap; }
  .nav-item.active::before { display: none; }
  .sidebar-foot { grid-area: controls; border-top: 0; padding: 6px 10px; }
  .sidebar-foot .foot-btn { flex: 0 0 auto; width: 40px; height: 40px; padding: 0; font-size: 0; }
  .sidebar-foot .foot-btn svg { width: 17px; height: 17px; }
  #sidebarCollapse { display: none; }
  .app.collapsed .sidebar { width: 100% !important; }
  .app.collapsed .brand-txt, .app.collapsed .nav-item .nav-txt { display: block; }
  .app.collapsed .nav-item { justify-content: flex-start; padding: 9px 10px; }
  .topbar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: "crumb lang" "search search" "chips chips";
    height: auto;
    gap: 10px 14px;
    padding: 12px 16px;
  }
  .crumb { grid-area: crumb; }
  .lang-switch { grid-area: lang; }
  .top-search { grid-area: search; display: block; width: 100%; max-width: none; margin: 0; }
  .top-chips { grid-area: chips; justify-self: start; flex-wrap: wrap; }
  .workspace { padding: 28px 18px 40px; }
  .col-side { position: static; }
}
@media (max-width: 720px) {
  .display { font-size: 32px; line-height: 1.12; }
  .lede { font-size: 14px; }
  .hero-grid { gap: var(--lg); }
  .top-chips .chip:not(.glow) { display: none; }
  .workspace { padding: 22px 14px 32px; }
  .panel { padding: 16px; }
  .page-head { gap: 12px; margin-bottom: 22px; }
  .tbl th, .tbl td { padding: 10px 9px; }
  #toasts { left: 12px; right: 12px; bottom: 12px; }
  .toast { width: 100%; max-width: none; min-width: 0; }
}

/* ---------- 12 · MOUVEMENT RÉDUIT ---------- */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .01ms !important;
  }
  .instrument:hover { transform: none; }
}
</style>
</head>
<body>

<div class="app" id="app">

  <!-- ═══════ BARRE LATÉRALE ═══════ -->
  <aside class="sidebar">
    <div class="brand">
      <div class="brand-mark">U</div>
      <div class="brand-txt">
        <div class="name">UniOCR</div>
        <div class="tag">Local document operations</div>
      </div>
    </div>

    <nav class="nav">
      <div class="nav-group">
        <div class="nav-label">Atelier</div>
        <button class="nav-item active" data-tab="tab-import" aria-controls="tab-import" aria-current="page">
          <svg class="nav-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 16V4m0 0l-4 4m4-4l4 4"/><path d="M4 16v3a1 1 0 001 1h14a1 1 0 001-1v-3"/></svg>
          <span class="nav-txt" data-i18n="nav.import">Importer</span><span class="nav-idx">01</span>
        </button>
        <button class="nav-item" data-tab="tab-docs" aria-controls="tab-docs">
          <svg class="nav-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 7h18M3 12h18M3 17h18"/></svg>
          <span class="nav-txt" data-i18n="nav.docs">Documents</span><span class="nav-idx">02</span>
        </button>
        <button class="nav-item" data-tab="tab-result" aria-controls="tab-result">
          <svg class="nav-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>
          <span class="nav-txt" data-i18n="nav.result">Résultat</span><span class="nav-idx">03</span>
        </button>
      </div>
      <div class="nav-group">
        <div class="nav-label">Maîtrise</div>
        <button class="nav-item" data-tab="tab-quality" aria-controls="tab-quality">
          <svg class="nav-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3l8 4v6c0 4.5-3.2 7.5-8 9-4.8-1.5-8-4.5-8-9V7z"/><path d="M9 12l2 2 4-4"/></svg>
          <span class="nav-txt" data-i18n="nav.quality">Qualité</span><span class="nav-idx">04</span>
        </button>
        <button class="nav-item" data-tab="tab-config" aria-controls="tab-config">
          <svg class="nav-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M19.1 4.9L17 7M7 17l-2.1 2.1"/></svg>
          <span class="nav-txt" data-i18n="nav.config">Configuration</span><span class="nav-idx">05</span>
        </button>
        <button class="nav-item" data-tab="tab-dashboard" aria-controls="tab-dashboard">
          <svg class="nav-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 20V10M10 20V4M16 20v-8M22 20H2"/></svg>
          <span class="nav-txt" data-i18n="nav.dashboard">Tableau de bord</span><span class="nav-idx">06</span>
        </button>
        <button class="nav-item" data-tab="tab-review" aria-controls="tab-review">
          <svg class="nav-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 4h16v5a2 2 0 01-2 2H6a2 2 0 01-2-2z"/><path d="M8 15h8M8 19h5"/></svg>
          <span class="nav-txt" data-i18n="nav.review">Révision</span><span class="nav-idx">07</span>
        </button>
        <button class="nav-item" data-tab="tab-profiles" aria-controls="tab-profiles">
          <svg class="nav-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 5h16v14H4z"/><path d="M8 5v14M4 9h4M4 13h4"/></svg>
          <span class="nav-txt" data-i18n="nav.profiles">Profils</span><span class="nav-idx">08</span>
        </button>
        <button class="nav-item" data-tab="tab-connectors" aria-controls="tab-connectors">
          <svg class="nav-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 7H6a3 3 0 000 6h3M15 17h3a3 3 0 000-6h-3M8 10h8"/></svg>
          <span class="nav-txt" data-i18n="nav.connectors">Connecteurs</span><span class="nav-idx">09</span>
        </button>
        <button class="nav-item" data-tab="tab-dossier" aria-controls="tab-dossier">
          <svg class="nav-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 7a2 2 0 012-2h4l2 2h8a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V7z"/><path d="M9 13h6M9 16h4"/></svg>
          <span class="nav-txt" data-i18n="nav.dossier">Dossier</span><span class="nav-idx">10</span>
        </button>
      </div>
    </nav>

    <div class="sidebar-foot">
      <button class="foot-btn" id="themeToggle" title="Basculer thème clair / sombre" aria-label="Basculer le thème">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></svg>
        <span class="foot-label">Thème</span>
      </button>
      <button class="foot-btn" id="sidebarCollapse" title="Réduire la barre latérale" aria-label="Réduire la barre latérale">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M9 4v16m4-8h5m-3-3 3 3-3 3"/></svg>
        <span class="foot-label">Réduire</span>
      </button>
    </div>
  </aside>

  <!-- ═══════ COLONNE PRINCIPALE ═══════ -->
  <div class="main">
    <header class="topbar">
      <div class="crumb">
        <h2 id="pageTitle">Importer un document</h2>
        <div class="sub" id="pageSub">Analyse visuelle et textuelle → données structurées</div>
      </div>
      <div class="lang-switch" role="group" aria-label="Langue de l'interface">
        <button type="button" class="lang-btn" data-lang="fr" aria-pressed="true">FR</button><button type="button" class="lang-btn" data-lang="en" aria-pressed="false">EN</button><button type="button" class="lang-btn" data-lang="ar" aria-pressed="false">ع</button>
      </div>
      <div class="top-search">
        <svg class="s-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4-4"/></svg>
        <input id="globalSearch" type="search" placeholder="Rechercher un document, un champ, un mot…"
               aria-label="Recherche globale de documents" autocomplete="off" role="combobox"
               aria-expanded="false" aria-controls="searchResults">
        <div class="search-results hidden" id="searchResults" role="listbox" aria-label="Résultats de recherche"></div>
      </div>
      <div class="top-chips">
        <div class="chip hidden" id="identChip" title="Utilisateur connecté et droits appliqués">
          <span class="dot"></span><span id="identTxt">—</span>
        </div>
        <div class="chip glow" id="enginesChip" title="État des moteurs OCR">
          <span class="dot"></span><span id="enginesTxt">connexion…</span>
        </div>
        <div class="chip" id="clockChip">—</div>
      </div>
    </header>

    <div class="modal-voile hidden" id="jetonVoile" role="dialog" aria-modal="true"
         aria-labelledby="jetonTitre">
      <div class="modal">
        <h3 id="jetonTitre">Connexion requise</h3>
        <p>Ce serveur applique des rôles et un cloisonnement par dossier
           (<span class="mono">data/rbac.json</span>). Saisissez le jeton qui
           vous a été remis : il détermine ce que vous pouvez voir et faire.</p>
        <div class="row">
          <input class="edit" id="jetonInput" type="password" autocomplete="current-password"
                 placeholder="jeton…" aria-label="Jeton d'accès">
          <button class="btn" id="jetonBtn">Entrer</button>
        </div>
      </div>
    </div>

    <div class="offline-banner" id="offlineBanner">
      <span class="anom-ic">▲</span>
      <span>API non jointe — saisissez l'URL du serveur UniOCR :</span>
      <input class="mono" id="apiBaseInput" placeholder="http://localhost:8000" aria-label="URL de l'API">
      <button class="btn sm" id="apiBaseBtn">Connecter</button>
    </div>

    <main class="workspace">

      <!-- ─────────── 01 · IMPORT ─────────── -->
      <section id="tab-import" class="page">
        <header class="page-head">
          <div class="page-index">01 — Atelier · Capture</div>
          <h1 class="display" data-i18n="h.import">Importez. Vérifiez. Exportez.</h1>
          <p class="lede">Traitez vos documents localement, examinez les valeurs extraites et gardez leur provenance à portée de main.</p>
          <div class="hero-meta">
            <div class="hm"><span class="k">Moteurs actifs</span><span class="val" id="homeEngines">—</span></div>
            <div class="hm"><span class="k">Activité mesurée</span><span class="val" id="homeStats">—</span></div>
          </div>
        </header>

        <div class="hero-grid">
          <div class="col-main">
            <!-- instrument d'importation -->
            <div class="instrument">
              <span class="corner tl"></span><span class="corner tr"></span>
              <span class="corner bl"></span><span class="corner br"></span>
              <span class="scanline"></span>
                  <div class="drop" id="dropZone" role="button" tabindex="0"
                   aria-label="Zone d'importation de documents">
                <input type="file" id="fileInput" class="hidden" style="display:none"
                       accept=".pdf,.png,.jpg,.jpeg,.tif,.tiff,.bmp,.webp,.docx,.odt,.txt,.rtf,.csv,.xlsx,.xls">
                <div class="ring">
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                    <path d="M7 18a4 4 0 01-.9-7.9 5.5 5.5 0 0110.6-1.4A4.5 4.5 0 0117.5 18H7z" stroke-linejoin="round"/>
                    <path d="M12 13v5m0-5l-2 2m2-2l2 2" stroke-linecap="round"/>
                  </svg>
                </div>
                <h4>Glissez votre document dans l'instrument</h4>
                <p>ou cliquez pour parcourir · 50 Mo max · traitement 100 % local</p>
                <div class="file-name" id="dropName"></div>
              </div>
              <div class="cam-row">
                <button class="btn ghost sm" id="cameraBtn">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M23 19a2 2 0 01-2 2H3a2 2 0 01-2-2V8a2 2 0 012-2h4l2-3h6l2 3h4a2 2 0 012 2z"/><circle cx="12" cy="13" r="4"/></svg>
                  📷 Prendre une photo
                </button>
                <span class="muted" style="font-size:11px">conteneur · plaque · carte grise — via la caméra</span>
                <input type="file" id="cameraInput" accept="image/*" capture="environment" style="display:none">
              </div>
            </div>

            <!-- actions principales -->
            <div style="margin-top:22px;display:flex;gap:11px;align-items:center;flex-wrap:wrap">
              <button class="btn" id="uploadBtn" disabled>
                Lancer l'analyse
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <button class="btn ghost sm" id="clearBtn" style="display:none">Retirer</button>
              <span class="muted" style="font-size:11.5px" id="uploadStatus" role="status" aria-live="polite" aria-atomic="true"></span>
            </div>

            <!-- derniers documents (données réelles) -->
            <div class="rule"></div>
            <div class="panel-head">
              <span class="idx">01.b</span>
              <h3 class="sec-title">Derniers documents</h3>
            </div>
            <div id="homeRecent" style="border-top:1px solid var(--line-soft)">
              <div class="empty">Aucun document traité pour l'instant — l'historique apparaîtra ici.</div>
            </div>
          </div>

          <!-- colonne latérale : réglages -->
          <aside class="col-side">
            <div class="panel">
              <div class="panel-head"><span class="idx">Profil</span>
                <h3 class="sec-title" style="font-size:18px">Réglages d'analyse</h3>
              </div>

              <label class="lb" for="profileSelect">Profil métier</label>
              <select class="inp" id="profileSelect"><option value="generic">Profil générique</option></select>
              <div class="muted" id="profileHint" style="font-size:10.5px;margin-top:6px;line-height:1.6"></div>

              <label class="lb">Mode qualité</label>
              <div class="seg" id="qualitySeg">
                <button type="button" data-qm="fast">🚀 Fast</button>
                <button type="button" data-qm="accurate" class="on">⚡ Accurate</button>
              </div>
              <div class="muted" style="font-size:10.5px;margin-top:6px;line-height:1.6" id="qmHint">
                Accurate compare les variantes et garde la meilleure.
              </div>

              <label class="lb">Langues (aucune sélection = auto-détection)</label>
              <div id="langChips" class="fmt-chips">
                <span class="muted" style="font-size:11px">chargement des modèles installés…</span>
              </div>

              <!-- options avancées -->
              <div class="adv" id="advPanel" style="margin-top:18px">
                <div class="adv-head" id="advToggle">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9L7 7M17 17l2.1 2.1M19.1 4.9L17 7M7 17l-2.1 2.1"/></svg>
                  Options avancées
                  <span class="pill" id="advCount" style="margin-left:8px">11 réglages</span>
                  <span class="chev">▾</span>
                </div>
                <div class="adv-body">
                  <div class="field-row">
                    <div>
                      <label class="lb" for="preprocessMode">Prétraitement</label>
                      <select class="inp" id="preprocessMode">
                        <option value="standard">standard — qualité détectée</option>
                        <option value="aggressive">agressif — scans dégradés</option>
                        <option value="off">désactivé — image brute</option>
                      </select>
                    </div>
                    <div>
                      <label class="lb" for="renderDpi">Résolution (PDF)</label>
                      <select class="inp" id="renderDpi">
                        <option value="150">150 DPI — rapide</option>
                        <option value="200" selected>200 DPI — recommandé</option>
                        <option value="300">300 DPI — fin</option>
                        <option value="400">400 DPI — maximum</option>
                      </select>
                    </div>
                  </div>
                  <div class="field-row">
                    <div>
                      <label class="lb" for="engineSelect">Moteur OCR</label>
                      <select class="inp" id="engineSelect">
                        <option value="auto">auto — sélection + consensus</option>
                        <option value="tesseract">tesseract uniquement</option>
                        <option value="native">couche texte native (PDF)</option>
                      </select>
                    </div>
                    <div>
                      <label class="lb" for="pageRange">Pages à traiter</label>
                      <input class="inp" type="text" id="pageRange" placeholder="toutes — ex. 1-3, 5">
                    </div>
                  </div>

                  <label class="lb" for="reviewRange">Seuil de revue humaine</label>
                  <div class="range-row">
                    <input type="range" id="reviewRange" min="50" max="95" step="5" value="70">
                    <div class="range-val" id="reviewVal">70 %</div>
                  </div>
                  <div class="muted" style="font-size:10.5px;margin-top:5px">
                    En dessous de ce score, les champs sont signalés dans l'onglet Qualité.
                  </div>

                  <label class="lb">Modules d'extraction</label>
                  <div class="toggles">
                    <label class="mini-switch"><input type="checkbox" id="exFields" checked><span class="track"></span><span class="lbl">Champs &amp; profils</span></label>
                    <label class="mini-switch"><input type="checkbox" id="exTables" checked><span class="track"></span><span class="lbl">Tableaux</span></label>
                    <label class="mini-switch"><input type="checkbox" id="exBarcodes" checked><span class="track"></span><span class="lbl">Codes-barres</span></label>
                    <label class="mini-switch"><input type="checkbox" id="variantCmp" checked><span class="track"></span><span class="lbl">Variantes</span></label>
                  </div>

                  <label class="lb">Exports générés en fin de traitement</label>
                  <div class="fmt-chips" id="fmtChips">
                    <label class="langchip on"><input type="checkbox" data-fmt="json" checked hidden>🧬 JSON</label>
                    <label class="langchip on"><input type="checkbox" data-fmt="txt" checked hidden>📄 TXT</label>
                    <label class="langchip on"><input type="checkbox" data-fmt="csv" checked hidden>📑 CSV</label>
                    <label class="langchip on"><input type="checkbox" data-fmt="xlsx" checked hidden>📊 XLSX</label>
                    <label class="langchip on"><input type="checkbox" data-fmt="xml" checked hidden>🔮 XML</label>
                    <label class="langchip on"><input type="checkbox" data-fmt="pdf" checked hidden>📕 PDF</label>
                  </div>
                  <div class="muted" style="font-size:10.5px;margin-top:5px">
                    Les formats non cochés restent téléchargeables à la demande depuis l'onglet Résultat.
                  </div>
                </div>
              </div>
            </div>

            <!-- pipeline -->
            <div class="panel">
              <div class="panel-head"><span class="idx">Live</span>
                <h3 class="sec-title" style="font-size:18px">Pipeline en direct</h3>
              </div>
              <div class="progress" role="progressbar" aria-label="Progression du traitement" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><i id="progressBar"></i></div>
              <div class="steps" id="pipelineSteps">
                <div class="step" data-stage="ingest"><span class="st-idx">01</span><span class="st-dot"></span><span>Ingestion &amp; sécurité</span></div>
                <div class="step" data-stage="ocr"><span class="st-idx">02</span><span class="st-dot"></span><span>OCR &amp; langues</span></div>
                <div class="step" data-stage="tables"><span class="st-idx">03</span><span class="st-dot"></span><span>Tableaux &amp; structure</span></div>
                <div class="step" data-stage="fields"><span class="st-idx">04</span><span class="st-dot"></span><span>Champs métier</span></div>
                <div class="step" data-stage="quality"><span class="st-idx">05</span><span class="st-dot"></span><span>Contrôle qualité</span></div>
                <div class="step" data-stage="done"><span class="st-idx">06</span><span class="st-dot"></span><span>Terminé</span></div>
              </div>
              <div class="logbox" id="processLog" role="log" aria-live="polite" aria-label="Journal du traitement">
                <div class="muted">En attente d'un document…</div>
              </div>
              <div id="exportLinks" class="export-grid" style="margin-top:16px"></div>
            </div>
          </aside>
        </div>

        <!-- ─── traitement par lots ─── -->
        <div class="panel" style="margin-top:26px">
          <div class="panel-head">
            <span class="idx">Lots</span>
            <h3 class="sec-title" style="font-size:18px">Traitement par lots</h3>
          </div>
          <p class="muted" style="font-size:12.5px;margin:0 0 16px;max-width:70ch">
            Déposez plusieurs documents d'un coup. Un fichier déjà traité n'est pas
            recalculé — son résultat existant est réutilisé. Les fichiers refusés
            (format ou taille) sont écartés et signalés, sans faire échouer le lot.
          </p>

          <div class="batch-bar">
            <button class="btn" id="batchPick">📁 Choisir des documents</button>
            <input type="file" id="batchInput" class="hidden" style="display:none" multiple
                   accept=".pdf,.png,.jpg,.jpeg,.tif,.tiff,.bmp,.webp,.docx,.odt,.txt,.rtf,.csv,.xlsx,.xls">
            <span class="muted mono" id="batchCount" style="font-size:11px">aucun fichier</span>
            <button class="btn ghost" id="batchClear" disabled>Vider</button>
          </div>

          <div id="batchFiles" class="batch-files"></div>

          <div class="batch-bar" style="margin-top:16px">
            <button class="btn" id="batchRun" disabled>Lancer le traitement</button>
            <span class="muted mono" id="batchStatus" style="font-size:11px"></span>
          </div>

          <div id="batchResult" class="batch-result"></div>
        </div>
      </section>

      <!-- ─────────── 02 · DOCUMENTS ─────────── -->
      <section id="tab-docs" class="page hidden">
        <header class="page-head">
          <div class="page-index">02 — Atelier · Archive</div>
          <h1 class="display" data-i18n="h.docs">Documents <em>traités</em></h1>
          <p class="lede">Historique complet des traitements, avec état, profil et accès
            immédiat aux résultats.</p>
        </header>

        <div style="display:flex;gap:12px;flex-wrap:wrap;margin-bottom:20px">
          <div style="flex:1;min-width:220px">
            <input class="inp" id="docSearch" type="search" placeholder="Rechercher par nom de fichier…" aria-label="Rechercher un document">
          </div>
          <div style="width:210px">
            <select class="inp" id="filterStatus" aria-label="Filtrer par état">
              <option value="">Tous les états</option>
              <option value="done">Terminé</option>
              <option value="processing">En cours</option>
              <option value="error">Erreur</option>
            </select>
          </div>
        </div>

        <div class="panel panel-flush">
          <div class="table-scroll" role="region" aria-label="Liste des documents" tabindex="0">
          <table class="tbl" id="jobsTable">
            <thead>
              <tr><th>Fichier</th><th>État</th><th>Progression</th><th>Profil</th><th>Créé le</th><th></th></tr>
            </thead>
            <tbody></tbody>
          </table>
          </div>
          <div class="empty" id="jobsEmpty">Aucun document pour l'instant.<br>
            <b>Lancez un premier traitement depuis l'onglet Importer.</b></div>
        </div>
      </section>

      <!-- ─────────── 03 · RÉSULTAT ─────────── -->
      <section id="tab-result" class="page hidden">
        <header class="page-head">
          <div class="page-index">03 — Analyse · Données extraites</div>
          <h1 class="display" data-i18n="h.result">Résultat <em>d'analyse</em></h1>
          <p class="lede">Texte, champs, tableaux — chaque valeur reliée à sa zone exacte
            dans le document source.</p>
        </header>

        <div class="hero-grid" style="grid-template-columns:minmax(0,1.3fr) minmax(340px,1fr)">
          <!-- A · document source -->
          <div class="col-main">
            <div class="viewer-toolbar">
              <span class="idx page-index" style="margin:0">A · Source</span>
              <button class="btn ghost sm" id="prevPage" aria-label="Page précédente">←</button>
              <span class="pg-label" id="pageLabel">— / —</span>
              <button class="btn ghost sm" id="nextPage" aria-label="Page suivante">→</button>
              <span class="pill lang" id="langBadge" style="margin-left:auto">langues —</span>
              <span class="pill" id="variantBadge">variante —</span>
            </div>
            <div class="viewer" id="viewer">
              <div class="empty">Aucun résultat chargé.<br>
                <b>Traitez un document ou ouvrez-le depuis l'onglet Documents.</b></div>
            </div>
            <div style="margin-top:14px">
              <input class="inp" id="textSearch" type="search" placeholder="Rechercher dans le texte…" aria-label="Rechercher dans le texte">
              <textarea class="inp" id="textView" readonly rows="9"
                placeholder="Le texte reconnu, page par page, apparaîtra ici…"
                aria-label="Texte reconnu"
                style="margin-top:10px;font-family:var(--font-mono);font-size:11.5px;line-height:1.7;resize:vertical;min-height:170px"></textarea>
            </div>
          </div>

          <!-- C · données extraites -->
          <aside class="col-side">
            <div class="panel">
              <div class="panel-head"><span class="idx">C · Données</span>
                <h3 class="sec-title" style="font-size:19px">Champs extraits</h3>
              </div>
              <div class="sel-bar">
                <label class="ph-check" for="selAll">
                  <input type="checkbox" id="selAll">
                  <span>Tout sélectionner</span>
                </label>
                <span class="muted mono" id="selCount" style="font-size:10.5px">0 champ</span>
                <button class="btn ghost sm" id="exportSelCsv" disabled>Exporter la sélection (CSV)</button>
                <button class="btn ghost sm" id="exportSelJson" disabled>JSON</button>
              </div>
              <div style="overflow-x:auto">
                <table class="tbl" id="fieldsTable">
                  <thead>
                    <tr><th>Sel.</th><th>Champ</th><th>Valeur brute</th><th>Normalisée</th><th>Confiance</th><th>Statut</th><th>Validation</th></tr>
                  </thead>
                  <tbody></tbody>
                </table>
              </div>
              <div class="empty" id="fieldsEmpty" style="display:none"></div>
            </div>

            <div class="panel">
              <div class="panel-head"><span class="idx">Export</span>
                <h3 class="sec-title" style="font-size:19px">Exporter</h3>
              </div>
              <div class="export-grid" id="exportLinksResult"></div>
            </div>
          </aside>
        </div>

        <div class="rule"></div>

        <div class="hero-grid" style="grid-template-columns:1fr 1fr">
          <div>
            <div class="panel-head"><span class="idx">B · Structure</span>
              <h3 class="sec-title">Tableaux reconstruits</h3>
            </div>
            <div class="scroll" id="tablesView" style="overflow-x:auto">
              <div class="empty">Les tableaux détectés apparaîtront ici.</div>
            </div>
          </div>
          <div>
            <div class="panel-head"><span class="idx">D · Annexes</span>
              <h3 class="sec-title">Codes-barres &amp; moteurs</h3>
            </div>
            <div id="barcodesView">
              <div class="empty">Codes-barres et QR détectés.</div>
            </div>
            <div id="enginesView" style="margin-top:18px"></div>
          </div>
        </div>
      </section>

      <!-- ─────────── 04 · QUALITÉ ─────────── -->
      <section id="tab-quality" class="page hidden">
        <header class="page-head">
          <div class="page-index">04 — Maîtrise · Confiance</div>
          <h1 class="display" data-i18n="h.quality">Contrôle <em>qualité</em></h1>
          <p class="lede">Deux confiances (moteur et système), anomalies, cohérence métier
            et validation humaine. Aucun score n'est simulé.</p>
        </header>

        <div class="hero-grid" style="grid-template-columns:1fr 1fr 1fr">
          <div class="panel"><div class="stat">
            <span class="lbl">Confiance moteur</span>
            <div class="gv"><div class="v grad-text" id="qEngine">—</div><div class="sub">moyenne OCR</div></div>
          </div></div>
          <div class="panel"><div class="stat">
            <span class="lbl">Confiance système</span>
            <div class="gv"><div class="v" id="qGlobal">—</div><div class="sub">qualité × moteur</div></div>
          </div></div>
          <div class="panel"><div class="stat">
            <span class="lbl">Anomalies</span>
            <div class="gv"><div class="v grad-text" id="qAnom">—</div><div class="sub" id="qAnomBreak"></div></div>
          </div></div>
        </div>

        <div class="rule"></div>

        <div class="hero-grid" style="grid-template-columns:1fr 1fr">
          <div>
            <div class="panel-head"><span class="idx">A</span><h3 class="sec-title">Anomalies détectées</h3></div>
            <div id="anomaliesView"><div class="empty">Aucune anomalie — ou aucun résultat chargé.</div></div>
          </div>
          <div>
            <div class="panel-head"><span class="idx">B</span><h3 class="sec-title">Désaccords moteurs &amp; cohérence</h3></div>
            <div id="disagreementsView"><div class="empty">Aucun désaccord — ou aucun résultat chargé.</div></div>
          </div>
        </div>
      </section>

      <!-- ─────────── 05 · CONFIGURATION ─────────── -->
      <section id="tab-config" class="page hidden">
        <header class="page-head">
          <div class="page-index">05 — Maîtrise · Système</div>
          <h1 class="display" data-i18n="h.config">Configuration <em>réelle</em></h1>
          <p class="lede">Uniquement ce qui est réellement installé et vérifié — moteurs,
            modèles de langues, profils métier.</p>
        </header>

        <div class="panel-head"><span class="idx">A</span><h3 class="sec-title">Moteurs OCR</h3></div>
        <div id="enginesList" class="panel"><div class="empty">Chargement…</div></div>

        <div class="rule"></div>

        <div class="hero-grid" style="grid-template-columns:1fr 1fr">
          <div>
            <div class="panel-head"><span class="idx">B</span><h3 class="sec-title">Modèles de langues</h3></div>
            <div id="langsView"><div class="empty">Chargement…</div></div>
          </div>
          <div>
            <div class="panel-head"><span class="idx">C</span><h3 class="sec-title">Profils métier</h3></div>
            <div id="profilesView"><div class="empty">Chargement…</div></div>
          </div>
        </div>
      </section>

      <!-- ─────────── 06 · TABLEAU DE BORD ─────────── -->
      <section id="tab-dashboard" class="page hidden">
        <header class="page-head">
          <div class="page-index">06 — Maîtrise · Mesure</div>
          <h1 class="display" data-i18n="h.dashboard">Tableau de <em>bord</em></h1>
          <p class="lede">Activité réelle du service et ressources système — mesurées,
            jamais estimées.</p>
        </header>

        <div class="hero-grid" style="grid-template-columns:1fr 1fr 1fr 1fr">
          <div class="panel"><div class="stat"><span class="lbl">Documents</span>
            <div class="v grad-text" id="stTotal" style="font-family:var(--font-display);font-size:42px">0</div></div></div>
          <div class="panel"><div class="stat"><span class="lbl">Terminés</span>
            <div class="v" id="stDone" style="font-family:var(--font-display);font-size:42px">0</div></div></div>
          <div class="panel"><div class="stat"><span class="lbl">Erreurs</span>
            <div class="v" id="stError" style="font-family:var(--font-display);font-size:42px">0</div></div></div>
          <div class="panel"><div class="stat"><span class="lbl">Mémoire</span>
            <div class="v" id="stMem" style="font-family:var(--font-display);font-size:42px">—</div></div></div>
        </div>

        <div class="rule"></div>

        <div class="panel-head"><span class="idx">A</span><h3 class="sec-title">Activité récente</h3></div>
        <div class="bar-chart" id="statusChart"></div>

        <div class="panel-head" style="margin-top:28px"><span class="idx">B</span><h3 class="sec-title">Sauvegarde du magasin</h3></div>
        <div class="panel" style="padding:18px 20px">
          <p style="margin:0 0 14px;color:var(--dim);font-size:13px;line-height:1.6">
            Documents traités, corrections humaines et transmissions vivent dans le
            magasin local. Rien ne le protégeait d'une suppression accidentelle :
            une sauvegarde vérifiée est le seul moyen de récupérer ce travail.
          </p>
          <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center">
            <button class="btn primary" id="btnBackupNow">Sauvegarder maintenant</button>
            <button class="btn" id="btnBackupList">Lister les sauvegardes</button>
          </div>
          <div id="backupOut" style="margin-top:14px"></div>
        </div>

        <div class="panel-head" style="margin-top:28px"><span class="idx">C</span><h3 class="sec-title">Journal d'audit</h3></div>
        <div class="audit-bar">
          <select class="inp" id="auditEvent" aria-label="Filtrer par type d'événement">
            <option value="">Tous les événements</option>
          </select>
          <input class="inp" id="auditQuery" type="search" placeholder="Filtrer (job, fichier, profil…)…"
                 aria-label="Filtrer le journal d'audit">
          <button class="btn ghost sm" id="auditRefresh">↻ Actualiser</button>
        </div>
        <div class="logbox" id="auditLog"><div class="muted">Activité des traitements…</div></div>
      </section>

      <section id="tab-review" class="page hidden">
        <div class="page-head">
          <div>
            <div class="ph-kicker">File de validation</div>
            <h3 class="ph-title">À réviser</h3>
            <p class="ph-sub">Seuls les champs qu'un humain doit trancher : invalides, ambigus,
              non détectés ou sous le seuil de confiance. Le reste ne s'affiche pas.</p>
          </div>
          <div class="ph-actions">
            <label class="ph-field" for="reviewThreshold">Seuil de confiance</label>
            <select class="inp" id="reviewThreshold" aria-label="Seuil de confiance">
              <option value="0.9">Strict — 90 %</option>
              <option value="0.75" selected>Normal — 75 %</option>
              <option value="0.5">Permissif — 50 %</option>
            </select>
            <label class="ph-check" for="reviewUndetected">
              <input type="checkbox" id="reviewUndetected">
              <span>inclure les champs non détectés</span>
            </label>
            <button class="btn ghost sm" id="reviewRefresh">↻ Actualiser</button>
          </div>
        </div>

        <div class="stat-row" id="reviewStats"></div>

        <div class="card">
          <div class="card-head">
            <div class="card-title">Champs en attente</div>
            <div class="card-sub" id="reviewCount">—</div>
          </div>
          <div id="reviewList"></div>
        </div>

        <div class="kbd-help">
          <b>j</b>/<b>k</b> parcourir · <b>Entrée</b> valider la valeur du champ focalisé ·
          <b>u</b> annuler la correction (motif demandé, historique conservé) ·
          <b>o</b> ouvrir le document source
        </div>
      </section>

      <!-- ─────────── 08 · PROFILS ─────────── -->
      <section id="tab-profiles" class="page hidden">
        <header class="page-head">
          <div class="page-index">08 — Maîtrise · Profils d'extraction</div>
          <h1 class="display" data-i18n="h.profiles">Profils <em>métier</em></h1>
          <p class="lede">Définissez les champs à extraire, leurs motifs et leurs
            validateurs — puis essayez le profil sur un document réel avant de l'enregistrer.
            Les profils que vous créez vivent dans <span class="mono">data/profiles/</span> :
            une mise à jour du projet ne les écrasera jamais.</p>
        </header>

        <div class="prof-layout">
          <!-- colonne gauche : liste + sélection -->
          <aside class="prof-col">
            <div class="panel-head"><span class="idx">Bibliothèque</span>
              <h3 class="sec-title" style="font-size:17px">Profils disponibles</h3>
            </div>
            <div id="profList" class="prof-list"></div>
            <button class="btn" id="profNew" style="width:100%;margin-top:12px">+ Nouveau profil</button>
          </aside>

          <!-- colonne droite : éditeur -->
          <div class="prof-col prof-editor">
            <div id="profEmpty" class="empty" style="display:none">
              Sélectionnez un profil à gauche, ou créez-en un nouveau.
            </div>

            <div id="profForm" class="prof-form" style="display:none">
              <div class="panel-head">
                <span class="idx" id="profSource">—</span>
                <h3 class="sec-title" style="font-size:19px" id="profTitle">Profil</h3>
              </div>

              <div class="prof-meta">
                <label class="lb" for="profName">Identifiant (nom de fichier)</label>
                <input class="inp" id="profName" placeholder="mon_profil" aria-label="Identifiant du profil">
                <label class="lb" for="profLabel">Libellé affiché</label>
                <input class="inp" id="profLabel" placeholder="Mon profil métier" aria-label="Libellé">
                <label class="lb" for="profDesc">Description</label>
                <input class="inp" id="profDesc" placeholder="À quoi sert ce profil" aria-label="Description">
              </div>

              <div class="prof-actions">
                <button class="btn" id="profSave">Enregistrer</button>
                <button class="btn ghost" id="profDelete">Supprimer</button>
                <span class="muted mono" id="profMsg" style="font-size:10.5px"></span>
              </div>

              <div class="panel-head" style="margin-top:26px">
                <span class="idx">Champs</span>
                <h3 class="sec-title" style="font-size:17px">Champs extraits</h3>
                <button class="btn ghost sm" id="profAddField" style="margin-left:auto">+ Ajouter un champ</button>
              </div>
              <div id="profFields" class="prof-fields"></div>

              <div class="panel-head" style="margin-top:26px">
                <span class="idx">Essai</span>
                <h3 class="sec-title" style="font-size:17px">Essayer sur un document</h3>
              </div>
              <p class="muted" style="font-size:12px;margin:0 0 12px;max-width:70ch">
                Collez un extrait de texte, ou indiquez l'identifiant d'un document
                déjà traité. Rien n'est enregistré : c'est un essai à blanc.
              </p>
              <div class="prof-test">
                <input class="inp" id="profTestJob" placeholder="job_id (optionnel)" aria-label="Identifiant de document">
                <textarea class="inp" id="profTestText" rows="5"
                  placeholder="…ou collez ici le texte du document" aria-label="Texte à essayer"></textarea>
                <button class="btn" id="profRunTest">Essayer</button>
              </div>
              <div id="profTestOut" class="prof-test-out"></div>
            </div>
          </div>
        </div>
      </section>
      <!-- ─────────── 10 · PARCOURS DOCUMENTAIRE ─────────── -->
      <section id="tab-dossier" class="page hidden">
        <header class="page-head">
          <div class="page-index">10 — Parcours · Dossier documentaire</div>
          <h1 class="display" data-i18n="h.dossier">Parcours <em>documentaire</em></h1>
          <p class="ph-sub" data-i18n="h.dossier.sub">
            Regrouper les documents d'un même envoi, les comparer entre eux,
            puis produire un paquet de données. Chaque état affiché est déduit
            de faits réels — rien n'est déclaré terminé sans l'avoir été.
          </p>
        </header>

        <div class="card">
          <div class="card-head">
            <div class="card-title">Nouveau dossier</div>
            <div class="card-sub">
              Un profil décrit des conventions de rangement, jamais des
              obligations réglementaires.
            </div>
          </div>
          <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:flex-end">
            <label class="ph-field" for="dossierLabel">Libellé</label>
            <input class="inp" id="dossierLabel" placeholder="ex. Import 2024-118"
                   style="flex:1;min-width:220px">
            <label class="ph-field" for="dossierProfile">Profil</label>
            <select class="inp" id="dossierProfile" aria-label="Profil de dossier"></select>
            <button class="btn" id="dossierCreer">Créer le dossier</button>
          </div>
        </div>

        <div class="card">
          <div class="card-head">
            <div class="card-title">Dossiers existants</div>
            <div class="card-sub">Cliquez sur un libellé pour l'ouvrir</div>
          </div>
          <div id="dossierListe"><div class="card-sub">Chargement…</div></div>
        </div>

        <div class="card">
          <div class="card-head">
            <div class="card-title">Types de documents reconnus</div>
            <div class="card-sub">
              Ce que le classifieur sait distinguer, et où il s'arrête
            </div>
          </div>
          <div id="dossierTypes"><div class="card-sub">Chargement…</div></div>
        </div>

        <div id="dossierDetail">
          <div class="card-sub">
            Sélectionnez un dossier, ou créez-en un, pour voir ses pièces, les
            contrôles de cohérence et générer un paquet de données.
          </div>
        </div>
      </section>

      <section id="tab-connectors" class="page hidden">
        <header class="page-head">
          <div class="page-index">09 — Intégration · Connecteur Hub</div>
          <h1 class="display" data-i18n="h.connectors">Connecteur <em>Hub</em></h1>
          <p class="lede">
            Pont entre vos documents traités et les systèmes qui doivent les recevoir.
            Rien n'est envoyé sans validation humaine explicite, et l'état d'un
            connecteur repose sur un <strong>test réel</strong>, jamais sur un
            interrupteur. Le connecteur de démonstration est un
            <strong>simulateur local</strong> : il n'est pas une intégration réelle.
          </p>
        </header>

        <div class="cnx">
          <!-- ═══ barre des 12 sous-menus ═══ -->
          <nav class="cnx-subnav" id="cnxSubnav" role="tablist" aria-label="Sections du Connecteur Hub"></nav>

          <!-- ══════════ 01 · VUE D'ENSEMBLE ══════════ -->
          <div class="cnx-pane" data-cnx="overview">
            <div class="cnx-grid" id="cnxOverview"></div>
          </div>

          <!-- ══════════ 02 · CATALOGUE ══════════ -->
          <div class="cnx-pane hidden" data-cnx="catalog">
            <div class="panel-head"><span class="idx">02</span>
              <h3 class="sec-title">Adaptateurs disponibles</h3></div>
            <p class="cnx-note">
              Un adaptateur décrit <em>comment parler</em> à un type de système.
              L'ajouter ne le connecte à rien : il faut encore le configurer puis
              le tester. Aucun adaptateur réel n'est livré ici faute d'accès
              autorisé et documenté.
            </p>
            <div id="cnxCatalog" class="cnx-cards"></div>
          </div>

          <!-- ══════════ 03 · CONNECTEURS ACTIFS ══════════ -->
          <div class="cnx-pane hidden" data-cnx="active">
            <div class="panel-head"><span class="idx">03</span>
              <h3 class="sec-title">Connecteurs configurés</h3></div>
            <div id="cnxActive" class="cnx-cards"></div>
          </div>

          <!-- ══════════ 04 · AJOUTER (assistant 9 étapes) ══════════ -->
          <div class="cnx-pane hidden" data-cnx="add">
            <div class="panel-head"><span class="idx">04</span>
              <h3 class="sec-title">Assistant de création</h3></div>
            <ol class="cnx-steps" id="cnxSteps"></ol>
            <div class="cnx-wizard" id="cnxWizard"></div>
          </div>

          <!-- ══════════ 05 · CONFIGURATION ══════════ -->
          <div class="cnx-pane hidden" data-cnx="config">
            <div class="panel-head"><span class="idx">05</span>
              <h3 class="sec-title">Configuration détaillée</h3></div>
            <div class="cnx-form" id="cnxConfig"></div>
          </div>

          <!-- ══════════ 06 · CORRESPONDANCE DES CHAMPS ══════════ -->
          <div class="cnx-pane hidden" data-cnx="mapping">
            <div class="panel-head"><span class="idx">06</span>
              <h3 class="sec-title">Correspondance des champs</h3></div>
            <p class="cnx-note">
              Le moteur propose des correspondances par similarité, mais
              <strong>ne les applique jamais seul</strong> : chaque règle est
              explicite, versionnée et traçable.
            </p>
            <div class="cnx-mapping" id="cnxMapping"></div>
          </div>

          <!-- ══════════ 07 · MODÈLES DE FORMULAIRES ══════════ -->
          <div class="cnx-pane hidden" data-cnx="forms">
            <div class="panel-head"><span class="idx">07</span>
              <h3 class="sec-title">Modèles de formulaires</h3></div>
            <p class="cnx-note">
              Structures <strong>déclarées par vous</strong>. Elles ne prétendent
              pas reproduire un formulaire officiel : sans documentation de
              l'organisme, la structure reste une base de travail.
            </p>
            <div class="cnx-forms" id="cnxForms"></div>
          </div>

          <!-- ══════════ 08 · FLUX D'INTÉGRATION ══════════ -->
          <div class="cnx-pane hidden" data-cnx="flow">
            <div class="panel-head"><span class="idx">08</span>
              <h3 class="sec-title">Flux d'intégration</h3></div>
            <p class="cnx-note">Trois modes, du plus contrôlé au plus automatisé.
              Le mode A n'est activable qu'avec un accès API autorisé et documenté.</p>
            <div class="cnx-modes" id="cnxModes"></div>
          </div>

          <!-- ══════════ 09 · HISTORIQUE DES TRANSMISSIONS ══════════ -->
          <div class="cnx-pane hidden" data-cnx="history">
            <div class="panel-head"><span class="idx">09</span>
              <h3 class="sec-title">Historique des transmissions</h3></div>
            <div id="cnxHistory"></div>
          </div>

          <!-- ══════════ 10 · ERREURS ET REPRISES ══════════ -->
          <div class="cnx-pane hidden" data-cnx="errors">
            <div class="panel-head"><span class="idx">10</span>
              <h3 class="sec-title">Erreurs et reprises</h3></div>
            <p class="cnx-note">
              Avant toute reprise, le système vérifie si la demande a déjà été
              acceptée. Un rejet métier n'est <strong>jamais</strong> rejoué
              automatiquement.
            </p>
            <div id="cnxErrors"></div>
          </div>

          <!-- ══════════ 11 · SÉCURITÉ ET AUTORISATIONS ══════════ -->
          <div class="cnx-pane hidden" data-cnx="security">
            <div class="panel-head"><span class="idx">11</span>
              <h3 class="sec-title">Sécurité et autorisations</h3></div>
            <div id="cnxSecurity"></div>
          </div>

          <!-- ══════════ 12 · JOURNAUX D'AUDIT ══════════ -->
          <div class="cnx-pane hidden" data-cnx="audit">
            <div class="panel-head"><span class="idx">12</span>
              <h3 class="sec-title">Journaux d'audit</h3></div>
            <div id="cnxAudit"></div>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer-note">
      UniOCR · Future Editorial Intelligence — traçabilité · sécurité · contrôle humain · 100 % local
    </footer>
  </div>
</div>

<!-- ═══════ AIDE RACCOURCIS ═══════ -->
<div class="modal-bg hidden" id="helpOverlay">
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="helpTitle">
    <div class="modal-head">
      <div class="card-title" id="helpTitle">Raccourcis clavier</div>
      <button class="btn ghost sm" id="helpClose" aria-label="Fermer">✕</button>
    </div>
    <div class="kbd-grid">
      <div><span class="kbd">/</span> focaliser la recherche</div>
      <div><span class="kbd">g</span> puis <span class="kbd">1…7</span> changer d'onglet</div>
      <div><span class="kbd">j</span> / <span class="kbd">k</span> champ suivant / précédent (révision)</div>
      <div><span class="kbd">Entrée</span> valider le champ focalisé</div>
      <div><span class="kbd">o</span> ouvrir le document source</div>
      <div><span class="kbd">t</span> basculer le thème clair / sombre</div>
      <div><span class="kbd">Échap</span> fermer recherche ou aide</div>
      <div><span class="kbd">?</span> afficher cette aide</div>
    </div>
    <div class="kbd-note">Les raccourcis sont inactifs pendant la saisie dans un champ.</div>
  </div>
</div>

<!-- ═══════ TOASTS & MODALE CAMÉRA ═══════ -->
<div id="toasts" role="status" aria-live="polite" aria-atomic="false"></div>

<div class="cam-overlay" id="camOverlay" style="display:none" role="dialog" aria-modal="true" aria-labelledby="camDialogTitle" aria-hidden="true">
  <div class="cam-modal">
    <h4 id="camDialogTitle">Capture photo</h4>
    <div class="muted" style="font-size:11.5px;margin-top:4px">
      Cadrez le document (numéro de conteneur, plaque, carte grise…) puis capturez.
    </div>
    <label class="lb" for="camMode">Type de capture (prépare le profil)</label>
    <select class="inp" id="camMode">
      <option value="">Document / photo libre</option>
      <option value="container">📦 Conteneur (ISO 6346)</option>
      <option value="vehicle_plate">🚗 Plaque / véhicule</option>
      <option value="carte_grise">🪪 Carte grise</option>
    </select>
    <video id="camVideo" autoplay playsinline muted></video>
    <canvas id="camCanvas" style="display:none"></canvas>
    <div class="cam-actions">
      <button class="cam-shot" id="camCaptureBtn">📸 Capturer</button>
      <button class="cam-shot ghost" id="camCancelBtn">Annuler</button>
    </div>
    <div class="muted" style="font-size:10.5px;margin-top:10px" id="camNote"></div>
  </div>
</div>

<script>
/* Correctif : le code applicatif appelle api(...) mais seule fetchJson était
   définie, ce qui faisait échouer silencieusement initLangChips() — les puces
   de langue ne se chargeaient donc jamais. On rétablit api comme alias. */
if (typeof api !== "function") {
  var api = function (path, opts) { return fetchJson(path, opts); };
}

/* =================== STATE =================== */
let API = localStorage.getItem("unocr_api") || "";
let currentJob = null, currentResult = null, currentPage = 1, currentFile = null;
let MOI = null;   // identite et droits renvoyés par /api/rbac/moi
let connected = false;

/* Parse d'erreur robuste : l'API renvoie du JSON, un proxy peut renvoyer du texte brut */
async function readError(r) {
  const text = (await r.text().catch(() => "")).trim();
  try {
    const j = JSON.parse(text);
    return j.detail || j.message || text || ("HTTP " + r.status);
  } catch {
    return ("HTTP " + r.status + " — " + (text.slice(0, 120) || "réponse invalide"));
  }
}

function apiUrl(path) { return (API || "") + path; }

/* Jeton d'authentification. Quand data/rbac.json existe, l'API exige un
   jeton ; il est conserve dans localStorage et envoye a chaque appel. Sans
   RBAC actif, rien n'est envoye et l'application se comporte comme avant. */
var JETON = null;
try { JETON = localStorage.getItem("unocr.jeton") || null; } catch (e) { JETON = null; }

function definirJeton(valeur) {
  JETON = valeur ? String(valeur).trim() : null;
  try {
    if (JETON) localStorage.setItem("unocr.jeton", JETON);
    else localStorage.removeItem("unocr.jeton");
  } catch (e) { /* stockage indisponible : le jeton ne survit pas au rechargement */ }
  majEnteteJeton();
}
function entetesJeton(opts) {
  if (!JETON) return opts;
  opts = opts || {};
  opts.headers = Object.assign({}, opts.headers, { Authorization: "Bearer " + JETON });
  return opts;
}

async function fetchAuthenticated(path, opts) {
  const r = await fetch(apiUrl(path), entetesJeton(opts));
  if (r.status === 401 && path.indexOf("/api/rbac/moi") !== 0) {
    definirJeton(null);
    demanderJeton();
    throw new Error("Session expirée ou jeton inconnu — reconnexion demandée.");
  }
  return r;
}

async function fetchJson(path, opts) {
  const r = await fetchAuthenticated(path, opts);
  if (!r.ok) throw new Error(await readError(r));
  try { return await r.json(); }
  catch { throw new Error("Réponse illisible du serveur (contenu non-JSON)"); }
}

const PAGE_META = {
  "tab-import": ["Importer un document", "Analyse visuelle et textuelle → données structurées"],
  "tab-docs": ["Documents", "Historique des traitements et suivi des jobs"],
  "tab-result": ["Résultat d'analyse", "Texte, champs, tableaux — reliés au document source"],
  "tab-quality": ["Contrôle qualité", "Confiances, anomalies et cohérence métier"],
  "tab-config": ["Configuration", "Moteurs, langues et profils réellement disponibles"],
  "tab-dashboard": ["Tableau de bord", "Activité et ressources système"],
  "tab-review": ["Révision humaine", "Vérification et correction avant toute transmission"],
  "tab-profiles": ["Profils métier", "Champs, motifs et validateurs réutilisables"],
  "tab-connectors": ["Connecteur Hub", "Transmission vers les systèmes externes, sous contrôle humain"],
  "tab-dossier": ["Parcours documentaire", "Dossier, cohérence entre documents et paquet de données"],
};

/* =================== NAVIGATION =================== */
document.querySelectorAll(".nav-item").forEach(btn => {
  btn.addEventListener("click", () => {
    document.querySelectorAll(".nav-item").forEach(b => {
      b.classList.remove("active");
      b.removeAttribute("aria-current");
    });
    btn.classList.add("active");
    btn.setAttribute("aria-current", "page");
    const tab = btn.dataset.tab;
    document.querySelectorAll("section.page").forEach(s => {
      s.classList.add("hidden"); s.classList.remove("page-enter");
    });
    const el = document.getElementById(tab);
    el.classList.remove("hidden");
    void el.offsetWidth; // relance l'animation
    el.classList.add("page-enter");
    const meta = PAGE_META[tab];
    document.getElementById("pageTitle").textContent = meta[0];
    document.getElementById("pageSub").textContent = meta[1];
    if (tab === "tab-docs") loadJobs();
    if (tab === "tab-dashboard") loadStats();
    if (tab === "tab-config") loadConfig();
    if (tab === "tab-connectors") CnxHub.loadAll();
    if (tab === "tab-dossier") DossierUI.loadAll();
  });
});

/* =================== TOASTS =================== */
function toast(msg, type = "info") {
  const box = document.getElementById("toasts");
  const t = document.createElement("div");
  t.className = "toast " + type;
  const icons = { success: "✓", error: "✕", info: "ℹ" };
  t.innerHTML = `<div class="ic">${icons[type] || "ℹ"}</div><div>${esc(msg)}</div>`;
  box.appendChild(t);
  setTimeout(() => { t.classList.add("hide"); setTimeout(() => t.remove(), 380); }, 4200);
}

/* =================== SOURIS / FLOU CARTES =================== */
document.addEventListener("mousemove", e => {
  const card = e.target.closest?.(".card, .drop");
  if (!card) return;
  const r = card.getBoundingClientRect();
  card.style.setProperty("--mx", (e.clientX - r.left) + "px");
  card.style.setProperty("--my", (e.clientY - r.top) + "px");
});

/* =================== HORLOGE =================== */
setInterval(() => {
  const n = new Date();
  document.getElementById("clockChip").textContent =
    n.toLocaleDateString("fr-FR", { day: "2-digit", month: "short" }) + " · " +
    n.toLocaleTimeString("fr-FR", { hour: "2-digit", minute: "2-digit" });
}, 1000);

/* =================== LOG =================== */
function log(msg, cls = "") {
  const el = document.getElementById("processLog");
  const t = new Date().toLocaleTimeString("fr-FR");
  el.innerHTML += `\n<span class="lt">[${t}]</span> <span class="${cls}">${esc(msg)}</span>`;
  el.scrollTop = el.scrollHeight;
}

/* =================== UPLOAD =================== */
const drop = document.getElementById("dropZone");
const fileInput = document.getElementById("fileInput");
drop.addEventListener("click", () => fileInput.click());
drop.addEventListener("keydown", event => {
  if (event.key === "Enter" || event.key === " ") {
    event.preventDefault();
    fileInput.click();
  }
});
drop.addEventListener("dragover", e => { e.preventDefault(); drop.classList.add("drag"); });
drop.addEventListener("dragleave", () => drop.classList.remove("drag"));
drop.addEventListener("drop", e => {
  e.preventDefault(); drop.classList.remove("drag");
  if (e.dataTransfer.files.length) { fileInput.files = e.dataTransfer.files; onFile(); }
});
fileInput.addEventListener("change", onFile);

function setFile(file) {
  currentFile = file || null;
  document.getElementById("dropName").textContent = currentFile ? "📎 " + currentFile.name : "";
  document.getElementById("uploadBtn").disabled = !currentFile || !connected;
  document.getElementById("clearBtn").style.display = currentFile ? "" : "none";
  if (currentFile) toast("Fichier prêt : " + currentFile.name, "info");
}

function onFile() { setFile(fileInput.files[0] || null); }

document.getElementById("clearBtn").addEventListener("click", () => {
  currentFile = null; fileInput.value = "";
  document.getElementById("dropName").textContent = "";
  document.getElementById("uploadBtn").disabled = true;
  document.getElementById("clearBtn").style.display = "none";
});

/* =================== CAPTURE CAMÉRA =================== */
const camOverlay = document.getElementById("camOverlay");
const camVideo = document.getElementById("camVideo");
const camCanvas = document.getElementById("camCanvas");
let camStream = null;
let cameraReturnFocus = null;

function closeCamera() {
  if (camStream) { camStream.getTracks().forEach(t => t.stop()); camStream = null; }
  camVideo.srcObject = null;
  camOverlay.style.display = "none";
  camOverlay.setAttribute("aria-hidden", "true");
  if (cameraReturnFocus && cameraReturnFocus.isConnected) cameraReturnFocus.focus();
  cameraReturnFocus = null;
}

async function openCamera() {
  cameraReturnFocus = document.activeElement;
  document.getElementById("camNote").textContent = "";
  camOverlay.style.display = "flex";
  camOverlay.setAttribute("aria-hidden", "false");
  document.getElementById("camMode").focus();
  try {
    if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
      throw new Error("API caméra indisponible dans ce contexte");
    }
    camStream = await navigator.mediaDevices.getUserMedia({
      video: { facingMode: { ideal: "environment" }, width: { ideal: 1280 } }, audio: false });
    camVideo.srcObject = camStream;
  } catch (e) {
    // pas de caméra, permission refusée, ou iframe sans autorisation caméra :
    // repli sur l'entrée fichier native (ouvre l'appareil photo sur mobile)
    closeCamera();
    toast("Caméra indisponible (" + e.message + ") — sélecteur de fichier", "info");
    document.getElementById("cameraInput").click();
  }
}

document.getElementById("cameraBtn").addEventListener("click", openCamera);
document.getElementById("camCancelBtn").addEventListener("click", closeCamera);
camOverlay.addEventListener("click", event => {
  if (event.target === camOverlay) closeCamera();
});
camOverlay.addEventListener("keydown", event => {
  if (event.key === "Escape") {
    event.preventDefault();
    closeCamera();
    return;
  }
  if (event.key !== "Tab") return;
  const focusables = [...camOverlay.querySelectorAll("button:not([disabled]), select:not([disabled]), input:not([disabled]), video[tabindex]")];
  if (!focusables.length) { event.preventDefault(); return; }
  const first = focusables[0], last = focusables[focusables.length - 1];
  if (event.shiftKey && document.activeElement === first) {
    event.preventDefault(); last.focus();
  } else if (!event.shiftKey && document.activeElement === last) {
    event.preventDefault(); first.focus();
  }
});

document.getElementById("camCaptureBtn").addEventListener("click", () => {
  const w = camVideo.videoWidth, h = camVideo.videoHeight;
  if (!w || !h) { toast("Caméra non prête — réessayez", "error"); return; }
  camCanvas.width = w; camCanvas.height = h;
  camCanvas.getContext("2d").drawImage(camVideo, 0, 0, w, h);
  camCanvas.toBlob((blob) => {
    if (!blob) { toast("Capture impossible", "error"); return; }
    const file = new File([blob], "photo_" + Date.now() + ".png", { type: "image/png" });
    applyCamMode();
    setFile(file);
    closeCamera();
    toast("Photo capturée 📸", "success");
  }, "image/png");
});

function applyCamMode() {
  const mode = document.getElementById("camMode").value;
  if (mode === "container" || mode === "vehicle_plate" || mode === "carte_grise") {
    document.getElementById("profileSelect").value = mode;
    syncProfileHint();
  }
}

document.getElementById("cameraInput").addEventListener("change", (e) => {
  const f = e.target.files[0];
  if (f) { applyCamMode(); setFile(f); }
  e.target.value = "";
});

document.getElementById("uploadBtn").addEventListener("click", async () => {
  if (!currentFile) return;
  if (!connected) {
    toast("Serveur injoignable — connectez l'API via le bandeau jaune", "error");
    log("ERREUR : serveur API injoignable (aperçu statique ?) — ouvrez l'URL du serveur live ou collez-la dans le bandeau", "err");
    return;
  }
  const fd = new FormData();
  fd.append("file", currentFile);
  fd.append("profile", document.getElementById("profileSelect").value);
  const langsSel = [...document.querySelectorAll("#langChips .langchip.on")]
    .map(c => c.dataset.lang).join(",");
  const fmtsSel = [...document.querySelectorAll("#fmtChips input:checked")]
    .map(i => i.dataset.fmt).join(",");
  const qmBtn = document.querySelector("#qualitySeg .on");
  fd.append("languages", langsSel);
  fd.append("quality_mode", qmBtn ? qmBtn.dataset.qm : "accurate");
  fd.append("preprocess", document.getElementById("preprocessMode").value !== "off");
  fd.append("preprocess_mode", document.getElementById("preprocessMode").value);
  fd.append("variant_comparison", document.getElementById("variantCmp").checked);
  fd.append("export_formats", fmtsSel || "json,txt");
  fd.append("page_range", document.getElementById("pageRange").value.trim());
  fd.append("render_dpi", document.getElementById("renderDpi").value);
  fd.append("engine", document.getElementById("engineSelect").value);
  fd.append("extract_fields", document.getElementById("exFields").checked);
  fd.append("extract_tables", document.getElementById("exTables").checked);
  fd.append("extract_barcodes", document.getElementById("exBarcodes").checked);
  fd.append("min_confidence_review", (document.getElementById("reviewRange").value / 100).toFixed(2));
  document.getElementById("uploadStatus").textContent = "Envoi en cours…";
  resetPipeline();
  try {
    const r = await fetchAuthenticated("/api/documents", { method: "POST", body: fd });
    if (!r.ok) throw new Error(await readError(r));
    const j = await r.json();
    currentJob = j.job_id;
    document.getElementById("uploadStatus").textContent = "Job " + j.job_id;
    log("Document reçu — « " + j.filename + " »", "ok");
    toast("Analyse lancée 🚀", "success");
    pollJob(j.job_id);
  } catch (e) {
    document.getElementById("uploadStatus").textContent = "Erreur";
    log("ERREUR : " + e.message, "err");
    toast("Échec : " + e.message, "error");
  }
});

function resetPipeline() {
  document.getElementById("progressBar").style.width = "0%";
  document.querySelectorAll("#pipelineSteps .step").forEach(s => s.classList.remove("on", "done", "err"));
}

function setStage(stage, error = false) {
  const stages = ["ingest", "ocr", "tables", "fields", "quality", "done"];
  const idx = stages.indexOf(stage);
  document.querySelectorAll("#pipelineSteps .step").forEach((s, i) => {
    s.classList.remove("on", "done", "err");
    if (idx < 0) return;
    if (i < idx) s.classList.add("done");
    else if (i === idx) s.classList.add(error ? "err" : "on");
  });
}

async function pollJob(id) {
  const tick = async () => {
    let j;
    try { j = await fetchJson("/api/jobs/" + id); }
    catch { return setTimeout(tick, 1200); }
    document.getElementById("progressBar").style.width = Math.round((j.progress || 0) * 100) + "%";
    setStage(j.stage || "", j.status === "error");
    if (j.status === "done") {
      setStage("done");
      log("Traitement terminé avec succès ✓", "ok");
      toast("Analyse terminée ✨", "success");
      loadResult(id); loadJobs();
      return;
    }
    if (j.status === "error") {
      log("Échec : " + (j.error || "inconnu"), "err");
      toast("Traitement en échec", "error");
      return;
    }
    setTimeout(tick, 800);
  };
  tick();
}

/* =================== RESULTAT =================== */
async function loadResult(id) {
  let res;
  try { res = await fetchJson("/api/jobs/" + id + "/result"); }
  catch (e) { toast(e.message, "error"); return; }
  currentResult = res;
  currentPage = 1;
  renderResult();

  const links = document.getElementById("exportLinks");
  const links2 = document.getElementById("exportLinksResult");
  [links, links2].forEach(box => { box.innerHTML = ""; });
  const fmts = [["json", "🧬", "données complètes"], ["txt", "📄", "texte brut"],
                ["csv", "📑", "champs + tableaux"], ["xlsx", "📊", "classeur 5 feuilles"],
                ["xml", "🔮", "intégration tiers"], ["pdf", "📕", "PDF consultable"]];
  fmts.forEach(([f, ic, sub]) => {
    const b = document.createElement("button");
    b.className = "export-item";
    b.style.cursor = "pointer";
    b.innerHTML = `<div class="ic">${ic}</div><div class="fmt">${f.toUpperCase()}</div><div class="sz">${sub}</div>`;
    b.addEventListener("click", () => downloadExport(f));
    links.appendChild(b);
    const b2 = b.cloneNode(true);
    b2.addEventListener("click", () => downloadExport(f));
    links2.appendChild(b2);
  });
}

/* Téléchargement robuste : fetch → Blob → sauvegarde, avec retour visuel */
async function downloadExport(fmt) {
  if (!currentJob) { toast("Aucun document sélectionné", "info"); return; }
  toast("Préparation de l'export " + fmt.toUpperCase() + "…", "info");
  try {
    const r = await fetchAuthenticated("/api/jobs/" + currentJob + "/export/" + fmt);
    if (!r.ok) throw new Error(await readError(r));
    const blob = await r.blob();
    const cd = r.headers.get("content-disposition") || "";
    const m = cd.match(/filename\*?=(?:UTF-8'')?"?([^";]+)"?/i);
    const fname = m ? decodeURIComponent(m[1]) : ("unocr_export." + (fmt === "csv" && blob.type.includes("zip") ? "zip" : fmt));
    const a = document.createElement("a");
    const url = URL.createObjectURL(blob);
    a.href = url;
    a.download = fname;
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 5000);
    log("Export " + fmt.toUpperCase() + " téléchargé (" + Math.round(blob.size / 1024) + " Ko)", "ok");
    toast("Export " + fmt.toUpperCase() + " téléchargé ✓", "success");
  } catch (e) {
    log("ERREUR export " + fmt + " : " + e.message, "err");
    toast("Export " + fmt.toUpperCase() + " impossible : " + e.message, "error");
  }
}

function renderResult() {
  if (!currentResult) return;
  const res = currentResult;
  renderPage();
  document.getElementById("textView").value =
    (res.pages || []).map(p => "───── Page " + p.page_num + " ─────\n" + p.text).join("\n\n");

  // champs
  const ft = document.querySelector("#fieldsTable tbody");
  ft.innerHTML = "";
  Object.entries(res.fields || {}).forEach(([name, f]) => {
    const tr = document.createElement("tr");
    const conf = Math.round((f.confidence || 0) * 100);
    const cls = conf >= 75 ? "hi" : (conf >= 50 ? "md" : "lo");
    tr.innerHTML =
      `<td><b>${esc(f.label || name)}</b><br><span class="mono" style="font-size:10px;color:var(--muted)">${esc(name)}</span></td>` +
      `<td>${f.raw_value ? esc(f.raw_value) : '<span class="muted">non détecté</span>'}</td>` +
      `<td class="muted">${esc(f.normalized_value ?? "—")}</td>` +
      `<td><span class="meter ${cls}"><i style="width:0"></i></span><b style="font-size:11.5px">${conf}%</b></td>` +
      `<td><span class="badge ${esc(f.status)}">${esc(f.status)}</span></td>` +
      `<td><div class="rowflex"><input class="edit" data-field="${esc(name)}" placeholder="valeur confirmée…">` +
      `<button class="btn sm" data-confirm="${esc(name)}">Valider</button></div></td>`;
    // Pas de gestionnaire en ligne : une valeur contrôlée par l'utilisateur
    // (le nom d'un champ de profil) placée dans `onclick="…"` s'exécute
    // après décodage HTML — l'échappement des caractères ne suffit pas.
    // Le nom passe par `dataset` et l'action par `addEventListener`.
    tr.querySelector("[data-confirm]").addEventListener("click", () => {
      confirmField(name);
    });
    tr.addEventListener("click", e => {
      if (e.target.closest("input,button")) return;
      document.querySelectorAll("#fieldsTable tbody tr").forEach(x => x.classList.remove("sel"));
      tr.classList.add("sel");
      highlightField(f);
    });
    ft.appendChild(tr);
    requestAnimationFrame(() => {
      const m = tr.querySelector(".meter i");
      if (m) m.style.width = conf + "%";
    });
  });

  // tableaux
  const tv = document.getElementById("tablesView");
  if (!(res.tables || []).length) {
    tv.innerHTML = '<div class="empty"><div class="big">📊</div>Aucun tableau détecté.</div>';
  } else {
    tv.innerHTML = res.tables.map((t, i) => {
      const matrix = buildMatrix(t);
      return `<div style="margin-bottom:16px">
        <div class="rowflex" style="margin-bottom:8px">
          <span class="badge info">TABLE ${i + 1}</span>
          <span class="pill">page ${t.page_num}</span>
          <span class="pill">${esc(t.method)}</span>
          <span class="pill">${Math.round((t.confidence || 0) * 100)}% conf.</span>
          ${t.multipage ? '<span class="badge validated">multipages</span>' : ""}
        </div>
        <div class="scroll" style="max-height:250px"><table class="tbl">` +
        matrix.map((row, ri) => "<tr>" + row.map(c =>
          ri < (t.header_rows || 1) ? `<th>${esc(c)}</th>` : `<td>${esc(c)}</td>`
        ).join("") + "</tr>").join("") +
        `</table></div></div>`;
    }).join("");
  }

  // codes-barres
  const bv = document.getElementById("barcodesView");
  bv.innerHTML = (res.barcodes || []).length
    ? res.barcodes.map(b => `<div class="anom"><div class="msg"><span class="badge info">${esc(b.format)}</span> <b class="mono">${esc(b.text)}</b></div><div class="pg pill">p.${b.page}</div></div>`).join("")
    : '<div class="empty"><div class="big">🏷️</div>Aucun code détecté.</div>';

  // moteurs
  const ev = document.getElementById("enginesView");
  const runs = (res.pages || []).flatMap(p => p.engine_runs || []);
  const byEngine = {};
  runs.forEach(r => {
    byEngine[r.engine] = byEngine[r.engine] || { conf: [], words: 0, ms: 0 };
    byEngine[r.engine].conf.push(r.mean_confidence);
    byEngine[r.engine].words += r.word_count; byEngine[r.engine].ms += r.duration_ms;
  });
  const names = Object.keys(byEngine);
  if (names.length > 1) {
    ev.innerHTML = names.map(n => {
      const v = byEngine[n];
      const c = Math.round(v.conf.reduce((a, b) => a + b, 0) / v.conf.length * 100);
      return `<div class="engine-row"><span class="stat up"></span><b>${esc(n)}</b>
        <span class="meter hi"><i style="width:${c}%"></i></span>
        <div class="meta">${v.words} mots · ${Math.round(v.ms)} ms</div></div>`;
    }).join("");
  } else {
    ev.innerHTML = '<div class="empty">Comparaison indisponible : un seul moteur OCR actif dans cet environnement.<br>L\'architecture multi-moteurs s\'active dès qu\'EasyOCR/PaddleOCR est installé.</div>';
  }

  // qualité
  const q = res.quality || {};
  setGauge("gaugeEngine", "qEngine", q.mean_engine_confidence);
  setGauge("gaugeGlobal", "qGlobal", q.mean_global_confidence);
  const anoms = q.anomalies || [];
  document.getElementById("qAnom").textContent = anoms.length;
  const errs = anoms.filter(a => a.severity === "error").length;
  const warns = anoms.filter(a => a.severity === "warning").length;
  document.getElementById("qAnomBreak").textContent =
    `${errs} erreur(s) · ${warns} avertissement(s) · ${anoms.length - errs - warns} info(s)`;

  const av = document.getElementById("anomaliesView");
  if (!anoms.length) {
    av.innerHTML = '<div class="empty"><div class="big">✨</div>Aucune anomalie détectée.</div>';
  } else {
    av.innerHTML = anoms.map(a => {
      const sev = a.severity === "error" ? "crit" : (a.severity === "warning" ? "warn" : "info");
      return `<div class="anom"><span class="badge ${sev}">${esc(a.code)}</span>
        <div class="msg">${esc(a.message)}</div>
        ${a.page_num ? `<div class="pg pill">p.${a.page_num}</div>` : ""}</div>`;
    }).join("");
  }
  const disag = q.disagreements || [];
  document.getElementById("disagreementsView").innerHTML = disag.length
    ? disag.map(d => `<div class="anom"><div class="msg mono">${esc(JSON.stringify(d.text_by_engine))}</div><div class="pg badge ${d.resolution === "best_confidence" ? "validated" : "warn"}">${esc(d.resolution)}</div></div>`).join("")
    : '<div class="empty">Aucun désaccord entre moteurs.</div>';
}

function setGauge(gaugeId, labelId, value) {
  const v = Math.round((value || 0) * 100);
  const circ = document.getElementById(gaugeId);
  if (circ) circ.style.strokeDashoffset = String(289 - (289 * v / 100));
  document.getElementById(labelId).textContent = v + "%";
}

function buildMatrix(t) {
  const g = Array.from({ length: t.n_rows }, () => Array(t.n_cols).fill(""));
  (t.cells || []).forEach(c => {
    if (c.row < t.n_rows && c.col < t.n_cols) g[c.row][c.col] = c.text;
  });
  return g;
}

function renderPage() {
  const res = currentResult;
  if (!res || !(res.pages || []).length) return;
  const page = res.pages.find(p => p.page_num === currentPage) || res.pages[0];
  currentPage = page.page_num;
  document.getElementById("pageLabel").textContent =
    `page ${page.page_num} / ${res.pages.length}`;
  const vb = document.getElementById("variantBadge");
  vb.style.display = ""; vb.textContent = "variante : " + (page.variant_selected || "—");
  const lb = document.getElementById("langBadge");
  const langs = (page.detected_languages || []).join(", ");
  if (langs) { lb.style.display = ""; lb.textContent = "🌐 " + langs; } else lb.style.display = "none";

  const viewer = document.getElementById("viewer");
  viewer.innerHTML = "";
  const wrap = document.createElement("div");
  wrap.className = "wrap";
  const img = document.createElement("img");
  img.src = API + "/api/jobs/" + currentJob + "/page/" + page.page_num + "/image";
  img.alt = "page " + page.page_num;
  img.onerror = () => {
    viewer.innerHTML = '<div class="empty" style="margin:14px"><div class="big">📃</div>Page purement numérique — pas d\'image source.<br>Le texte complet est affiché dans le panneau de droite.</div>';
  };
  const svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
  svg.setAttribute("viewBox", `0 0 ${page.width} ${page.height}`);
  svg.id = "overlaySvg";
  wrap.appendChild(img); wrap.appendChild(svg);
  viewer.appendChild(wrap);
  (page.words || []).forEach(w => {
    const r = document.createElementNS("http://www.w3.org/2000/svg", "rect");
    r.setAttribute("x", w.bbox.x0); r.setAttribute("y", w.bbox.y0);
    r.setAttribute("width", w.bbox.x1 - w.bbox.x0);
    r.setAttribute("height", w.bbox.y1 - w.bbox.y0);
    r.setAttribute("class", "zone");
    svg.appendChild(r);
  });
}

function highlightField(f) {
  if (!f || !f.bbox) { toast("Champ sans géométrie localisée", "info"); return; }
  if (f.page_num && f.page_num !== currentPage) {
    currentPage = f.page_num;
    renderPage();
    setTimeout(() => highlightField(f), 350);
    return;
  }
  const svg = document.getElementById("overlaySvg");
  if (!svg) return;
  svg.querySelectorAll("rect").forEach(r => r.classList.remove("hl"));
  const r = document.createElementNS("http://www.w3.org/2000/svg", "rect");
  r.setAttribute("x", f.bbox.x0); r.setAttribute("y", f.bbox.y0);
  r.setAttribute("width", f.bbox.x1 - f.bbox.x0);
  r.setAttribute("height", f.bbox.y1 - f.bbox.y0);
  r.setAttribute("class", "zone hl");
  svg.appendChild(r);
  r.scrollIntoView({ block: "center", behavior: "smooth" });
  toast("Zone localisée sur le document", "info");
}

async function confirmField(name) {
  // On retrouve le champ par parcours du DOM plutôt que par un sélecteur
  // interpolé : un nom de champ contient librement des apostrophes ou des
  // crochets, qui casseraient le sélecteur (et permettraient d'en injecter
  // un autre).
  const input = Array.from(
    document.querySelectorAll("#fieldsTable input.edit[data-field]")
  ).find(el => el.dataset.field === name);
  if (!input || !input.value) { toast("Saisissez une valeur à confirmer", "info"); return; }
  const r = await fetchAuthenticated("/api/jobs/" + currentJob + "/fields/" + encodeURIComponent(name), {
    method: "PATCH", headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ confirmed_value: input.value })
  });
  if (r.ok) {
    log("Champ « " + name + " » confirmé par l'utilisateur (tracé dans l'audit)", "ok");
    toast("Champ confirmé ✓ — valeur d'origine conservée", "success");
    loadResult(currentJob);
  } else toast("Échec de la validation : " + await readError(r), "error");
}

document.getElementById("prevPage").addEventListener("click", () => {
  if (currentPage > 1) { currentPage--; renderPage(); }
});
document.getElementById("nextPage").addEventListener("click", () => {
  if (currentResult && currentPage < currentResult.pages.length) { currentPage++; renderPage(); }
});
document.getElementById("textSearch").addEventListener("input", e => {
  const q = e.target.value;
  const t = document.getElementById("textView");
  if (!q) return;
  const idx = t.value.toLowerCase().indexOf(q.toLowerCase());
  if (idx >= 0) { t.focus(); t.setSelectionRange(idx, idx + q.length); }
});

/* =================== JOBS =================== */
async function loadJobs() {
  let jobs;
  try { jobs = await fetchJson("/api/jobs?limit=100"); }
  catch (e) {
    document.querySelector("#jobsTable tbody").innerHTML = "";
    document.getElementById("jobsEmpty").style.display = "";
    return;
  }
  const q = (document.getElementById("docSearch").value || "").toLowerCase();
  const st = document.getElementById("filterStatus").value;
  const tbody = document.querySelector("#jobsTable tbody");
  tbody.innerHTML = "";
  const filtered = jobs.filter(j =>
    (!q || j.filename.toLowerCase().includes(q)) && (!st || j.status === st));
  document.getElementById("jobsEmpty").style.display = filtered.length ? "none" : "";
  filtered.forEach((j, i) => {
    const tr = document.createElement("tr");
    tr.style.animation = `riseIn .4s ${Math.min(i * 0.04, 0.5)}s both`;
    const d = new Date(j.created_at * 1000).toLocaleString("fr-FR", { dateStyle: "short", timeStyle: "short" });
    tr.innerHTML =
      `<td><b>${esc(j.filename)}</b></td>` +
      `<td><span class="badge ${j.status}">${j.status}</span></td>` +
      `<td><span class="meter ${j.status === "done" ? "hi" : "md"}"><i style="width:${Math.round(j.progress * 100)}%"></i></span></td>` +
      `<td><span class="pill">${esc(j.options?.profile || "")}</span></td>` +
      `<td class="muted" style="font-size:11px">${d}</td>` +
      `<td style="text-align:right;white-space:nowrap">
        <button class="btn ghost sm" data-open-job="${esc(j.id)}">Ouvrir</button>
        <button class="btn ghost sm" data-retry-job="${esc(j.id)}">↻</button>
        <button class="btn ghost sm" data-del-job="${esc(j.id)}">✕</button>
      </td>`;
    // GestionnairesAttachés, jamais `onclick="…"` : l'identifiant du job
    // est inséré dans l'attribut `data-*`, jamais dans du JavaScript.
    tr.querySelector("[data-open-job]").addEventListener("click", () => openJob(j.id));
    tr.querySelector("[data-retry-job]").addEventListener("click", () => retryJob(j.id));
    tr.querySelector("[data-del-job]").addEventListener("click", () => delJob(j.id));
    tbody.appendChild(tr);
  });
}
document.getElementById("docSearch").addEventListener("input", loadJobs);
document.getElementById("filterStatus").addEventListener("change", loadJobs);

function openJob(id) {
  currentJob = id;
  loadResult(id);
  document.querySelector('.nav-item[data-tab="tab-result"]').click();
}
async function retryJob(id) {
  await fetchAuthenticated("/api/jobs/" + id + "/retry", { method: "POST" });
  toast("Job relancé", "info");
  loadJobs();
}
async function delJob(id) {
  if (!confirm("Supprimer ce job et ses artefacts ? (opération journalisée)")) return;
  await fetchAuthenticated("/api/jobs/" + id, { method: "DELETE" });
  toast("Job supprimé (audit enregistré)", "info");
  loadJobs();
}

/* =================== STATS =================== */
/* ─────────────── sauvegarde du magasin (P0) ─────────────── */
function backupOut(html) {
  const box = document.getElementById("backupOut");
  if (box) box.innerHTML = html;
}

async function lancerSauvegarde() {
  backupOut('<div class="card-sub">Sauvegarde en cours…</div>');
  try {
    const r = await api("/api/backups", {
      method: "POST", headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ keep: 5 }),
    });
    backupOut(
      '<div class="card-sub" style="color:var(--ok)">Sauvegarde créée : ' +
      esc(r.chemin.split("/").pop()) + "</div>" +
      '<div class="card-sub">' + r.fichiers + " fichier(s), " +
      Math.round(r.octets / 1024) + " Ko — empreinte " +
      esc(r.empreinte.slice(0, 16)) + "…</div>");
    toast("Sauvegarde créée ✓", "success");
  } catch (e) {
    backupOut('<div class="card-sub" style="color:var(--err)">Échec : ' +
              esc(e.message) + "</div>");
    toast("Sauvegarde impossible : " + e.message, "error");
  }
}

async function listerSauvegardes() {
  backupOut('<div class="card-sub">Lecture des sauvegardes…</div>');
  try {
    const r = await api("/api/backups");
    if (!r.sauvegardes.length) {
      backupOut('<div class="card-sub">Aucune sauvegarde pour l’instant.</div>');
      return;
    }
    let html = '<table class="tbl"><thead><tr><th>Sauvegarde</th>' +
      "<th>Taille</th><th></th></tr></thead><tbody>";
    r.sauvegardes.forEach(s => {
      html += "<tr><td class='mono'>" + esc(s.nom) + "</td><td>" +
        Math.round(s.taille / 1024) + " Ko</td>" +
        '<td><button class="btn sm" data-restore="' + esc(s.chemin) +
        '">Restaurer</button></td></tr>';
    });
    html += "</tbody></table>";
    backupOut(html);
    document.querySelectorAll("[data-restore]").forEach(b => {
      b.addEventListener("click", () => demanderRestauration(b.dataset.restore));
    });
  } catch (e) {
    backupOut('<div class="card-sub" style="color:var(--err)">Échec : ' +
              esc(e.message) + "</div>");
  }
}

function demanderRestauration(chemin) {
  /* Restaurer écrase le magasin : la confirmation doit être explicite et
     rappeler ce qui est perdu, pas un « OK » neutre. */
  const ok = confirm(
    "Restaurer " + chemin.split("/").pop() + " ?\n\n" +
    "Cette opération réécrit le magasin local. Les documents et corrections " +
    "postérieurs à la sauvegarde seront perdus.");
  if (!ok) return;
  const motif = prompt("Motif de la restauration (obligatoire) :");
  if (!motif || !motif.trim()) { toast("Restauration annulée : motif requis.", "info"); return; }
  effectuerRestauration(chemin, motif.trim());
}

async function effectuerRestauration(chemin, motif) {
  backupOut('<div class="card-sub">Restauration en cours…</div>');
  try {
    const r = await api("/api/backups/restore", {
      method: "POST", headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ chemin: chemin, force: true }),
    });
    backupOut('<div class="card-sub" style="color:var(--ok)">Magasin restauré : ' +
              r.fichiers + " fichier(s) réécrits.</div>" +
              '<div class="card-sub">Motif consigné : ' + esc(motif) + "</div>");
    toast("Magasin restauré ✓", "success");
    if (typeof loadStats === "function") loadStats();
  } catch (e) {
    backupOut('<div class="card-sub" style="color:var(--err)">Restauration refusée : ' +
              esc(e.message) + "</div>");
    toast("Restauration impossible : " + e.message, "error");
  }
}

/* câblage des boutons de sauvegarde — posé ici pour rester à côté du code
   qu'il déclenche, et parce que les éléments existent dès le chargement. */
(function brancherSauvegarde() {
  const maintenant = document.getElementById("btnBackupNow");
  const liste = document.getElementById("btnBackupList");
  if (maintenant) maintenant.addEventListener("click", lancerSauvegarde);
  if (liste) liste.addEventListener("click", listerSauvegardes);
})();

async function loadStats() {
  let s;
  try { s = await fetchJson("/api/stats"); }
  catch (e) { return; }
  countUp("stTotal", s.jobs_total || 0);
  countUp("stDone", s.jobs_done || 0);
  countUp("stError", s.jobs_error || 0);
  document.getElementById("stMem").textContent = (s.memory_percent ?? "—") + "%";

  const counts = [s.jobs_processing || 0, s.jobs_processing || 0, s.jobs_done || 0, s.jobs_error || 0];
  const max = Math.max(4, ...counts);
  document.querySelectorAll("#statusChart .b").forEach((b, i) => {
    const vals = [s.jobs_total - s.jobs_done - s.jobs_error - s.jobs_processing, s.jobs_processing, s.jobs_done, s.jobs_error].map(v => Math.max(0, v));
    const v = vals[i];
    b.style.height = Math.max(8, (v / max) * 100) + "%";
    b.querySelector("em").textContent = v;
  });
}

function countUp(id, target) {
  const el = document.getElementById(id);
  const start = parseInt(el.textContent) || 0;
  const t0 = performance.now();
  const dur = 700;
  const step = now => {
    const p = Math.min(1, (now - t0) / dur);
    el.textContent = Math.round(start + (target - start) * (1 - Math.pow(1 - p, 3)));
    if (p < 1) requestAnimationFrame(step);
  };
  requestAnimationFrame(step);
}

/* =================== CONFIG =================== */
/* Repli statique : les 7 profils livrés avec le produit (si serveur injoignable) */
const STATIC_PROFILES = [
  { name: "generic", label: "Profil générique", description: "Dates, contacts, montants, identifiants courants." },
  { name: "invoice", label: "Facture", description: "Numéro, dates, TVA, totaux HT/TTC, devise." },
  { name: "port_bl", label: "Portuaire — Bill of Lading", description: "BL, conteneurs (ISO 6346 vérifiée), navire, ports, marchandises, ETA/ETD, douane." },
  { name: "packing_list", label: "Portuaire — Liste de colisage", description: "Conteneurs, sceaux, colis, poids, volumes, marquage." },
  { name: "container", label: "Photo conteneur (ISO 6346)", description: "Photo d'un conteneur : n° ISO 6346 avec chiffre de contrôle vérifié, type, sceau, plaque du camion." },
  { name: "vehicle_plate", label: "Photo plaque / véhicule", description: "Plaque d'immatriculation (FR, DZ, ES, DE, IT, PT/NL, BE, UK, TR, MA, TN), n° de châssis VIN, marque/modèle." },
  { name: "carte_grise", label: "Carte grise / certificat d'immatriculation", description: "Plaque, VIN, marque, modèle, énergie, date de 1re immatriculation, puissances, PTAC, couleur, titulaire." },
];
let ALL_PROFILES = STATIC_PROFILES.slice();

function fillProfileSelect(profs) {
  ALL_PROFILES = profs && profs.length ? profs : STATIC_PROFILES.slice();
  const photo = ["container", "vehicle_plate", "carte_grise"];
  const groups = [["Générique", p => p.name === "generic"],
                  ["Photo / terrain 📷", p => photo.includes(p.name)],
                  ["Métier", p => p.name !== "generic" && !photo.includes(p.name)
                    && !p.name.startsWith("port") && p.name !== "packing_list"],
                  ["Portuaire 🚢", p => p.name.startsWith("port") || p.name === "packing_list"]];
  const sel = document.getElementById("profileSelect");
  sel.innerHTML = "";
  groups.forEach(([label, pred]) => {
    const list = ALL_PROFILES.filter(pred);
    if (!list.length) return;
    const og = document.createElement("optgroup");
    og.label = label;
    list.forEach(p => {
      const o = document.createElement("option");
      o.value = p.name;
      o.textContent = p.label || p.name;
      og.appendChild(o);
    });
    sel.appendChild(og);
  });
  syncProfileHint();
}

function syncProfileHint() {
  const name = document.getElementById("profileSelect").value;
  const p = ALL_PROFILES.find(x => x.name === name);
  document.getElementById("profileHint").textContent = p ? (p.description || "") : "";
}
document.getElementById("profileSelect").addEventListener("change", syncProfileHint);

function setConnected(ok) {
  connected = ok;
  const chip = document.getElementById("enginesChip");
  const dot = chip.querySelector(".dot");
  const uploadBtn = document.getElementById("uploadBtn");
  if (ok) {
    chip.classList.add("glow");
    dot.style.background = "var(--ok)";
    document.getElementById("offlineBanner").style.display = "none";
    uploadBtn.disabled = !currentFile;
  } else {
    chip.classList.remove("glow");
    dot.style.background = "var(--err)";
    document.getElementById("enginesTxt").textContent = "hors connexion";
    document.getElementById("offlineBanner").style.display = "";
    uploadBtn.disabled = true;
    const inp = document.getElementById("apiBaseInput");
    if (inp && API) inp.value = API;
  }
}

/* Auto-détection : si l'UI tourne dans un aperçu (autre origine), devine l'URL
   de l'API live à partir du nom d'hôte (https://{port}-{sandbox}.e2b.app). */
async function autoProbe() {
  const m = location.hostname.match(/^(?:\d+-)?(.+\.e2b\.app)$/);
  if (!m) return false;
  const cand = "https://8000-" + m[1];
  if (cand === location.origin) return false;
  try {
    const r = await fetch(cand + "/api/health", { signal: AbortSignal.timeout(5000) });
    if (r.ok) {
      API = cand;
      localStorage.setItem("unocr_api", cand);
      toast("API UniOCR détectée : " + cand, "success");
      log("API détectée automatiquement : " + cand, "ok");
      return true;
    }
  } catch (e) { /* inaccessible — on garde le mode aperçu */ }
  return false;
}

/* Connexion manuelle à une URL de serveur (aperçu cross-origin, proxy…) */
document.getElementById("apiBaseBtn").addEventListener("click", async () => {
  const val = (document.getElementById("apiBaseInput").value || "").trim().replace(/\/+$/, "");
  if (!val) { toast("Saisissez l'URL du serveur UniOCR", "info"); return; }
  try {
    const r = await fetch(val + "/api/health", { signal: AbortSignal.timeout(6000) });
    if (!r.ok) throw new Error("HTTP " + r.status);
    localStorage.setItem("unocr_api", val);
    toast("Connecté au serveur " + val + " ✓", "success");
    setTimeout(() => location.reload(), 600);
  } catch (e) {
    toast("Impossible de joindre " + val + " (" + e.message + ")", "error");
  }
});

async function loadConfig() {
  try {
    const [eng, langs, profs] = await Promise.all([
      fetchJson("/api/engines"),
      fetchJson("/api/languages"),
      fetchJson("/api/profiles"),
    ]);
    setConnected(true);
    const actives = eng.filter(e => e.available).map(e => e.name);
    document.getElementById("enginesTxt").textContent = "moteurs actifs : " + actives.join(", ");

    document.getElementById("enginesList").innerHTML = eng.map(e =>
      `<div class="engine-row">
        <span class="stat ${e.available ? "up" : "down"}"></span>
        <b>${esc(e.name)}</b>
        <span class="pill">${esc(e.kind)}</span>
        ${e.available ? '<span class="badge done">actif</span>' : '<span class="badge not_detected">non installé</span>'}
        <div class="meta">${e.available ? esc((e.languages || []).slice(0, 6).join(" ") || "—") : "s'active automatiquement si installé"}</div>
      </div>`).join("");

    document.getElementById("langsView").innerHTML =
      (langs.installed_models || []).map(l => `<span class="pill lang">🌐 ${esc(l)}</span>`).join("") +
      `<div class="muted" style="font-size:11px;margin-top:9px">Seules les langues dont le modèle est installé sont déclarées supportées.</div>`;

    document.getElementById("profilesView").innerHTML = (profs || []).map(p =>
      `<div class="anom"><div class="msg"><b>${esc(p.name)}</b> — ${esc(p.label)}
        <div class="muted" style="margin-top:3px">${esc(p.description)}</div>
        <div style="margin-top:6px">${(p.fields || []).slice(0, 6).map(f => `<span class="pill" style="font-size:10px">${esc(f)}</span>`).join("")}${(p.fields || []).length > 6 ? `<span class="pill" style="font-size:10px">+${p.fields.length - 6}</span>` : ""}</div>
      </div></div>`).join("");

    fillProfileSelect(profs);
  } catch (e) {
    setConnected(false);
    fillProfileSelect(STATIC_PROFILES);
    document.getElementById("enginesList").innerHTML = '<div class="empty">Serveur injoignable — lancez <b class="mono">./scripts/run_server.sh</b>.</div>';
  }
}

/* =================== UTILS =================== */
function esc(s) {
  return String(s ?? "").replace(/[&<>"']/g, c =>
    ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
}

/* =================== OPTIONS (panneau avancé) =================== */
function initOptions() {
  document.getElementById("advToggle").addEventListener("click", () => {
    document.getElementById("advPanel").classList.toggle("open");
  });
  document.querySelectorAll("#qualitySeg button").forEach(b => b.addEventListener("click", () => {
    document.querySelectorAll("#qualitySeg button").forEach(x => x.classList.remove("on"));
    b.classList.add("on");
    document.getElementById("qmHint").textContent = b.dataset.qm === "accurate"
      ? "Accurate compare les variantes et garde la meilleure."
      : "Fast traite chaque page avec un seul passage.";
  }));
  document.querySelectorAll("#fmtChips .langchip").forEach(chip => chip.addEventListener("click", (e) => {
    e.preventDefault();
    const cb = chip.querySelector("input");
    cb.checked = !cb.checked;
    chip.classList.toggle("on", cb.checked);
  }));
  document.getElementById("reviewRange").addEventListener("input", (e) => {
    document.getElementById("reviewVal").textContent = e.target.value + " %";
  });
}

async function initLangChips() {
  const box = document.getElementById("langChips");
  try {
    const data = await api("/api/languages");
    const installed = data.installed_models || [];
    const names = data.catalog || {};
    if (!installed.length) {
      box.innerHTML = '<span class="muted" style="font-size:11px">Aucun modèle de langue détecté — l\'auto-détection sera utilisée.</span>';
      return;
    }
    box.innerHTML = installed.map(code =>
      `<span class="langchip" data-lang="${esc(code)}">${esc(code)}${names[code] ? " · " + esc(names[code]) : ""}<span class="ok">✓</span></span>`
    ).join("");
    box.querySelectorAll(".langchip").forEach(chip => chip.addEventListener("click", () => {
      chip.classList.toggle("on");
    }));
  } catch (e) {
    box.innerHTML = '<span class="muted" style="font-size:11px">API non joignable — connectez l\'API puis rechargez pour choisir les langues.</span>';
  }
}

/* =================== INIT =================== */
(async () => {
  initOptions();
  await loadConfig();
  if (!connected && await autoProbe()) {
    await loadConfig();          // recharge avec l'API détectée
  }
  if (!connected) {
    log("Aucune API jointe — si vous êtes dans l'aperçu du lecteur de fichiers, ouvrez l'URL du serveur live (port 8000) ou collez-la dans le bandeau jaune.", "err");
  }
  await initLangChips();
  try { await loadJobs(); } catch (e) {}
})();


/* ═══════════ EXTRAS ÉDITORIAUX ═══════════
   Ajouts uniquement : aucun code métier ci-dessus n'est modifié.
   - bascule de thème (clair / sombre, préférence système respectée)
   - réduction de la barre latérale
   - recherche globale → filtre réel des documents
   - page d'accueil : données RÉELLES (moteurs, stats, derniers jobs)
   ═══════════════════════════════════════════ */
(function editorialExtras() {
  const root = document.documentElement;
  const saved = localStorage.getItem("unocr_theme");
  const prefersLight = window.matchMedia &&
    window.matchMedia("(prefers-color-scheme: light)").matches;
  if (saved === "light" || saved === "dark") root.setAttribute("data-theme", saved);
  else if (prefersLight) root.setAttribute("data-theme", "light");

  const tt = document.getElementById("themeToggle");
  if (tt) tt.addEventListener("click", () => {
    const next = root.getAttribute("data-theme") === "light" ? "dark" : "light";
    root.setAttribute("data-theme", next);
    localStorage.setItem("unocr_theme", next);
  });

  const app = document.getElementById("app");
  const sc = document.getElementById("sidebarCollapse");
  if (sc && app) sc.addEventListener("click", () => {
    app.classList.toggle("collapsed");
    localStorage.setItem("unocr_sidebar",
      app.classList.contains("collapsed") ? "1" : "0");
  });
  if (app && localStorage.getItem("unocr_sidebar") === "1")
    app.classList.add("collapsed");

  // recherche globale : filtre réel de la liste des documents
  const gs = document.getElementById("globalSearch");
  if (gs) gs.addEventListener("input", () => {
    const ds = document.getElementById("docSearch");
    if (ds) {
      ds.value = gs.value;
      ds.dispatchEvent(new Event("input"));
    }
  });

  // ── page d'accueil : uniquement des données réelles ──
  async function loadHome() {
    const engEl = document.getElementById("homeEngines");
    const stEl = document.getElementById("homeStats");
    const recEl = document.getElementById("homeRecent");
    if (!engEl && !stEl && !recEl) return;
    try {
      const [eng, st, jobs] = await Promise.all([
        api("/api/engines"), api("/api/stats"), api("/api/jobs?limit=5"),
      ]);
      const avail = (eng || []).filter(e => e.available).map(e => e.name);
      if (engEl) engEl.textContent = avail.length
        ? avail.join(" · ")
        : "aucun moteur disponible";
      if (stEl) stEl.textContent =
        (st.jobs_total || 0) + " documents · " + (st.jobs_done || 0) +
        " terminés · mémoire " + (st.memory_percent != null ? st.memory_percent : "—") + " %";
      if (recEl) {
        const list = Array.isArray(jobs) ? jobs.slice(0, 5) : [];
        if (!list.length) {
          recEl.innerHTML = '<div class="empty">Aucun document traité pour l\'instant — l\'historique apparaîtra ici.</div>';
        } else {
          recEl.innerHTML = list.map(j => {
            const d = j.created_at
              ? new Date(j.created_at * 1000).toLocaleString("fr-FR", { dateStyle: "short", timeStyle: "short" })
              : "";
            return '<div class="recent-item" data-open-job="' + esc(j.id) + '" role="button" tabindex="0">' +
              '<span class="badge ' + esc(j.status) + '">' + esc(j.status) + '</span>' +
              '<span class="fn">' + esc(j.filename) + '</span>' +
              '<span class="mono muted" style="font-size:10px">' + d + '</span></div>';
          }).join("");
          // Délégation d'événement : l'identifiant du job reste dans un
          // attribut `data-*`, il n'est jamais interprété comme du code.
          recEl.querySelectorAll("[data-open-job]").forEach(el => {
            el.addEventListener("click", () => openJob(el.dataset.openJob));
            el.addEventListener("keydown", (e) => {
              if (e.key === "Enter" || e.key === " ") {
                e.preventDefault();
                openJob(el.dataset.openJob);
              }
            });
          });
        }
      }
    } catch (e) {
      if (engEl) engEl.textContent = "API non jointe — données indisponibles";
      if (stEl) stEl.textContent = "—";
      if (recEl && !recEl.querySelector(".recent-item"))
        recEl.innerHTML = '<div class="empty">Historique indisponible — API non jointe.</div>';
    }
  }
  loadHome();
  setInterval(loadHome, 20000);
})();
/* ═══════════ RÉVISION, RECHERCHE, RACCOURCIS ═══════════
   Ajouts purs : le code métier ci-dessus n'est pas modifié.
   ═══════════════════════════════════════════════════════ */
(function reviewSearchKeys() {
  const PAGE = "tab-review";

  /* ---- 1. entrée de navigation pour la page Révision ---- */
  const META = window.PAGE_META || (window.PAGE_META = {});
  META[PAGE] = ["À réviser", "File de validation humaine — champs à trancher"];

  /* ---- 2. file de révision ---- */
  let reviewData = [];
  let focusIdx = 0;

  const $ = id => document.getElementById(id);

  async function loadReview() {
    const list = $("reviewList"), count = $("reviewCount"), stats = $("reviewStats");
    if (!list) return;
    const threshold = $("reviewThreshold")?.value || "0.75";
    const undet = $("reviewUndetected")?.checked ? "true" : "false";
    list.innerHTML = '<div class="muted">Chargement de la file…</div>';
    try {
      const d = await api(`/api/review?threshold=${encodeURIComponent(threshold)}` +
        `&include_undetected=${undet}`);
      reviewData = d.items || [];
      focusIdx = 0;
      if (!reviewData.length) {
        list.innerHTML = '<div class="empty">Rien à réviser — tous les champs sont ' +
          'au-dessus du seuil, détectés et valides.</div>';
        count.textContent = "0 champ";
        stats.innerHTML = stat("Documents", 0) + stat("Champs", 0);
        return;
      }
      const nFields = reviewData.reduce((n, i) => n + i.fields.length, 0);
      count.textContent = `${nFields} champ${nFields > 1 ? "s" : ""} · ` +
        `${reviewData.length} document${reviewData.length > 1 ? "s" : ""}`;
      stats.innerHTML = stat("Documents", reviewData.length) + stat("Champs", nFields) +
        stat("Seuil", Math.round(d.threshold * 100) + " %");
      list.innerHTML = reviewData.map((doc, di) => `
        <div class="review-doc">
          <div class="review-doc-head">
            <span class="fn">${esc(doc.filename)}</span>
            ${doc.profile ? `<span class="pill">${esc(doc.profile)}</span>` : ""}
            <span class="meta">${doc.created_at
              ? new Date(doc.created_at * 1000).toLocaleString("fr-FR",
                  { dateStyle: "short", timeStyle: "short" }) : ""}</span>
          </div>
          ${doc.fields.map((f, fi) => reviewRow(doc, f, di, fi)).join("")}
        </div>`).join("");
      markFocus();
    } catch (e) {
      list.innerHTML = '<div class="empty">File indisponible — API non jointe.</div>';
      count.textContent = "—";
    }
  }

  function stat(lbl, val) {
    return `<div class="stat"><span class="big">${val}</span><span class="lbl">${lbl}</span></div>`;
  }

  function reviewRow(doc, f, di, fi) {
    const conf = Math.round((f.confidence || 0) * 100);
    const cls = conf >= 75 ? "hi" : (conf >= 50 ? "md" : "lo");
    return `<div class="review-row" data-di="${di}" data-fi="${fi}" data-job="${esc(doc.job_id)}"
                 data-field="${esc(f.field)}">
      <div>
        <span class="rr-label">${esc(f.label || f.field)}</span>
        <span class="rr-name">${esc(f.field)}</span>
        <div class="rr-reasons">⚠ ${f.reasons.map(esc).join(" · ")}</div>
      </div>
      <div>
        <div class="rr-value">${f.value ? esc(f.value) : '<span class="muted">non détecté</span>'}</div>
        <div class="rr-conf" style="margin-top:5px">
          <span class="meter ${cls}" style="width:64px"><i style="width:${conf}%"></i></span>
          <span>${conf}%</span>
          <span class="badge ${esc(f.status)}">${esc(f.status)}</span>
        </div>
      </div>
      <div class="rr-actions">
        <input class="edit" data-confirm value="${esc(f.value || "")}"
               placeholder="valeur confirmée…" aria-label="Valeur confirmée pour ${esc(f.label || f.field)}">
        <div class="rr-btn-row">
          <button class="btn sm" data-validate>Valider</button>
          <button class="btn ghost sm" data-undo title="Restaurer l'état d'avant correction (U)">Annuler</button>
          <button class="btn ghost sm" data-open>Ouvrir</button>
        </div>
      </div>
    </div>`;
  }

  function markFocus() {
    document.querySelectorAll("#reviewList .review-row").forEach(r => r.classList.remove("focused"));
    const rows = document.querySelectorAll("#reviewList .review-row");
    if (!rows.length) return;
    focusIdx = Math.max(0, Math.min(focusIdx, rows.length - 1));
    rows[focusIdx].classList.add("focused");
    rows[focusIdx].scrollIntoView({ block: "nearest" });
  }

  function rowCourante() {
    return document.querySelectorAll("#reviewList .review-row")[focusIdx] || null;
  }

  /* Annulation d'une correction : l'état d'avant est restitué, la trace reste.
     Le motif est demandé car une annulation est une décision, pas un clic. */
  async function undoRow(row) {
    const job = row.dataset.job, field = row.dataset.field;
    const motif = prompt(`Pourquoi annuler la correction de « ${field} » ?`);
    if (motif === null) return;
    if (!motif.trim()) { toast("Un motif est nécessaire pour tracer l'annulation.", "error"); return; }
    try {
      const r = await api(`/api/jobs/${job}/fields/${field}/undo`, {
        method: "POST", body: JSON.stringify({ motif: motif.trim() }),
      });
      toast(`« ${field} » restauré à « ${r.restaure?.valeur ?? "?"} »`, "success");
      loadReview();
    } catch (e) {
      toast(`Annulation impossible : ${e.message}`, "error");
    }
  }

  async function validateRow(row) {
    const job = row.dataset.job, field = row.dataset.field;
    const input = row.querySelector("[data-confirm]");
    const value = (input?.value || "").trim();
    if (!value) { toast("Saisissez une valeur à confirmer.", "error"); input?.focus(); return; }
    try {
      await api(`/api/jobs/${job}/fields/${field}`, {
        method: "PATCH", body: JSON.stringify({ confirmed_value: value }),
      });
      row.classList.add("done");
      toast(`« ${value} » confirmé pour ${field}`, "success");
      loadReview();
    } catch (e) {
      toast(`Validation impossible : ${e.message}`, "error");
    }
  }

  /* Annulation d'une correction : l'état d'avant est restitué, la trace reste.
     Le motif est demandé car une annulation est une décision, pas un clic. */
  async function undoRow(row) {
    const job = row.dataset.job, field = row.dataset.field;
    const motif = prompt(`Pourquoi annuler la correction de « ${field} » ?`);
    if (motif === null) return;
    if (!motif.trim()) { toast("Un motif est nécessaire pour tracer l'annulation.", "error"); return; }
    try {
      const r = await api(`/api/jobs/${job}/fields/${field}/undo`, {
        method: "POST", body: JSON.stringify({ motif: motif.trim() }),
      });
      toast(`« ${field} » restauré à « ${r.restaure?.valeur ?? "?"} »`, "success");
      loadReview();
    } catch (e) {
      toast(`Annulation impossible : ${e.message}`, "error");
    }
  }

  document.addEventListener("click", e => {
    const row = e.target.closest?.("#reviewList .review-row");
    if (row) {
      focusIdx = Array.from(document.querySelectorAll("#reviewList .review-row")).indexOf(row);
      markFocus();
    }
    const v = e.target.closest?.("[data-validate]");
    if (v) { const r = v.closest(".review-row"); validateRow(r); return; }
    const u = e.target.closest?.("[data-undo]");
    if (u) { const r = u.closest(".review-row"); undoRow(r); return; }
    const o = e.target.closest?.("[data-open]");
    if (o) { openJob(o.closest(".review-row").dataset.job); return; }
  });

  $("reviewRefresh")?.addEventListener("click", loadReview);
  $("reviewThreshold")?.addEventListener("change", loadReview);
  $("reviewUndetected")?.addEventListener("change", loadReview);

  /* ─── identité et droits ───
     Au démarrage, on demande à l'API qui nous sommes. Si data/rbac.json est
     actif et qu'aucun jeton valide n'est fourni, la modale s'ouvre — plutôt
     que de découvrir un 401 au premier clic. */
  function demanderJeton() {
    $("jetonVoile")?.classList.remove("hidden");
    $("jetonInput")?.focus();
  }
  function majEnteteJeton() {
    const chip = $("identChip"), txt = $("identTxt");
    if (!chip) return;
    if (!MOI || !MOI.actif) { chip.classList.add("hidden"); return; }
    chip.classList.remove("hidden");
    txt.textContent = MOI.nom + " · " + (MOI.roles || []).join(", ");
    chip.title = "Rôles : " + (MOI.roles || []).join(", ") +
      " — périmètre : " + (MOI.dossiers || []).join(", ");
  }
  async function chargeIdentite() {
    try {
      MOI = await api("/api/rbac/moi");
    } catch (e) { MOI = { actif: false }; }
    majEnteteJeton();
    if (MOI.actif && !MOI.nom) demanderJeton();
  }
  $("jetonBtn")?.addEventListener("click", () => {
    definirJeton($("jetonInput")?.value);
    chargeIdentite().then(() => { $("jetonVoile")?.classList.add("hidden"); });
  });
  $("jetonInput")?.addEventListener("keydown", e => {
    if (e.key === "Enter") $("jetonBtn")?.click();
  });
  chargeIdentite();

  /* ---- 3. recherche plein texte inter-documents ---- */
  const gs = $("globalSearch"), sr = $("searchResults");
  let searchTimer = null;

  function closeSearch() {
    sr?.classList.add("hidden");
    gs?.setAttribute("aria-expanded", "false");
  }

  function highlight(text, q) {
    const i = text.toLowerCase().indexOf(q.toLowerCase());
    if (i < 0) return esc(text);
    return esc(text.slice(0, i)) + "<mark>" + esc(text.slice(i, i + q.length)) +
      "</mark>" + esc(text.slice(i + q.length));
  }

  async function runSearch() {
    const q = (gs.value || "").trim();
    if (q.length < 2) { closeSearch(); return; }
    sr.classList.remove("hidden");
    gs.setAttribute("aria-expanded", "true");
    sr.innerHTML = '<div class="sr-head">Recherche…</div>';
    try {
      const d = await api(`/api/search?q=${encodeURIComponent(q)}&limit=20`);
      if (!d.hits.length) {
        sr.innerHTML = '<div class="sr-head">Aucun résultat</div>' +
          '<div class="sr-item muted">Aucun document ne contient « ' + esc(q) + ' ».</div>';
        return;
      }
      const seen = new Set();
      const head = `<div class="sr-head">${d.returned} résultat${d.returned > 1 ? "s" : ""}` +
        `${d.truncated ? " (tronqué)" : ""}</div>`;
      sr.innerHTML = head + d.hits.map(h => {
        const key = h.job_id + "|" + h.kind + "|" + (h.field || h.page || "") + "|" +
          (h.value || h.snippet || "");
        if (seen.has(key)) return "";
        seen.add(key);
        const label = h.kind === "field"
          ? `Champ « ${esc(h.label || h.field)} »`
          : `Page ${h.page ?? "?"} · texte`;
        const detail = h.kind === "field" ? esc(h.value || "—") : highlight(h.snippet || "", q);
        return `<button class="sr-item" data-job="${esc(h.job_id)}" role="option">
          <span class="sr-file">${esc(h.filename)}</span>
          <span class="sr-meta">${label}${h.status ? ` · <span class="badge ${esc(h.status)}">${esc(h.status)}</span>` : ""}</span>
          <span class="sr-snip">${detail}</span>
        </button>`;
      }).join("");
    } catch (e) {
      sr.innerHTML = '<div class="sr-head">Recherche indisponible</div>' +
        '<div class="sr-item muted">API non jointe.</div>';
    }
  }

  gs?.addEventListener("input", () => {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(runSearch, 220);
  });
  sr?.addEventListener("click", e => {
    const b = e.target.closest("[data-job]");
    if (!b) return;
    closeSearch();
    openJob(b.dataset.job);
  });
  document.addEventListener("click", e => {
    if (!e.target.closest?.(".top-search")) closeSearch();
  });

  /* ---- 4. raccourcis clavier ---- */
  const TABS = ["tab-import", "tab-docs", "tab-result", "tab-review",
                "tab-quality", "tab-config", "tab-dashboard"];
  let gPending = false, gTimer = null;

  function typing(el) {
    return el && (el.tagName === "INPUT" || el.tagName === "TEXTAREA" ||
      el.tagName === "SELECT" || el.isContentEditable);
  }
  function gotoTab(tab) {
    document.querySelector(`.nav-item[data-tab="${tab}"]`)?.click();
  }
  function currentTab() {
    const active = document.querySelector(".nav-item.active");
    return active ? active.dataset.tab : "tab-import";
  }

  document.addEventListener("keydown", e => {
    if (typing(e.target)) {
      if (e.key === "Escape") { e.target.blur(); closeSearch(); }
      return;
    }
    if (e.metaKey || e.ctrlKey || e.altKey) return;

    const onReview = currentTab() === PAGE;
    const k = e.key;

    if (k === "Escape") {
      closeSearch();
      $("helpOverlay")?.classList.add("hidden");
      return;
    }
    if (k === "/") {
      e.preventDefault(); gs?.focus(); gs?.select(); return;
    }
    if (k === "?") {
      e.preventDefault();
      const h = $("helpOverlay");
      h?.classList.remove("hidden");
      $("helpClose")?.focus();
      return;
    }
    if (k === "t") {
      $("themeToggle")?.click(); return;
    }
    if (onReview) {
      const rows = document.querySelectorAll("#reviewList .review-row");
      if (k === "j" || k === "ArrowDown") {
        e.preventDefault(); focusIdx = Math.min(focusIdx + 1, rows.length - 1); markFocus(); return;
      }
      if (k === "k" || k === "ArrowUp") {
        e.preventDefault(); focusIdx = Math.max(focusIdx - 1, 0); markFocus(); return;
      }
      if (k === "Enter") {
        const row = rows[focusIdx];
        if (row) { e.preventDefault(); validateRow(row); }
        return;
      }
      if (k === "o") {
        const row = rows[focusIdx];
        if (row) openJob(row.dataset.job);
        return;
      }
      /* « u » annule la correction de la ligne focalisée. Le motif est
         demandé par undoRow : une annulation non motivée serait une trace
         d'audit inexpliquée. */
      if (k === "u" || k === "U") {
        const row = rows[focusIdx];
        if (row) { e.preventDefault(); undoRow(row); }
        return;
      }
    }
    if (k === "g") { gPending = true; clearTimeout(gTimer);
      gTimer = setTimeout(() => { gPending = false; }, 900); return; }
    if (gPending && /^[1-7]$/.test(k)) {
      gPending = false;
      gotoTab(TABS[Number(k) - 1]);
      return;
    }
    gPending = false;
  });

  $("helpClose")?.addEventListener("click", () => $("helpOverlay")?.classList.add("hidden"));
  $("helpOverlay")?.addEventListener("click", e => {
    if (e.target.id === "helpOverlay") e.target.classList.add("hidden");
  });
})();
/* ═══════════ LOTS · AUDIT · SÉLECTION ═══════════
   Ajouts purs : aucun code métier ci-dessus n'est modifié.
   ══════════════════════════════════════════════ */
(function batchAuditSelection() {
  const $ = id => document.getElementById(id);
  const fmtSize = n => n < 1024 ? n + " o" : (n < 1048576
    ? (n / 1024).toFixed(0) + " Ko" : (n / 1048576).toFixed(1) + " Mo");

  /* ═════════ 1. traitement par lots ═════════ */
  const input = $("batchInput");
  let chosen = [];   // {file, name, size}

  function renderFiles() {
    const box = $("batchFiles");
    $("batchCount").textContent = chosen.length
      ? chosen.length + (chosen.length > 1 ? " fichiers" : " fichier")
      : "aucun fichier";
    $("batchRun").disabled = !chosen.length;
    $("batchClear").disabled = !chosen.length;
    box.innerHTML = chosen.map((f, i) =>
      `<div class="batch-file"><span class="bf-name">${esc(f.name)}</span>` +
      `<span class="bf-size">${fmtSize(f.size)}</span>` +
      `<button class="bf-rm" data-i="${i}" title="Retirer" aria-label="Retirer">✕</button></div>`
    ).join("");
  }

  $("batchPick")?.addEventListener("click", () => input?.click());
  input?.addEventListener("change", () => {
    for (const f of (input.files || [])) chosen.push({ file: f, name: f.name, size: f.size });
    input.value = "";
    renderFiles();
  });
  $("batchClear")?.addEventListener("click", () => { chosen = []; renderFiles(); });
  $("batchFiles")?.addEventListener("click", e => {
    const b = e.target.closest("[data-i]");
    if (!b) return;
    chosen.splice(Number(b.dataset.i), 1);
    renderFiles();
  });

  $("batchRun")?.addEventListener("click", async () => {
    if (!chosen.length) return;
    const btn = $("batchRun");
    btn.disabled = true;
    $("batchStatus").textContent = "envoi de " + chosen.length + " fichier(s)…";
    $("batchResult").innerHTML = "";
    try {
      const fd = new FormData();
      for (const c of chosen) fd.append("files", c.file, c.name);
      // les réglages courants de l'onglet Import sont réutilisés tels quels
      const prof = $("profileSelect")?.value || "generic";
      fd.append("profile", prof);
      fd.append("quality_mode",
        document.querySelector("#qualitySeg .on")?.dataset.mode || "accurate");
      const fmts = Array.from(
        document.querySelectorAll('#fmtChips input[data-fmt]'))
        .filter(i => i.checked).map(i => i.dataset.fmt).join(",");
      fd.append("export_formats", fmts || "json,txt");

      const d = await fetchJson("/api/batches", { method: "POST", body: fd });
      $("batchStatus").textContent = d.accepted + " accepté(s), " +
        d.rejected.length + " refusé(s)";

      // suivi de la progression réelle
      const ids = d.jobs.map(j => j.job_id);
      let done = 0;
      const poll = setInterval(async () => {
        done = 0;
        for (const j of d.jobs) {
          try {
            const st = (await fetchJson("/api/jobs/" + j.job_id)).status;
            if (st === "done" || st === "error") done++;
          } catch { /* job encore en vol */ }
        }
        $("batchStatus").textContent = `${done}/${ids.length} terminé(s)`;
        if (done >= ids.length) {
          clearInterval(poll);
          renderBatch(d);
        }
      }, 1200);

      if (!ids.length) renderBatch(d);
    } catch (e) {
      $("batchStatus").textContent = "";
      toast("Lot impossible : " + e.message, "error");
      btn.disabled = false;
    }
  });

  function renderBatch(d) {
    $("batchRun").disabled = !chosen.length;
    const rows = d.jobs.map(j =>
      `<div class="batch-row"><span class="br-file">${esc(j.filename)}</span>` +
      `<span class="badge ${esc(j.status)}">${esc(j.status)}</span>` +
      `${j.cached ? '<span class="pill">réutilisé</span>' : ""}` +
      `<button class="btn ghost sm" data-open="${esc(j.job_id)}">Ouvrir</button></div>`
    ).join("");
    const rej = d.rejected.length
      ? `<div class="batch-summary" style="border-color:var(--warn)">⚠ ${d.rejected.length} fichier(s) refusé(s) : ` +
        d.rejected.map(r => esc(r.filename)).join(", ") + "</div>"
      : "";
    const ok = d.jobs.filter(j => j.status === "done").map(j => j.job_id);
    const exp = ok.length ? `
      <div class="batch-export">
        <span class="muted mono" style="font-size:10.5px;align-self:center">Export groupé :</span>
        ${["csv", "xlsx", "json", "txt"].map(f =>
          `<button class="btn ghost sm" data-bexp="${f}">${f.toUpperCase()}</button>`).join("")}
      </div>` : "";
    $("batchResult").innerHTML =
      `<div class="batch-summary"><span><span class="bs-n">${d.jobs.length}</span>document(s)</span>` +
      `<span><span class="bs-n">${ok.length}</span>terminé(s)</span>` +
      `<span><span class="bs-n">${d.rejected.length}</span>refusé(s)</span></div>` +
      rej + `<div class="panel panel-flush" style="padding:0">${rows}</div>` + exp;
  }

  $("batchResult")?.addEventListener("click", async e => {
    const o = e.target.closest("[data-open]");
    if (o) { openJob(o.dataset.open); return; }
    const x = e.target.closest("[data-bexp]");
    if (!x) return;
    const ids = Array.from(
      $("batchResult").querySelectorAll("[data-open]")).map(b => b.dataset.open);
    if (!ids.length) return;
    const fmt = x.dataset.bexp;
    toast("Préparation de l'export groupé " + fmt.toUpperCase() + "…", "info");
    try {
      const r = await fetchAuthenticated("/api/batches/export/" + fmt + "?ids=" +
        encodeURIComponent(ids.join(",")));
      if (!r.ok) throw new Error(await readError(r));
      const blob = await r.blob();
      const a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = "unocr_lot." + fmt;
      document.body.appendChild(a); a.click(); a.remove();
      setTimeout(() => URL.revokeObjectURL(a.href), 5000);
      toast("Export groupé téléchargé ✓", "success");
    } catch (err) {
      toast("Export groupé impossible : " + err.message, "error");
    }
  });

  /* ═════════ 2. journal d'audit filtrable ═════════ */
  async function loadAudit() {
    const box = $("auditLog");
    if (!box) return;
    const ev = $("auditEvent")?.value || "";
    const q = $("auditQuery")?.value.trim() || "";
    const params = new URLSearchParams({ limit: "300" });
    if (ev) params.set("event", ev);
    if (q) params.set("q", q);
    box.innerHTML = '<div class="muted">Chargement du journal…</div>';
    try {
      const d = await fetchJson("/api/audit?" + params.toString());
      const sel = $("auditEvent");
      if (sel && sel.options.length <= 1) {
        for (const name of d.events) {
          const o = document.createElement("option");
          o.value = name; o.textContent = name;
          sel.appendChild(o);
        }
      }
      if (!d.entries.length) {
        box.innerHTML = '<div class="muted">Aucun événement pour ce filtre.</div>';
        return;
      }
      box.innerHTML = d.entries.map(e => {
        const ts = new Date(e.ts * 1000)
          .toLocaleString("fr-FR", { dateStyle: "short", timeStyle: "medium" });
        const { ts: _t, event, ...rest } = e;
        const det = Object.entries(rest)
          .map(([k, v]) => `${k}=${typeof v === "object" ? JSON.stringify(v) : v}`)
          .join(" ");
        return `<div class="audit-entry"><span class="ae-ts">${ts}</span>` +
          `<span class="ae-ev">${esc(event)}</span>` +
          `<span class="ae-det">${esc(det)}</span></div>`;
      }).join("");
    } catch (err) {
      box.innerHTML = '<div class="muted">Journal indisponible — API non jointe.</div>';
    }
  }
  $("auditRefresh")?.addEventListener("click", loadAudit);
  $("auditEvent")?.addEventListener("change", loadAudit);
  let auditTimer = null;
  $("auditQuery")?.addEventListener("input", () => {
    clearTimeout(auditTimer);
    auditTimer = setTimeout(loadAudit, 250);
  });
  // chargé quand on affiche le tableau de bord
  document.querySelector('.nav-item[data-tab="tab-dashboard"]')
    ?.addEventListener("click", () => setTimeout(loadAudit, 60));

  /* ═════════ 3. sélection de champs → export ciblé ═════════ */
  const tbody = document.querySelector("#fieldsTable tbody");
  if (tbody && window.MutationObserver) {
    new MutationObserver(() => {
      for (const tr of tbody.querySelectorAll("tr")) {
        if (tr.querySelector(":scope > td.sel-cell")) continue;
        const td = document.createElement("td");
        td.className = "sel-cell";
        td.innerHTML = '<input type="checkbox" class="sel-cb" aria-label="Sélectionner ce champ">';
        tr.insertBefore(td, tr.firstChild);
      }
      syncSel();
    }).observe(tbody, { childList: true });
  }

  function selected() {
    return Array.from(document.querySelectorAll("#fieldsTable .sel-cb"))
      .filter(cb => cb.checked)
      .map(cb => cb.closest("tr").querySelector(".mono")?.textContent?.trim())
      .filter(Boolean);
  }
  function syncSel() {
    const n = selected().length;
    if ($("selCount")) $("selCount").textContent = n + (n > 1 ? " champs" : " champ");
    if ($("exportSelCsv")) $("exportSelCsv").disabled = !n;
    if ($("exportSelJson")) $("exportSelJson").disabled = !n;
  }
  document.addEventListener("change", e => {
    if (e.target.classList?.contains("sel-cb")) syncSel();
    if (e.target.id === "selAll") {
      const on = e.target.checked;
      document.querySelectorAll("#fieldsTable .sel-cb").forEach(cb => { cb.checked = on; });
      syncSel();
    }
  });
  async function exportSelection(fmt) {
    const names = selected();
    if (!names.length || !currentJob) return;
    toast("Export de " + names.length + " champ(s)…", "info");
    try {
      const r = await fetchAuthenticated(`/api/jobs/${currentJob}/export/${fmt}/selected?fields=` +
        encodeURIComponent(names.join(",")));
      if (!r.ok) throw new Error(await readError(r));
      const blob = await r.blob();
      const a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = "unocr_selection." + fmt;
      document.body.appendChild(a); a.click(); a.remove();
      setTimeout(() => URL.revokeObjectURL(a.href), 5000);
      toast("Sélection exportée ✓", "success");
    } catch (err) {
      toast("Export impossible : " + err.message, "error");
    }
  }
  $("exportSelCsv")?.addEventListener("click", () => exportSelection("csv"));
  $("exportSelJson")?.addEventListener("click", () => exportSelection("json"));
})();

/* ═══════════ ÉDITEUR DE PROFILS ═══════════
   Ajout pur. Les profils utilisateur sont écrits dans data/profiles/ :
   les profils livrés ne sont jamais modifiés.
   ═══════════════════════════════════════ */
(function profileEditor() {
  const $ = id => document.getElementById(id);
  const META = window.PAGE_META || (window.PAGE_META = {});
  META["tab-profiles"] = ["Profils métier", "Champs, motifs et validateurs — avec essai à blanc"];

  let all = [];            // [{name, label, description, fields, source}]
  let current = null;      // profil en cours d'édition
  let catalog = { normalizations: [], validators: [], aux_validators: [] };

  /* ── chargement ── */
  async function loadList() {
    try {
      const [list, cat] = await Promise.all([
        fetchJson("/api/profiles"), fetchJson("/api/profiles/catalog")]);
      catalog = cat;
      all = list;
      const sel = $("profName")?.value;
      $("profList").innerHTML = list.map(p =>
        `<button class="prof-item${current && current.name === p.name ? " on" : ""}" ` +
        `data-name="${esc(p.name)}"><span class="pi-name">${esc(p.label || p.name)}</span>` +
        `<span class="pi-src">${p.name}</span></button>`).join("");
      if (sel) $("profName").value = sel;
    } catch (e) {
      $("profList").innerHTML = '<div class="muted">Profils indisponibles.</div>';
    }
  }

  async function openProfile(name) {
    try {
      const p = await fetchJson("/api/profiles/" + encodeURIComponent(name));
      current = p;
      $("profEmpty").style.display = "none";
      $("profForm").style.display = "";
      $("profSource").textContent = p.source === "user" ? "Utilisateur" : "Livré";
      $("profName").value = p.name;
      $("profLabel").value = p.label || "";
      $("profDesc").value = p.description || "";
      $("profDelete").disabled = p.source !== "user";
      $("profDelete").title = p.source === "user"
        ? "Supprimer ce profil utilisateur"
        : "Profil livré avec le projet — non supprimable";
      renderFields(p.fields || []);
      $("profTestOut").innerHTML = "";
      loadList();
    } catch (e) {
      toast("Profil inaccessible : " + e.message, "error");
    }
  }

  function renderFields(fields) {
    $("profFields").innerHTML = fields.map((f, i) => `
      <div class="prof-field" data-i="${i}">
        <div class="prof-field-head">
          <span class="pf-key">${esc(f.key || "(sans clé)")}</span>
          ${f.required ? '<span class="pill">requis</span>' : ""}
          <button class="pf-rm" data-rm="${i}" title="Retirer ce champ">✕ retirer</button>
        </div>
        <div class="prof-field-grid">
          <div><label class="lb">Clé</label>
            <input class="inp" data-f="key" value="${esc(f.key || "")}" placeholder="invoice_number"></div>
          <div><label class="lb">Libellé</label>
            <input class="inp" data-f="label" value="${esc(f.label || "")}" placeholder="Numéro de facture"></div>
          <div><label class="lb">Normalisation</label>
            <select class="inp" data-f="normalize">
              <option value="">aucune</option>
              ${catalog.normalizations.map(n =>
                `<option value="${esc(n)}"${f.normalize === n ? " selected" : ""}>${esc(n)}</option>`).join("")}
            </select></div>
          <div><label class="lb">Validateurs</label>
            <select class="inp" data-f="validator">
              <option value="">aucun</option>
              ${catalog.validators.map(v =>
                `<option value="${esc(v)}"${(f.validators || [])[0] === v ? " selected" : ""}>${esc(v)}</option>`).join("")}
            </select></div>
        </div>
        <div style="margin-top:10px">
          <label class="lb">Motifs (regex, un par ligne — le groupe 1 est la valeur)</label>
          <textarea class="inp" rows="2" data-f="patterns"
            style="font-family:var(--font-mono);font-size:11px">${esc((f.patterns || []).join("\n"))}</textarea>
        </div>
        <label class="ph-check" style="margin-top:8px">
          <input type="checkbox" data-f="required"${f.required ? " checked" : ""}>
          <span>Champ requis</span>
        </label>
      </div>`).join("");
  }

  function collectFields() {
    return Array.from($("profFields").querySelectorAll(".prof-field")).map(box => {
      const get = k => box.querySelector(`[data-f="${k}"]`);
      const validators = [];
      const v = get("validator")?.value;
      if (v) validators.push(v);
      return {
        key: (get("key")?.value || "").trim(),
        label: get("label")?.value || "",
        patterns: (get("patterns")?.value || "").split("\n")
          .map(x => x.trim()).filter(Boolean),
        normalize: get("normalize")?.value || null,
        validators,
        required: !!get("required")?.checked,
        category: "general",
      };
    }).filter(f => f.key);
  }

  /* ── interactions ── */
  $("profList")?.addEventListener("click", e => {
    const b = e.target.closest("[data-name]");
    if (b) openProfile(b.dataset.name);
  });
  $("profNew")?.addEventListener("click", () => {
    current = { name: "", label: "", description: "", fields: [], source: "user" };
    $("profEmpty").style.display = "none";
    $("profForm").style.display = "";
    $("profSource").textContent = "Nouveau";
    $("profName").value = "";
    $("profLabel").value = "";
    $("profDesc").value = "";
    $("profDelete").disabled = true;
    renderFields([]);
    $("profTestOut").innerHTML = "";
    $("profName").focus();
  });
  $("profAddField")?.addEventListener("click", () => {
    const fields = collectFields();
    fields.push({ key: "", label: "", patterns: [], normalize: null,
                  validators: [], required: false, category: "general" });
    renderFields(fields);
  });
  $("profFields")?.addEventListener("click", e => {
    const rm = e.target.closest("[data-rm]");
    if (!rm) return;
    const fields = collectFields();
    fields.splice(Number(rm.dataset.rm), 1);
    renderFields(fields);
  });

  $("profSave")?.addEventListener("click", async () => {
    const name = ($("profName").value || "").trim();
    if (!name) { toast("Donnez un identifiant au profil.", "error"); return; }
    const body = {
      label: $("profLabel").value || name,
      description: $("profDesc").value || "",
      fields: collectFields(),
    };
    if (!body.fields.length) {
      toast("Un profil sans champ n'extraira rien.", "error");
      return;
    }
    $("profMsg").textContent = "enregistrement…";
    try {
      const r = await fetchJson("/api/profiles/" + encodeURIComponent(name),
        { method: "PUT", body: JSON.stringify(body),
          headers: { "Content-Type": "application/json" } });
      $("profMsg").textContent = `enregistré (${r.fields} champs)` +
        (r.overrides_builtin ? " — remplace un profil livré" : "");
      toast(`Profil « ${name} » enregistré`, "success");
      openProfile(name);
    } catch (e) {
      $("profMsg").textContent = "";
      toast("Enregistrement refusé : " + e.message, "error");
    }
  });

  $("profDelete")?.addEventListener("click", async () => {
    const name = $("profName").value;
    if (!name || !confirm(`Supprimer le profil « ${name} » de data/profiles/ ?`)) return;
    try {
      await fetchJson("/api/profiles/" + encodeURIComponent(name), { method: "DELETE" });
      toast("Profil supprimé", "info");
      current = null;
      $("profForm").style.display = "none";
      $("profEmpty").style.display = "";
      loadList();
    } catch (e) {
      toast("Suppression impossible : " + e.message, "error");
    }
  });

  $("profRunTest")?.addEventListener("click", async () => {
    const body = {
      profile: {
        name: $("profName").value || "essai",
        label: $("profLabel").value || "Essai",
        fields: collectFields(),
      },
      text: $("profTestText").value || "",
      job_id: $("profTestJob").value.trim() || undefined,
    };
    if (!body.profile.fields.length) {
      toast("Ajoutez au moins un champ à essayer.", "error"); return;
    }
    $("profTestOut").innerHTML = '<div class="muted">Essai en cours…</div>';
    try {
      const r = await fetchJson("/api/profiles/test",
        { method: "POST", body: JSON.stringify(body),
          headers: { "Content-Type": "application/json" } });
      const rows = Object.entries(r.fields).map(([k, f]) => {
        const conf = Math.round((f.confidence || 0) * 100);
        return `<div class="prof-test-row">
          <span class="ptr-key">${esc(k)}</span>
          <span class="ptr-val">${f.raw_value ? esc(f.raw_value) : '<span class="muted">non détecté</span>'}</span>
          <span class="badge ${esc(f.status)}">${esc(f.status)}</span>
          <span class="muted mono" style="font-size:10px">${conf}%</span>
        </div>`;
      }).join("");
      $("profTestOut").innerHTML =
        `<div class="prof-test-summary">${r.detected}/${r.total} champ(s) détecté(s)</div>` + rows;
    } catch (e) {
      $("profTestOut").innerHTML =
        '<div class="empty">Essai impossible : ' + esc(e.message) + "</div>";
    }
  });

  document.querySelector('.nav-item[data-tab="tab-profiles"]')
    ?.addEventListener("click", () => { if (!all.length) loadList(); });
})();




</script>
<script>
/* PWA : installe la coquille hors ligne. Silencieux si l'API n'est pas là. */
if ("serviceWorker" in navigator && location.protocol !== "file:") {
  window.addEventListener("load", function () {
    navigator.serviceWorker.register("/sw.js").catch(function () {});
  });
}
</script>
<script>
/* ═══════════════════ i18n de l'interface (C3) ═══════════════════
 * Mécanisme : tout élément portant data-i18n="clé" reçoit la traduction
 * de la langue courante. Un élément sans traduction GARDE son texte
 * existant (repli gracieux) : aucune chaîne n'est jamais effacée.
 * L'arabe bascule aussi document.documentElement.dir = "rtl". */
var I18N = {
  fr: {
    "nav.import": "Importer", "nav.docs": "Documents", "nav.result": "Résultat",
    "nav.quality": "Qualité", "nav.config": "Configuration",
    "nav.dashboard": "Tableau de bord", "nav.review": "Révision",
    "nav.profiles": "Profils", "nav.connectors": "Connecteurs",
    "page.connectors": ["Connecteur Hub", "Transmission vers les systèmes externes, sous contrôle humain"],
    "nav.dossier": "Dossier",
    "page.dossier": ["Parcours documentaire", "Dossier, cohérence entre documents et paquet de données"],
    "h.dossier": "Parcours documentaire",
    "h.dossier.sub": "Regrouper les documents d'un même envoi, les comparer entre eux, puis produire un paquet de données. Chaque état affiché est déduit de faits réels — rien n'est déclaré terminé sans l'avoir été.",
    "page.import": ["Importer un document", "Analyse visuelle et textuelle → données structurées"],
    "page.docs": ["Documents", "Historique des traitements et suivi des jobs"],
    "page.result": ["Résultat d'analyse", "Texte, champs, tableaux — reliés au document source"],
    "page.quality": ["Contrôle qualité", "Confiances, anomalies et cohérence métier"],
    "page.config": ["Configuration", "Moteurs, langues et profils réellement disponibles"],
    "page.dashboard": ["Tableau de bord", "Activité et ressources système"],
    "page.review": ["Révision humaine", "Champs sous le seuil de confiance à valider"],
    "page.profiles": ["Profils d'extraction", "Créer, tester et ajuster vos propres profils"],
    "search.placeholder": "Rechercher un document, un champ, un mot…",
    "lang.label": "Langue de l'interface",
    "h.import": "Importez. Vérifiez. Exportez.",
    "h.docs": "Documents traités", "h.result": "Résultat d'analyse",
    "h.quality": "Contrôle qualité", "h.config": "Configuration réelle",
    "h.dashboard": "Tableau de bord", "h.profiles": "Profils métier", "h.connectors": "Connecteur Hub"
  },
  en: {
    "nav.import": "Import", "nav.docs": "Documents", "nav.result": "Result",
    "nav.quality": "Quality", "nav.config": "Settings",
    "nav.dashboard": "Dashboard", "nav.review": "Review",
    "nav.profiles": "Profiles", "nav.connectors": "Connectors",
    "page.connectors": ["Connector Hub", "Transmission to external systems, under human control"],
    "nav.dossier": "Folder",
    "page.dossier": ["Documentary workflow", "Folder, cross-document consistency and data package"],
    "h.dossier": "Documentary workflow",
    "h.dossier.sub": "Group the documents of one shipment, compare them with each other, then produce a data package. Every state shown is derived from real facts — nothing is reported as done before it actually is.",
    "page.import": ["Import a document", "Visual and textual analysis → structured data"],
    "page.docs": ["Documents", "Processing history and job tracking"],
    "page.result": ["Analysis result", "Text, fields, tables — tied to the source document"],
    "page.quality": ["Quality control", "Confidences, anomalies and business consistency"],
    "page.config": ["Settings", "Engines, languages and actually available profiles"],
    "page.dashboard": ["Dashboard", "Activity and system resources"],
    "page.review": ["Human review", "Fields below the confidence threshold to validate"],
    "page.profiles": ["Extraction profiles", "Create, test and tune your own profiles"],
    "search.placeholder": "Search a document, a field, a word…",
    "lang.label": "Interface language",
    "h.import": "Import. Verify. Export.",
    "h.docs": "Processed documents", "h.result": "Analysis result",
    "h.quality": "Quality control", "h.config": "Real configuration",
    "h.dashboard": "Dashboard", "h.profiles": "Business profiles", "h.connectors": "Connector Hub"
  },
  ar: {
    "nav.import": "استيراد", "nav.docs": "المستندات", "nav.result": "النتيجة",
    "nav.quality": "الجودة", "nav.config": "الإعدادات",
    "nav.dashboard": "لوحة القيادة", "nav.review": "المراجعة",
    "nav.profiles": "الملفات الشخصية", "nav.connectors": "الموصّلات",
    "page.connectors": ["مركز الموصّلات", "الإرسال إلى الأنظمة الخارجية تحت التحقق البشري"],
    "nav.dossier": "الملف",
    "page.dossier": ["مسار المستندات", "الملف واتساق المستندات وحزمة البيانات"],
    "h.dossier": "مسار المستندات",
    "h.dossier.sub": "تجميع مستندات شحنة واحدة ومقارنتها فيما بينها ثم إنتاج حزمة بيانات. كل حالة معروضة مشتقّة من وقائع فعلية — لا شيء يُعلن منتهيًا قبل أن يكون كذلك.",
    "page.import": ["استيراد مستند", "تحليل بصري ونصي ← بيانات منظّمة"],
    "page.docs": ["المستندات", "سجل المعالجة ومتابعة المهام"],
    "page.result": ["نتيجة التحليل", "النص والحقول والجداول — مرتبطة بالمستند الأصلي"],
    "page.quality": ["مراقبة الجودة", "الثقتان (المحرك والنظام) والشذوذ واتساق العمل"],
    "page.config": ["الإعدادات", "المحركات واللغات والملفات المتاحة فعليًا"],
    "page.dashboard": ["لوحة القيادة", "النشاط وموارد النظام"],
    "page.review": ["المراجعة البشرية", "الحقول دون حد الثقة وتحتاج تأكيدًا"],
    "page.profiles": ["ملفات الاستخراج", "أنشئ ملفاتك الخاصة واختبرها واضبطها"],
    "search.placeholder": "ابحث عن مستند أو حقل أو كلمة…",
    "lang.label": "لغة الواجهة",
    "h.import": "استورد. تحقّق. صدّر.",
    "h.docs": "المستندات المعالجة", "h.result": "نتيجة التحليل",
    "h.quality": "مراقبة الجودة", "h.config": "الإعدادات الفعلية",
    "h.dashboard": "لوحة القيادة", "h.profiles": "ملفات العمل", "h.connectors": "مركز الموصّلات"
  }
};
</script>
<script src="/modules/i18n-controls.js"></script>
<script>
/* ═══ CNXHUB:BEGIN — généré par tools/sync_web_module.py depuis web/connectors.js.
   Ne pas modifier cette section à la main : éditer web/connectors.js puis lancer
   « python3 tools/sync_web_module.py ». Le test tests/test_web_module_sync.py
   échoue si les deux copies divergent.                                       */
/* ═══════════════ CONNECTEUR HUB ═══════════════
   Rubrique « Connecteurs » : 12 sous-menus, assistant de création en 9 étapes,
   écran de validation avant transmission. Aucune ressource externe, aucun appel
   réseau non sollicité par l'utilisateur.                                     */
const CnxHub = (() => {
  const $ = id => document.getElementById(id);
  const STATE_LABEL = {
    unconfigured: ["Non configuré", "off"],
    to_test: ["À tester", "warn"],
    connected: ["Connecté", "info"],
    functional: ["Fonctionnel", "ok"],
    degraded: ["Dégradé", "warn"],
    auth_expired: ["Authentification expirée", "err"],
    error: ["Erreur", "err"],
    disabled: ["Désactivé", "off"],
  };
  const SECTIONS = [
    ["overview", "Vue d'ensemble"], ["catalog", "Catalogue"],
    ["active", "Connecteurs actifs"], ["add", "Ajouter"],
    ["config", "Configuration"], ["mapping", "Correspondance des champs"],
    ["forms", "Modèles de formulaires"], ["flow", "Flux d'intégration"],
    ["history", "Historique"], ["errors", "Erreurs et reprises"],
    ["security", "Sécurité"], ["audit", "Journaux d'audit"],
  ];
  const WIZARD = [
    ["organisme", "Organisme", "Quel système doit recevoir vos documents ?"],
    ["mode", "Mode d'intégration", "A — API officielle, B — préremplissage autorisé, C — export assisté."],
    ["acces", "Accès et environnement", "Environnement de test ou production, et niveau d'accès obtenu."],
    ["test", "Test de connexion", "Un test réel détermine l'état du connecteur."],
    ["schema", "Schéma du formulaire", "Champs attendus, obligatoires et formats."],
    ["mapping", "Correspondance", "Règles explicites entre champs extraits et champs cibles."],
    ["essai", "Essai sur document non sensible", "Préremplissage sans transmission."],
    ["validation", "Validation humaine", "Vérification et confirmation avant tout envoi."],
    ["activation", "Activation", "Le connecteur devient utilisable."],
  ];
  let section = "overview", wizardStep = 0, wizard = {};

  /* ─────────────── sous-menus ─────────────── */
  function renderSubnav() {
    $("cnxSubnav").innerHTML = SECTIONS.map(([k, label], i) =>
      `<button class="cnx-sub${k === section ? " on" : ""}" data-cnx="${k}" role="tab">
         <i>${String(i + 1).padStart(2, "0")}</i>${esc(label)}</button>`).join("");
    $("cnxSubnav").querySelectorAll("[data-cnx]").forEach(b =>
      b.addEventListener("click", () => show(b.dataset.cnx)));
  }
  function show(k) {
    section = k;
    document.querySelectorAll(".cnx-sub").forEach(b =>
      b.classList.toggle("on", b.dataset.cnx === k));
    document.querySelectorAll(".cnx-pane").forEach(p =>
      p.classList.toggle("hidden", p.dataset.cnx !== k));
    if (k === "overview") loadOverview();
    if (k === "catalog") loadCatalog();
    if (k === "active") loadActive();
    if (k === "add") renderWizard();
    if (k === "config") loadConfig();
    if (k === "flow") loadModes();
    if (k === "mapping") loadMapping();
    if (k === "forms") loadForms();
    if (k === "history") loadHistory();
    if (k === "errors") loadErrors();
    if (k === "security") loadSecurity();
    if (k === "audit") loadAudit();
  }

  const badge = (text, kind) => `<span class="cnx-badge ${kind || ""}">${esc(text)}</span>`;
  const stateBadge = st => { const [l, k] = STATE_LABEL[st] || [st, "off"]; return badge(l, k); };
  const empty = (msg) => `<div class="cnx-empty">${esc(msg)}</div>`;
  const TX_LABEL = {
    total: "Total", by_status: "Par statut", accepted: "Acceptée",
    pending_confirmation: "Issue à confirmer", rejected: "Rejet métier",
    failed: "Échec technique", sent: "Envoyée", pending: "En attente",
    cancelled: "Annulée", created: "Créée", max_auto_retries: "Reprises auto max",
  };

  /* ─────────────── 01 · vue d'ensemble ─────────────── */
  async function loadOverview() {
    let d;
    try { d = await api("/api/connectors"); } catch (e) { d = null; }
    const sum = d?.summary || {};
    const cards = [
      ["Adaptateurs disponibles", String(sum.adapters ?? "—"),
        "Façons de parler à un type de système. Les ajouter ne connecte à rien."],
      ["Connecteurs configurés", String(sum.configured ?? "—"),
        "Instances réelles, avec leur état et leur dernier test."],
      ["Opérationnels", String(sum.operational ?? "—"),
        "État acquis par un test réel, jamais par un interrupteur."],
      ["Intégrations réelles", String(sum.real_external_adapters ?? "—"),
        "0 ici : aucun accès externe autorisé n'est documenté."],
    ];
    $("cnxOverview").innerHTML =
      cards.map(([t, v, s]) => `<div class="cnx-card">
          <h4>${esc(t)}</h4>
          <div class="mono" style="font-size:26px;color:var(--accent)">${esc(v)}</div>
          <p>${esc(s)}</p></div>`).join("") +
      `<div class="cnx-card" style="grid-column:1/-1">
         <h4>Transmissions</h4>
         <div class="cnx-kv" id="cnxOvTx"></div>
       </div>
       <div class="cnx-card" style="grid-column:1/-1">
         <h4>Ce que cette rubrique ne fait pas</h4>
         <p>Elle ne contacte aucun organisme sans configuration et test explicites,
            ne devine aucun champ d'un système auquel elle n'a pas accès, et ne
            présente jamais le connecteur de démonstration comme une intégration réelle.</p>
       </div>`;
    try {
      const st = await api("/api/connectors/transmissions?limit=5");
      const s = st.stats || {};
      $("cnxOvTx").innerHTML =
        `<dt>Total</dt><dd>${s.total ?? 0}</dd>
         <dt>Acceptées</dt><dd>${s.accepted ?? 0}</dd>
         <dt>En attente de confirmation</dt><dd>${s.pending_confirmation ?? 0}</dd>
         <dt>Rejets métier</dt><dd>${s.rejected ?? 0}</dd>
         <dt>Échecs techniques</dt><dd>${s.failed ?? 0}</dd>
         <dt>Reprises automatiques max</dt><dd>${s.max_auto_retries ?? "—"}</dd>`;
    } catch { $("cnxOvTx").innerHTML = "<dt>Statut</dt><dd>indisponible</dd>"; }
  }

  /* ─────────────── 02 · catalogue ─────────────── */
  async function loadCatalog() {
    let rows = [];
    try { rows = await api("/api/connectors/catalog"); } catch { rows = []; }
    $("cnxCatalog").innerHTML = rows.length ? rows.map(c => `<div class="cnx-card">
        <h4>${esc(c.name || c.connector_id)}
          ${c.is_real_external_system ? badge("SYSTÈME RÉEL", "info") : badge("SIMULÉ", "off")}</h4>
        <p>${esc(c.description || "")}</p>
        <div class="cnx-kv">
          <dt>Identifiant</dt><dd class="mono">${esc(c.connector_id)}</dd>
          <dt>Mode</dt><dd class="mono">${esc(c.mode || "—")}</dd>
          <dt>Système</dt><dd class="mono">${esc(c.system_type || "—")}</dd>
          <dt>Capacités</dt><dd class="mono">${esc((c.capabilities || []).join(", ") || "—")}</dd>
        </div>
        <div class="cnx-acts">
          <button class="btn ghost" data-add="${esc(c.connector_id)}">Configurer…</button>
        </div></div>`).join("") : empty("Aucun adaptateur enregistré.");
    $("cnxCatalog").querySelectorAll("[data-add]").forEach(b =>
      b.addEventListener("click", () => { wizard = { connector_id: b.dataset.add };
        show("add"); }));
  }

  /* ─────────────── 03 · connecteurs configurés ─────────────── */
  async function loadActive() {
    let rows = [];
    try { rows = await api("/api/connectors/configured"); } catch { rows = []; }
    $("cnxActive").innerHTML = rows.length ? rows.map(c => `<div class="cnx-card">
        <h4>${esc(c.name || c.connector_id)} ${stateBadge(c.state)}</h4>
        <div class="cnx-kv">
          <dt>Dernier test</dt><dd>${c.last_test ? esc(c.last_test.detail || "—") + " (" +
            esc(c.last_test.ok ? "succès" : "échec") + ")" : "jamais testé"}</dd>
          <dt>Tests effectués</dt><dd>${c.test_count ?? 0}</dd>
          <dt>Erreurs</dt><dd>${c.error_count ?? 0}</dd>
        </div>
        <div class="cnx-acts">
          <button class="btn ghost" data-tst="${esc(c.connector_id)}">Tester la connexion</button>
          <button class="btn ghost" data-cfg="${esc(c.connector_id)}">Configuration</button>
          <button class="btn ghost" data-sec="${esc(c.connector_id)}">Secrets</button>
          ${c.state === "disabled"
            ? `<button class="btn ghost" data-ena="${esc(c.connector_id)}">Réactiver</button>`
            : `<button class="btn ghost" data-dis="${esc(c.connector_id)}">Désactiver</button>`}
        </div>
        <div class="mono" data-out="${esc(c.connector_id)}"></div>
      </div>`).join("") : empty("Aucun connecteur configuré. Passez par « Ajouter ».");
    const out = id => $(`cnxActive [data-out="${id}"]`);
    $("cnxActive").querySelectorAll("[data-tst]").forEach(b =>
      b.addEventListener("click", async () => {
        const id = b.dataset.tst;
        out(id).textContent = "Test en cours…";
        try {
          const r = await api(`/api/connectors/${encodeURIComponent(id)}/test`, { method: "POST", body: "{}" });
          out(id).innerHTML = `<span class="${r.ok ? "cnx-okbox" : "cnx-errbox"}" style="display:block">
            ${esc(r.detail || "")} · état : ${esc(r.state)} · ${Math.round(r.latency_ms || 0)} ms</span>`;
        } catch (e) { out(id).innerHTML = `<span class="cnx-errbox" style="display:block">${esc(e.message)}</span>`; }
        loadActive(); loadOverview();
      }));
    $("cnxActive").querySelectorAll("[data-cfg]").forEach(b =>
      b.addEventListener("click", () => { cfgTarget = b.dataset.cfg; show("config"); }));
    $("cnxActive").querySelectorAll("[data-sec]").forEach(b =>
      b.addEventListener("click", () => { secTarget = b.dataset.sec; show("security"); }));
    $("cnxActive").querySelectorAll("[data-dis]").forEach(b =>
      b.addEventListener("click", async () => {
        await api(`/api/connectors/${encodeURIComponent(b.dataset.dis)}/disable`, { method: "POST", body: "{}" });
        loadActive(); loadOverview();
      }));
    $("cnxActive").querySelectorAll("[data-ena]").forEach(b =>
      b.addEventListener("click", async () => {
        await api(`/api/connectors/${encodeURIComponent(b.dataset.ena)}/enable`, { method: "POST", body: "{}" });
        loadActive(); loadOverview();
      }));
  }

  /* ─────────────── 04 · assistant en 9 étapes ─────────────── */
  function renderWizard() {
    $("cnxSteps").innerHTML = WIZARD.map(([k, l], i) =>
      `<li class="${i === wizardStep ? "on" : ""}${i < wizardStep ? " done" : ""}">${esc(l)}</li>`).join("");
    const [k, title, help] = WIZARD[wizardStep];
    let body = "";
    if (k === "organisme") {
      body = `<p>${esc(help)}</p>
        <div class="cnx-form">
          <label>Adaptateur
            <select id="wzAdapter">
              <option value="demo_simulated">Simulateur local (démonstration)</option>
              <option value="assisted_export">Export assisté (CSV + correspondance)</option>
            </select></label>
          <label>Nom d'usage<input id="wzName" placeholder="ex. Démonstration interne"></label>
          <label>Note<textarea id="wzNote" rows="2"
            placeholder="À quoi sert ce connecteur ?"></textarea></label>
        </div>`;
    } else if (k === "mode") {
      body = `<p>${esc(help)}</p><div class="cnx-modes">
        <div class="cnx-mode"><h4>Mode A <span class="tag">API</span></h4>
          <p>API officielle. Exige un accès autorisé et documenté — aucun
             connecteur de ce type n'est livré ici.</p></div>
        <div class="cnx-mode"><h4>Mode B <span class="tag">Web</span></h4>
          <p>Préremplissage d'un formulaire autorisé, sans contournement des
             protections du site.</p></div>
        <div class="cnx-mode"><h4>Mode C <span class="tag">Export</span></h4>
          <p>Export structuré à importer manuellement. Le plus contrôlé.</p></div>
      </div>
      <div class="cnx-form" style="margin-top:12px">
        <label>Mode retenu
          <select id="wzMode">
            <option value="api">A — API officielle</option>
            <option value="web_form">B — Préremplissage web autorisé</option>
            <option value="assisted_export" selected>C — Export assisté</option>
            <option value="simulated">Simulation locale (démonstration)</option>
          </select></label>
        <label>Environnement
          <select id="wzEnv"><option value="test">Test</option>
            <option value="production">Production</option></select></label>
      </div>`;
    } else if (k === "acces") {
      body = `<p>${esc(help)}</p>
        <div class="cnx-form">
          <label>Identifiant d'accès (nom du secret, pas sa valeur)
            <input id="wzSecretName" placeholder="ex. api_key"></label>
          <div class="cnx-warnbox">La valeur du secret n'est jamais affichée ni
            stockée en clair : elle est chiffrée (AES-256-GCM) dans le coffre
            local, et seuls ses noms sont visibles.</div>
        </div>`;
    } else if (k === "test") {
      body = `<p>${esc(help)}</p>
        <div class="cnx-warnbox">L'état du connecteur ne change qu'après un test
          réel. Un simple enregistrement laisse le connecteur « à tester ».</div>
        <div class="mono" id="wzTestOut">Aucun test lancé.</div>`;
    } else if (k === "schema") {
      body = `<p>${esc(help)}</p>
        <p>Deux sources : les formulaires déclarés par un connecteur
           (<span class="mono">source=declared</span> ou
           <span class="mono">discovered</span>), et les modèles que vous créez
           dans « Modèles de formulaires ». Sans accès au système cible, aucune
           structure n'est devinée.</p>
        <div id="wzForms"></div>`;
    } else if (k === "mapping") {
      body = `<p>${esc(help)}</p>
        <div class="cnx-warnbox">Le moteur propose des correspondances par
          similarité mais ne les applique jamais seul : chaque règle reste
          explicite, versionnée et traçable.</div>
        <div id="wzMap"></div>`;
    } else if (k === "essai") {
      body = `<p>${esc(help)}</p>
        <div class="cnx-form">
          <label>Identifiant de document traité<input id="wzJob"
            placeholder="ex. job_ab12cd34"></label>
          <label>Formulaire cible<input id="wzForm" placeholder="ex. demo_declaration"></label>
        </div>
        <div id="wzPreview"></div>`;
    } else if (k === "validation") {
      body = `<p>${esc(help)}</p>
        <div class="cnx-warnbox">Rien n'est transmis sans confirmation explicite.
          Les champs obligatoires manquants, les erreurs de format et les
          suggestions non validées bloquent l'envoi.</div>`;
    } else {
      body = `<p>${esc(help)}</p>
        <div class="cnx-okbox">Le connecteur sera créé à l'état « à tester ».
          Lancez ensuite un test réel depuis « Connecteurs actifs » pour le
          rendre opérationnel.</div>`;
    }
    $("cnxWizard").innerHTML =
      `<h4>Étape ${wizardStep + 1}/9 — ${esc(title)}</h4>${body}
       <div class="cnx-wizacts">
         ${wizardStep > 0 ? '<button class="btn ghost" id="wzPrev">← Retour</button>' : ""}
         ${wizardStep < 8 ? '<button class="btn" id="wzNext">Suivant →</button>'
                          : '<button class="btn" id="wzDone">Créer le connecteur</button>'}
         <button class="btn ghost" id="wzCancel">Annuler</button>
       </div>`;
    $("wzPrev")?.addEventListener("click", () => { wizardStep--; renderWizard(); });
    $("wzCancel")?.addEventListener("click", () => show("overview"));
    $("wzNext")?.addEventListener("click", async () => {
      if (wizardStep === 0) {
        wizard.connector_id = $("wzAdapter").value;
        wizard.name = $("wzName").value || $("wzAdapter").value;
        wizard.note = $("wzNote").value || "";
      }
      if (wizardStep === 1) { wizard.mode = $("wzMode").value; wizard.env = $("wzEnv").value; }
      if (wizardStep === 2) wizard.secret_name = $("wzSecretName").value || "";
      // étapes à action : on lance l'action PUIS on avance (sinon le bouton
      // « Suivant » ne faisait pas avancer et l'assistant restait bloqué)
      if (wizardStep === 3) await runWizardTest();
      if (wizardStep === 6) await runWizardPreview();
      wizardStep++; renderWizard();
    });
    $("wzDone")?.addEventListener("click", createFromWizard);
    if (k === "schema") loadWizardForms();
    if (k === "mapping") loadWizardMapping();
  }

  async function runWizardTest() {
    const box = $("wzTestOut");
    if (!wizard.connector_id) {
      box.innerHTML = `<span class="cnx-errbox" style="display:block">
        Revenez à l'étape 1 pour choisir un adaptateur.</span>`;
      return;
    }
    box.textContent = "Test en cours…";
    try {
      const r = await api("/api/connectors/" + encodeURIComponent(wizard.connector_id) + "/test",
                          { method: "POST", body: "{}" });
      wizard.tested = r.ok;
      box.innerHTML = `<span class="${r.ok ? "cnx-okbox" : "cnx-errbox"}" style="display:block">
        ${esc(r.detail || "")} · état obtenu : ${esc(r.state)}</span>`;
    } catch (e) { box.innerHTML = `<span class="cnx-errbox" style="display:block">${esc(e.message)}</span>`; }
  }

  async function loadWizardForms() {
    let rows = [];
    try { rows = (await api("/api/connectors/" +
      encodeURIComponent(wizard.connector_id || "demo_simulated") + "/forms")).forms || []; }
    catch { rows = []; }
    $("wzForms").innerHTML = rows.length
      ? rows.map(f => `<div class="cnx-card">
          <h4>${esc(f.label || f.form_id)} ${badge(f.source || "declared", "info")}</h4>
          <div class="mono">${(f.fields || []).length} champ(s)</div></div>`).join("")
      : empty("Aucun schéma exposé par cet adaptateur.");
  }

  async function loadWizardMapping() {
    let rows = [];
    try { rows = (await api("/api/connectors/forms")).forms || []; } catch { rows = []; }
    $("wzMap").innerHTML = rows.length
      ? `<div class="cnx-table"><table><thead><tr><th>Formulaire</th><th>Champs</th>
           <th>Version</th><th>État</th></tr></thead><tbody>` +
        rows.map(f => `<tr><td>${esc(f.name || f.form_id)}</td><td>${f.fields}</td>
          <td class="mono">v${f.version}</td>
          <td>${f.active ? badge("actif", "ok") : badge("désactivé", "off")}</td></tr>`).join("") +
        "</tbody></table></div>"
      : empty("Aucun modèle de formulaire. Créez-en un dans « Modèles de formulaires ».");
  }

  async function runWizardPreview() {
    const job = $("wzJob").value.trim(), form = $("wzForm").value.trim();
    const box = $("wzPreview");
    if (!job || !form) { box.innerHTML = `<span class="cnx-errbox" style="display:block">
      Renseignez un document traité et un formulaire cible.</span>`; return; }
    box.innerHTML = `<div class="cnx-empty">Préremplissage en cours…</div>`;
    try {
      const r = await api("/api/connectors/preview", { method: "POST", body: JSON.stringify({
        job_id: job, form_id: form, rules: [], risk: "medium" }) });
      const v = r.validation || {};
      box.innerHTML = `<div class="${v.can_transmit ? "cnx-okbox" : "cnx-warnbox"}" style="display:block">
          ${v.can_transmit ? "Aucun blocage." : "Transmission bloquée."} ${esc(v.reason || "")}</div>
        <div class="cnx-table" style="margin-top:10px"><table><thead><tr>
          <th>Champ cible</th><th>Valeur</th><th>Origine</th></tr></thead><tbody>` +
        Object.values(r.values || {}).map(val =>
          `<tr><td>${esc(val.target_field)}</td><td class="mono">${esc(val.value ?? "—")}</td>
           <td>${esc(val.source_field || "—")}${val.transform && val.transform !== "none"
             ? " · " + esc(val.transform) : ""}${val.warning ? " · ⚠ " + esc(val.warning) : ""}</td>
           </tr>`).join("") + "</tbody></table></div>";
    } catch (e) { box.innerHTML = `<span class="cnx-errbox" style="display:block">${esc(e.message)}</span>`; }
  }

  async function createFromWizard() {
    if (!wizard.connector_id) {
      alert("Revenez à l'étape 1 pour choisir un adaptateur.");
      return;
    }
    try {
      await api("/api/connectors/" + encodeURIComponent(wizard.connector_id), {
        method: "POST", body: JSON.stringify({
          settings: { mode: wizard.mode || "simulated", env: wizard.env || "test" },
          note: wizard.note || "" }) });
      if (wizard.secret_name) {
        const val = prompt(`Valeur du secret « ${wizard.secret_name} » (chiffrée localement) :`);
        if (val) await api("/api/connectors/" + encodeURIComponent(wizard.connector_id) +
          "/secrets", { method: "PUT", body: JSON.stringify(
            { key: wizard.secret_name, value: val }) });
      }
      wizardStep = 0; wizard = {};
      show("active"); loadOverview();
    } catch (e) { alert("Création impossible : " + e.message); }
  }

  /* ─────────────── 05 · configuration ─────────────── */
  let cfgTarget = "";
  async function loadConfig() {
    let rows = [];
    try { rows = await api("/api/connectors/configured"); } catch { rows = []; }
    if (!cfgTarget && rows.length) cfgTarget = rows[0].connector_id;
    const cur = rows.find(c => c.connector_id === cfgTarget);
    $("cnxConfig").innerHTML = rows.length ? `
      <div class="cnx-form">
        <label>Connecteur
          <select id="cfSel">${rows.map(c =>
            `<option value="${esc(c.connector_id)}"${c.connector_id === cfgTarget ? " selected" : ""}>` +
            `${esc(c.name || c.connector_id)} — ${esc(c.state)}</option>`).join("")}</select></label>
        <div class="cnx-kv">
          <dt>État</dt><dd>${stateBadge(cur?.state || "unconfigured")}</dd>
          <dt>Dernier test</dt><dd>${cur?.last_test ? esc(cur.last_test.detail || "—") : "jamais testé"}</dd>
          <dt>Environnement</dt><dd class="mono">${esc(cur?.settings?.env || "—")}</dd>
          <dt>Mode</dt><dd class="mono">${esc(cur?.settings?.mode || "—")}</dd>
        </div>
        <label>Note d'usage<textarea id="cfNote" rows="2">${esc(cur?.note || "")}</textarea></label>
        <div class="cnx-wizacts">
          <button class="btn" id="cfSave">Enregistrer</button>
          <button class="btn ghost" id="cfTest">Tester maintenant</button>
          <button class="btn ghost" id="cfDelete">Supprimer</button>
        </div>
        <div class="mono" id="cfOut"></div>
      </div>` : empty("Aucun connecteur configuré.");
    if (!rows.length) return;
    $("cfSel")?.addEventListener("change", e => { cfgTarget = e.target.value; loadConfig(); });
    $("cfSave")?.addEventListener("click", async () => {
      await api("/api/connectors/" + encodeURIComponent(cfgTarget), { method: "POST",
        body: JSON.stringify({ note: $("cfNote").value }) });
      $("cfOut").innerHTML = `<span class="cnx-okbox" style="display:block">Enregistré.</span>`;
      loadActive();
    });
    $("cfTest")?.addEventListener("click", async () => {
      const r = await api(`/api/connectors/${encodeURIComponent(cfgTarget)}/test`,
        { method: "POST", body: "{}" });
      $("cfOut").innerHTML = `<span class="${r.ok ? "cnx-okbox" : "cnx-errbox"}" style="display:block">
        ${esc(r.detail || "")} · état : ${esc(r.state)}</span>`;
      loadConfig(); loadActive();
    });
    $("cfDelete")?.addEventListener("click", async () => {
      if (!confirm("Supprimer ce connecteur et ses secrets ?")) return;
      await api("/api/connectors/" + encodeURIComponent(cfgTarget), { method: "DELETE" });
      cfgTarget = ""; loadConfig(); loadActive();
    });
  }

  /* ─────────────── 06 · correspondance ─────────────── */
  async function loadMapping() {
    let forms = [], jobs = [];
    try {
      const fr = await api("/api/connectors/forms");
      forms = Array.isArray(fr) ? fr : (fr.forms || []);
      const jr = await api("/api/jobs?limit=25");
      jobs = Array.isArray(jr) ? jr : (jr.jobs || jr.items || []);
    } catch { /* hors ligne : on affiche l'explicatif */ }
    $("cnxMapping").innerHTML = `
      <div class="cnx-form">
        <label>Document traité
          <select id="mpJob">${jobs.length ? jobs.map(j =>
            `<option value="${esc(j.job_id)}">${esc(j.filename || j.job_id)}</option>`).join("")
            : '<option value="">— aucun document traité —</option>'}</select></label>
        <label>Formulaire cible
          <select id="mpForm">${forms.length ? forms.map(f =>
            `<option value="${esc(f.form_id)}">${esc(f.name || f.form_id)}</option>`).join("")
            : '<option value="">— aucun modèle —</option>'}</select></label>
        <label>Niveau de risque
          <select id="mpRisk"><option value="low">Faible</option>
            <option value="medium" selected>Moyen</option><option value="high">Élevé</option></select></label>
        <div class="cnx-wizacts">
          <button class="btn" id="mpRun">Préremplir et valider</button>
        </div>
      </div>
      <div id="mpOut" style="margin-top:14px">${empty(
        "Choisissez un document et un formulaire, puis lancez le préremplissage. " +
        "Aucune donnée n'est envoyée à cette étape.")}</div>`;
    $("mpRun")?.addEventListener("click", async () => {
      const out = $("mpOut");
      out.innerHTML = `<div class="cnx-empty">Analyse…</div>`;
      try {
        const r = await api("/api/connectors/preview", { method: "POST", body: JSON.stringify({
          job_id: $("mpJob").value, form_id: $("mpForm").value, rules: [],
          risk: $("mpRisk").value }) });
        const v = r.validation || {};
        out.innerHTML =
          `<div class="${v.can_transmit ? "cnx-okbox" : "cnx-warnbox"}" style="display:block">
             ${v.can_transmit ? "Prêt à transmettre." : "Transmission bloquée."}
             ${esc(v.reason || "")}</div>` +
          `<div class="cnx-table" style="margin-top:12px"><table><thead><tr>
             <th>Champ cible</th><th>Valeur</th><th>Type</th><th>Obligatoire</th>
             <th>Statut</th><th>Provenance</th></tr></thead><tbody>` +
          (r.form.fields || []).map(f => {
            const val = (r.values || {})[f.external_name];
            const st = val?.value ? badge("renseigné", "ok")
                     : f.required ? badge("manquant", "err") : badge("vide", "off");
            return `<tr><td>${esc(f.label || f.external_name)}</td>
              <td class="mono">${esc(val?.value ?? "—")}</td>
              <td class="mono">${esc(f.field_type)}</td>
              <td>${f.required ? "oui" : "non"}</td><td>${st}</td>
              <td class="mono">${esc(val?.source_field || "—")}${
                val?.warning ? " · ⚠ " + esc(val.warning) : ""}</td></tr>`;
          }).join("") + "</tbody></table></div>" +
          ((r.suggestions || []).length
            ? `<div class="cnx-note" style="margin-top:12px"><strong>Suggestions non appliquées</strong>
               (à valider manuellement) : ` +
              r.suggestions.map(s => esc(s.target_field) + " ← " + esc(s.source_field)).join(", ") +
              `</div>`
            : "");
      } catch (e) { out.innerHTML = `<span class="cnx-errbox" style="display:block">${esc(e.message)}</span>`; }
    });
  }

  /* ─────────────── 07 · modèles de formulaires ─────────────── */
  async function loadForms() {
    let rows = [], tpl = [];
    try {
      rows = (await api("/api/connectors/forms")).forms || [];
      tpl = await api("/api/connectors/forms/templates");
    } catch { rows = []; tpl = []; }
    $("cnxForms").innerHTML = `
      <div class="cnx-wizacts" style="margin-bottom:14px">
        ${tpl.map(t => `<button class="btn ghost" data-tpl="${esc(t.form_id)}">
          + ${esc(t.name)} (${t.fields} champs)</button>`).join("")}
        <button class="btn ghost" id="fmReload">Rafraîchir</button>
      </div>
      <div class="cnx-table"><table><thead><tr><th>Formulaire</th><th>Champs</th>
        <th>Obligatoires</th><th>Version</th><th>État</th><th></th></tr></thead><tbody>` +
        (rows.length ? rows.map(f => `<tr>
          <td>${esc(f.name || f.form_id)}</td><td>${f.fields}</td>
          <td>${f.required ?? "—"}</td><td class="mono">v${f.version}</td>
          <td>${f.active ? badge("actif", "ok") : badge("désactivé", "off")}</td>
          <td>${f.active ? `<button class="btn ghost" data-dis="${esc(f.form_id)}">Désactiver</button>` : ""}</td>
        </tr>`).join("") : `<tr><td colspan="6" class="muted">Aucun modèle. Les trames ci-dessus sont des propositions à adapter.</td></tr>`) +
      "</tbody></table></div>" +
      `<div class="cnx-note" style="margin-top:14px">Les trames « Déclaration en douane »
        et « Escale portuaire » sont des <strong>bases de travail</strong>, pas des
        formats officiels : à conformer à la spécification fournie par l'organisme.</div>`;
    $("fmReload")?.addEventListener("click", loadForms);
    $("cnxForms").querySelectorAll("[data-tpl]").forEach(b =>
      b.addEventListener("click", async () => {
        try {
          await api(`/api/connectors/forms/${encodeURIComponent(b.dataset.tpl)}/from-template`,
            { method: "POST", body: "{}" });
        } catch (e) { alert(e.message); }
        loadForms();
      }));
    $("cnxForms").querySelectorAll("[data-dis]").forEach(b =>
      b.addEventListener("click", async () => {
        await api(`/api/connectors/forms/${encodeURIComponent(b.dataset.dis)}/disable`,
          { method: "POST", body: "{}" });
        loadForms();
      }));
  }

  /* ─────────────── 08 · flux d'intégration ─────────────── */
  function loadModes() {
    $("cnxModes").innerHTML = [
      ["A", "API officielle", "info",
       "Dialogue direct avec l'API de l'organisme. Nécessite un accès autorisé, " +
       "documenté, et une clé d'idempotence si l'API la prend en charge. " +
       "Aucun adaptateur de ce type n'est livré ici."],
      ["B", "Préremplissage web autorisé", "warn",
       "Ouvre un formulaire prérempli sur un site qui l'autorise. Aucun " +
       "contournement de CAPTCHA ni de protection anti-automatisation."],
      ["C", "Export structuré assisté", "ok",
       "Produit un CSV anti-injection, un tableau de correspondance et un JSON " +
       "de traçabilité, à importer manuellement. Livré et testé."],
      ["D", "Simulation locale", "off",
       "Simulateur hors ligne pour répéter le parcours complet sans toucher à " +
       "un système réel. Ce n'est pas une intégration réelle."],
    ].map(([tag, title, kind, txt]) => `<div class="cnx-mode">
        <h4>${esc(title)} <span class="tag">${tag}</span></h4>
        <p>${esc(txt)}</p>${badge(tag === "C" ? "disponible" : tag === "D" ? "démonstration" : "à configurer", kind)}
      </div>`).join("");
  }

  /* ─────────────── 09 · historique ─────────────── */
  async function loadHistory() {
    let d = { stats: {}, transmissions: [] };
    try { d = await api("/api/connectors/transmissions?limit=100"); } catch { /* hors ligne */ }
    const TX = { accepted: ["Acceptée", "ok"], pending_confirmation: ["Issue à confirmer", "warn"],
      rejected: ["Rejet métier", "err"], failed: ["Échec technique", "err"],
      sending: ["Envoi…", "info"], cancelled: ["Annulée", "off"], created: ["Créée", "info"] };
    $("cnxHistory").innerHTML = `
      <div class="cnx-grid" style="margin-bottom:14px">
        ${Object.entries(d.stats || {})
          .filter(([k]) => k !== "max_auto_retries")
          .map(([k, v]) => `<div class="cnx-card"><h4>${esc(TX_LABEL[k] || k)}</h4>
            <div class="mono" style="font-size:22px;color:var(--accent)">${
              typeof v === "object" && v !== null
                ? Object.entries(v).map(([sk, sv]) =>
                    `${esc(TX_LABEL[sk] || sk)} : <b>${esc(String(sv))}</b>`).join("<br>")
                : esc(String(v))}</div></div>`).join("")}
      </div>
      <div class="cnx-table"><table><thead><tr><th>Référence</th><th>Connecteur</th>
        <th>Statut</th><th>Tentatives</th><th>Créée</th><th>Erreurs</th></tr></thead><tbody>` +
      ((d.transmissions || []).length ? (d.transmissions).map(t =>
        `<tr><td class="mono">${esc(t.reference || t.transmission_id)}</td>
         <td class="mono">${esc(t.connector_id)}</td>
         <td>${badge(...(TX[t.status] ? TX[t.status] : [t.status, "off"]))}</td>
         <td>${t.attempts ?? 0}</td>
         <td>${t.created_at ? new Date(t.created_at * 1000).toLocaleString("fr-FR") : "—"}</td>
         <td class="mono">${esc((t.errors || []).join(" ; ").slice(0, 90) || "—")}</td></tr>`).join("")
        : `<tr><td colspan="6" class="muted">Aucune transmission enregistrée.</td></tr>`) +
      "</tbody></table></div>";
  }

  /* ─────────────── 10 · erreurs et reprises ─────────────── */
  async function loadErrors() {
    let rows = [];
    try { rows = (await api("/api/connectors/transmissions?limit=100")).transmissions || []; }
    catch { rows = []; }
    const open = rows.filter(t => ["pending_confirmation", "failed", "rejected"].includes(t.status));
    $("cnxErrors").innerHTML = `
      <div class="cnx-warnbox" style="margin-bottom:14px">
        Avant de reprendre une transmission à l'issue inconnue, lancez un
        <strong>rapprochement</strong> : il vérifie si le système cible a déjà
        accepté la demande. Un rejet métier n'est jamais rejoué automatiquement.
      </div>
      <div class="cnx-table"><table><thead><tr><th>Référence</th><th>Statut</th>
        <th>Erreurs</th><th>Actions</th></tr></thead><tbody>` +
      (open.length ? open.map(t => `<tr>
        <td class="mono">${esc(t.reference || t.transmission_id)}</td>
        <td>${badge(t.status === "pending_confirmation" ? "Issue à confirmer"
          : t.status === "rejected" ? "Rejet métier" : "Échec technique",
          t.status === "rejected" ? "err" : "warn")}</td>
        <td class="mono">${esc((t.errors || []).join(" ; ").slice(0, 110) || "—")}</td>
        <td><div class="cnx-wizacts">
          <button class="btn ghost" data-rec="${esc(t.transmission_id)}">Rapprocher</button>
          <button class="btn ghost" data-ret="${esc(t.transmission_id)}">Reprendre</button>
          <button class="btn ghost" data-can="${esc(t.transmission_id)}">Annuler</button>
        </div></td></tr>`).join("")
        : `<tr><td colspan="4" class="muted">Aucune transmission en attente de décision.</td></tr>`) +
      '</tbody></table></div><div class="mono" id="erOut" style="margin-top:12px"></div>';
    const out = $("erOut");
    $("cnxErrors").querySelectorAll("[data-rec]").forEach(b =>
      b.addEventListener("click", async () => {
        try {
          const r = await api(`/api/connectors/transmissions/${encodeURIComponent(b.dataset.rec)}/reconcile`,
            { method: "POST", body: "{}" });
          out.innerHTML = `<span class="cnx-okbox" style="display:block">
            Rapprochement : ${esc(r.status)}${r.reference ? " · " + esc(r.reference) : ""}</span>`;
        } catch (e) { out.innerHTML = `<span class="cnx-errbox" style="display:block">${esc(e.message)}</span>`; }
        loadErrors(); loadHistory();
      }));
    $("cnxErrors").querySelectorAll("[data-ret]").forEach(b =>
      b.addEventListener("click", async () => {
        try {
          const r = await api(`/api/connectors/transmissions/${encodeURIComponent(b.dataset.ret)}/retry`,
            { method: "POST", body: JSON.stringify({ auto: false }) });
          out.innerHTML = `<span class="cnx-okbox" style="display:block">
            Reprise manuelle : ${esc(r.status)}</span>`;
        } catch (e) { out.innerHTML = `<span class="cnx-errbox" style="display:block">${esc(e.message)}</span>`; }
        loadErrors(); loadHistory();
      }));
    $("cnxErrors").querySelectorAll("[data-can]").forEach(b =>
      b.addEventListener("click", async () => {
        await api(`/api/connectors/transmissions/${encodeURIComponent(b.dataset.can)}/cancel`,
          { method: "POST", body: "{}" });
        loadErrors(); loadHistory();
      }));
  }

  /* ─────────────── 11 · sécurité ─────────────── */
  let secTarget = "";
  async function loadSecurity() {
    let status = {}, rows = [];
    try {
      status = await api("/api/connectors/secrets/status");
      rows = await api("/api/connectors/configured");
    } catch { /* hors ligne */ }
    if (!secTarget && rows.length) secTarget = rows[0].connector_id;
    const cur = rows.find(c => c.connector_id === secTarget);
    let keys = [];
    if (secTarget) { try { keys = (await api(
      `/api/connectors/${encodeURIComponent(secTarget)}/secrets`)).keys || []; } catch { keys = []; } }
    $("cnxSecurity").innerHTML = `
      <div class="cnx-cards" style="margin-bottom:16px">
        <div class="cnx-card"><h4>Coffre de secrets</h4>
          <div class="cnx-kv">
            <dt>Chiffrement</dt><dd>${status.encrypted ? badge("actif", "ok") : badge("inactif", "off")}</dd>
            <dt>Algorithme</dt><dd class="mono">${esc(status.algorithm || "—")}</dd>
            <dt>Dérivation</dt><dd class="mono">${esc(status.kdf || "—")}</dd>
            <dt>Clé</dt><dd class="mono">${esc(status.key_length_bits ? status.key_length_bits + " bits" : "—")}</dd>
          </div></div>
        <div class="cnx-card"><h4>Règles appliquées</h4>
          <div class="cnx-check"><input type="checkbox" checked disabled>
            <span>Aucun secret en clair dans le code, les journaux ou les réponses HTTP.</span></div>
          <div class="cnx-check"><input type="checkbox" checked disabled>
            <span>Permissions minimales, séparation test / production.</span></div>
          <div class="cnx-check"><input type="checkbox" checked disabled>
            <span>Aucun contournement de CAPTCHA ni de protection anti-automatisation.</span></div>
          <div class="cnx-check"><input type="checkbox" checked disabled>
            <span>Confirmation humaine explicite avant tout envoi à conséquences.</span></div>
        </div>
      </div>
      ${rows.length ? `<div class="cnx-form">
        <label>Connecteur<select id="scSel">${rows.map(c =>
          `<option value="${esc(c.connector_id)}"${c.connector_id === secTarget ? " selected" : ""}>` +
          `${esc(c.name || c.connector_id)}</option>`).join("")}</select></label>
        <label>Nom du nouveau secret<input id="scKey" placeholder="ex. api_key"></label>
        <label>Valeur<input id="scVal" type="password" placeholder="jamais affichée ensuite"></label>
        <div class="cnx-wizacts">
          <button class="btn" id="scSave">Enregistrer le secret</button>
        </div>
        <div class="cnx-table" style="margin-top:8px"><table><thead><tr>
          <th>Secrets définis (noms seulement)</th><th></th></tr></thead><tbody>` +
          (keys.length ? keys.map(k => `<tr><td class="mono">${esc(k)}</td>
            <td><button class="btn ghost" data-del="${esc(k)}">Supprimer</button></td></tr>`).join("")
            : `<tr><td class="muted" colspan="2">Aucun secret pour ce connecteur.</td></tr>`) +
        `</tbody></table></div>
        <div class="mono" id="scOut"></div>
      </div>` : empty("Aucun connecteur configuré.")}`;
    $("scSel")?.addEventListener("change", e => { secTarget = e.target.value; loadSecurity(); });
    $("scSave")?.addEventListener("click", async () => {
      const k = $("scKey").value.trim(), v = $("scVal").value;
      if (!k || !v) { $("scOut").innerHTML =
        `<span class="cnx-errbox" style="display:block">Nom et valeur requis.</span>`; return; }
      try {
        await api(`/api/connectors/${encodeURIComponent(secTarget)}/secrets`,
          { method: "PUT", body: JSON.stringify({ key: k, value: v }) });
        $("scVal").value = "";
        $("scOut").innerHTML = `<span class="cnx-okbox" style="display:block">
          Secret « ${esc(k)} » chiffré et enregistré.</span>`;
        loadSecurity();
      } catch (e) { $("scOut").innerHTML =
        `<span class="cnx-errbox" style="display:block">${esc(e.message)}</span>`; }
    });
    $("cnxSecurity").querySelectorAll("[data-del]").forEach(b =>
      b.addEventListener("click", async () => {
        await api(`/api/connectors/${encodeURIComponent(secTarget)}/secrets/${encodeURIComponent(b.dataset.del)}`,
          { method: "DELETE" });
        loadSecurity();
      }));
  }

  /* ─────────────── 12 · journaux d'audit ─────────────── */
  async function loadAudit() {
    let rows = [];
    try { rows = (await api("/api/audit?limit=200")).entries || []; } catch { rows = []; }
    // seules les actions du hub : le reste appartient aux autres rubriques
    const list = rows.filter(a =>
      /^(connector|transmission|secret)/.test(a.event || ""));
    $("cnxAudit").innerHTML = list.length
      ? `<div class="cnx-note">Journal en ajout seul : aucune ligne n'est
           modifiée ni reformatée. ${list.length} action(s) du hub affichée(s).</div>
         <div class="cnx-table"><table><thead><tr><th>Horodatage</th><th>Événement</th>
           <th>Détail</th></tr></thead><tbody>` +
          list.map(a => `<tr>
            <td class="mono">${a.ts ? new Date(a.ts * 1000).toLocaleString("fr-FR") : "—"}</td>
            <td class="mono">${esc(a.event || "—")}</td>
            <td>${esc(JSON.stringify(
              Object.fromEntries(Object.entries(a).filter(([k]) => !["ts", "event"].includes(k)))
            ).slice(0, 170))}</td></tr>`).join("") +
        "</tbody></table></div>"
      : empty("Aucune action du hub encore enregistrée dans le journal d'audit.");
  }

  function loadAll() { renderSubnav(); loadModes(); show(section); }

  return { loadAll, show, get section() { return section; } };
})();
/* ═══ CNXHUB:END ═══ */

/* ═══ DOSSIER:BEGIN — généré par tools/sync_web_module.py depuis web/dossier.js.
   Ne pas modifier cette section à la main : éditer web/dossier.js puis lancer
   « python3 tools/sync_web_module.py ». Le test tests/test_web_module_sync.py
   échoue si les deux copies divergent.                                       */
/* ═══ Parcours documentaire — module d'interface (source unique) ═══
   Éditer ce fichier puis lancer « python3 tools/sync_web_module.py » pour
   l'injecter dans web/index.html. La page est un fichier unique hors ligne :
   ce module vit donc *dans* index.html, et les deux copies peuvent diverger.

   Ce que fait ce module : il rend visibles les étapes 4 (classification),
   8 (cohérence interdocumentaire), 11 (dossier documentaire) et 13 (paquet
   de données) du parcours. Aucune donnée n'est inventée : tout ce qui
   s'affiche vient d'un appel API réel, et un constat sans réponse humaine
   reste affiché comme tel.

   Aucune ressource externe : pas de police, pas d'image, pas de CDN.        */

const DossierUI = (function () {
  "use strict";

  /* état local — jamais une source de vérité, seulement ce que l'utilisateur
     regarde. Le serveur reste seul détenteur de l'état des dossiers. */
  let dossierActif = null;
  let profilsDispo = {};
  let etatsDispo = {};
  let occupation = false;   // évite les doubles clics sur les actions

  /* ─────────────────────────── helpers ─────────────────────────── */

  function el(id) { return document.getElementById(id); }

  /* gravité → classe de badge et libellé lisible.
     Les libellés sont ceux du moteur, pas une interprétation. */
  const GRAVITES = {
    information:   { cls: "info",    label: "Information" },
    avertissement: { cls: "warning", label: "Avertissement" },
    anomalie:      { cls: "err",     label: "Anomalie" },
    blocage:       { cls: "err",     label: "Blocage" },
  };

  const ETATS_LISIBLES = {
    en_preparation:    "En préparation",
    traitement_en_cours: "Traitement en cours",
    revision_requise:  "Révision requise",
    incomplet:         "Incomplet",
    en_validation:     "En validation",
    valide:            "Validé",
    pret_a_exporter:   "Prêt à exporter",
    exporte:           "Exporté",
    archive:           "Archivé",
    erreur_traitement: "Erreur de traitement",
  };

  function etatBadge(etat) {
    const classe = {
      valide: "ok", pret_a_exporter: "ok", exporte: "ok", archive: "ok",
      erreur_traitement: "err", revision_requise: "warning",
      incomplet: "warning", traitement_en_cours: "warning",
    }[etat] || "info";
    const label = ETATS_LISIBLES[etat] || etat;
    return '<span class="badge ' + classe + '">' + esc(label) + "</span>";
  }

  function graviteBadge(gravite) {
    const g = GRAVITES[gravite] || { cls: "info", label: gravite };
    return '<span class="badge ' + g.cls + '">' + esc(g.label) + "</span>";
  }

  function octets(n) {
    if (n === null || n === undefined) return "—";
    if (n < 1024) return n + " o.";
    if (n < 1024 * 1024) return (n / 1024).toFixed(1) + " Ko";
    return (n / (1024 * 1024)).toFixed(2) + " Mo";
  }

  function confianceBadge(c) {
    if (c === null || c === undefined) return '<span class="badge info">inconnue</span>';
    const pct = Math.round(c * 100);
    const cls = c >= 0.8 ? "ok" : (c >= 0.6 ? "warning" : "err");
    return '<span class="badge ' + cls + '">' + pct + " %</span>";
  }

  /* ─────────────────────── chargement des données ─────────────────────── */

  async function chargeReferences() {
    try {
      const [profils, types] = await Promise.all([
        api("/api/dossier-profiles"),
        api("/api/document-types"),
      ]);
      profilsDispo = {};
      (profils.profiles || []).forEach(p => { profilsDispo[p.id] = p; });
      etatsDispo = {};
      (profils.states || []).forEach(s => { etatsDispo[s.id] = s.label; });
      remplitSelectProfil(profilsDispo);
      afficheTypes(types);
    } catch (e) {
      toast("Références indisponibles : " + e.message, "error");
    }
  }

  function remplitSelectProfil(profils) {
    const sel = el("dossierProfile");
    if (!sel) return;
    const actuel = sel.value;
    sel.innerHTML = "";
    Object.keys(profils).forEach(id => {
      const p = profils[id];
      const opt = document.createElement("option");
      opt.value = id;
      opt.textContent = p.label || id;
      sel.appendChild(opt);
    });
    if (actuel && profils[actuel]) sel.value = actuel;
  }

  function afficheTypes(types) {
    const box = el("dossierTypes");
    if (!box) return;
    const cats = types.categories || [];
    const sans = cats.filter(c => !c.active);
    let html = '<div class="card-sub">' +
      "Classifieur v" + esc(types.classifier_version || "?") +
      " — " + cats.length + " catégories connues</div>";
    html += '<div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:8px">';
    cats.slice(0, 14).forEach(c => {
      const cls = c.active ? "pill lang" : "pill";
      html += '<span class="' + cls + '" title="' + esc(c.label) +
        (c.profile ? " — profil " + esc(c.profile) : " — sans profil d'extraction") +
        '">' + esc(c.label) + "</span>";
    });
    html += "</div>";
    if (sans.length) {
      html += '<div class="card-sub" style="margin-top:8px">' +
        sans.length + " catégorie(s) reconnue(s) mais sans indice distinctif : " +
        "un document de ce type sera classé « inconnu » plutôt que deviné.</div>";
    }
    box.innerHTML = html;
  }

  async function chargeDossiers() {
    const box = el("dossierListe");
    if (!box) return;
    box.innerHTML = '<div class="card-sub">Chargement…</div>';
    try {
      const dossiers = await api("/api/dossiers");
      if (!dossiers.length) {
        box.innerHTML = '<div class="card-sub">Aucun dossier. ' +
          "Créez-en un ci-dessus pour regrouper les documents d'un même envoi.</div>";
        return;
      }
      let html = '<table class="tbl"><thead><tr>' +
        "<th>Libellé</th><th>Profil</th><th>Pièces</th><th>État</th><th>Activité</th>" +
        "</tr></thead><tbody>";
      dossiers.forEach(d => {
        const prof = profilsDispo[d.profile];
        const actif = dossierActif && dossierActif.id === d.id;
        html += '<tr data-dossier="' + esc(d.id) + '"' +
          (actif ? ' style="background:var(--surface-2)"' : "") + ">" +
          '<td><button class="btn ghost sm" data-ouvre="' + esc(d.id) + '">' +
          esc(d.label) + "</button></td>" +
          "<td>" + esc((prof && prof.label) || d.profile) + "</td>" +
          "<td>" + (d.pieces ? d.pieces.length : 0) + "</td>" +
          "<td>" + etatBadge(d.state) + "</td>" +
          '<td class="mono dim">' + esc(d.updated_at || d.created_at || "—") + "</td>" +
          "</tr>";
      });
      html += "</tbody></table>";
      box.innerHTML = html;
      box.querySelectorAll("[data-ouvre]").forEach(b => {
        b.addEventListener("click", () => ouvreDossier(b.getAttribute("data-ouvre")));
      });
    } catch (e) {
      box.innerHTML = '<div class="card-sub">Erreur : ' + esc(e.message) + "</div>";
    }
  }

  /* ─────────────────────── dossier sélectionné ─────────────────────── */

  async function ouvreDossier(id) {
    dossierActif = null;
    const box = el("dossierDetail");
    if (!box) return;
    box.innerHTML = '<div class="card-sub">Chargement du dossier…</div>';
    try {
      const d = await api("/api/dossiers/" + encodeURIComponent(id));
      dossierActif = d;
      dessineDossier(d);
      chargeDossiers();
      // le formulaire du dossier se charge en même temps (étape 12). Il n'est
      // pas attendu volontairement : son échec ne doit pas casser l'ouverture
      // du dossier, et il n'y a rien à afficher si le module n'est pas là.
      if (typeof FormulaireUI !== "undefined") FormulaireUI.charge(d.id);
      // la trace se charge avec le dossier : elle porte l'avertissement sur
      // ce que le journal est, et doit être vue en même temps que le dossier.
      if (typeof TracabiliteUI !== "undefined") TracabiliteUI.charge(d.id);
      // l'aperçu de transmission se charge avec le dossier, comme le
      // formulaire et la trace. Il n'envoie jamais rien : l'envoi est un
      // POST déclenché par l'utilisateur, avec confirmation.
      if (typeof TransmissionUI !== "undefined") TransmissionUI.charge(d.id);
    } catch (e) {
      box.innerHTML = '<div class="card-sub">Erreur : ' + esc(e.message) + "</div>";
    }
  }

  function dessineDossier(d) {
    const box = el("dossierDetail");
    if (!box) return;
    const prof = profilsDispo[d.profile] || {};

    let html = "";

    /* en-tête : libellé, profil, état déduit */
    html += '<div class="page-head"><div>' +
      '<div class="ph-kicker">Dossier</div>' +
      '<h3 class="ph-title">' + esc(d.label) + "</h3>" +
      '<p class="ph-sub">' + esc(prof.description || "Profil personnalisé") +
      " — conventions de rangement, aucune obligation réglementaire.</p>" +
      "</div>" +
      '<div class="ph-actions">' + etatBadge(d.state) +
      '<span class="pill">' + (d.pieces || []).length + " pièce(s)</span>" +
      '<span class="pill">v' + esc(String(d.version || 1)) + "</span>" +
      '<button class="btn ghost sm" id="dosRafraichir">↻ Actualiser</button>' +
      "</div></div>";

    /* pièces : classification réelle de chaque document */
    html += '<div class="card"><div class="card-head">' +
      '<div class="card-title">Pièces du dossier</div>' +
      '<div class="card-sub" id="dosPiecesSub">—</div></div>';
    if (!(d.pieces || []).length) {
      html += '<div class="card-sub">Dossier vide. Ajoutez des documents depuis ' +
        "l'onglet Documents, ou avec le bouton ci-dessous.</div>";
    } else {
      html += '<table class="tbl"><thead><tr><th>Fichier</th><th>Catégorie</th>' +
        "<th>Confiance</th><th>Empreinte</th><th></th></tr></thead><tbody>";
      d.pieces.forEach(p => {
        html += "<tr>" +
          "<td>" + esc(p.filename) + "</td>" +
          "<td>" + esc(p.category || "non classé") + "</td>" +
          "<td>" + confianceBadge(p.confidence) + "</td>" +
          '<td class="mono dim" title="' + esc(p.sha256 || "") + '">' +
          esc((p.sha256 || "").slice(0, 12)) + "</td>" +
          '<td><button class="btn ghost sm" data-retire="' + esc(p.job_id) +
          '" title="Retirer du dossier (le document n’est pas supprimé)">✕</button></td>' +
          "</tr>";
      });
      html += "</tbody></table>";
    }
    html += '<div style="margin-top:10px;display:flex;gap:8px;flex-wrap:wrap">' +
      '<input class="inp" id="dosJobId" placeholder="job_id à ajouter" ' +
      'style="flex:1;min-width:220px">' +
      '<button class="btn ghost sm" id="dosAjouter">+ Ajouter une pièce</button>' +
      "</div></div>";

    /* pièces attendues par le profil — rappel, pas une obligation */
    if (prof.pieces && prof.pieces.length) {
      const presentes = {};
      (d.pieces || []).forEach(p => { presentes[p.category] = (presentes[p.category] || 0) + 1; });
      html += '<div class="card"><div class="card-head">' +
        '<div class="card-title">Pièces attendues par le profil</div>' +
        '<div class="card-sub">Ce que le profil décrit comme usage courant</div></div>';
      html += '<table class="tbl"><thead><tr><th>Catégorie</th><th>Attendu</th>' +
        "<th>Présent</th></tr></thead><tbody>";
      prof.pieces.forEach(pc => {
        const n = presentes[pc.category] || 0;
        const ok = n >= (pc.min_count || (pc.required ? 1 : 0));
        html += "<tr><td>" + esc(pc.label || pc.category) + "</td>" +
          "<td>" + (pc.required ? "requis" : "optionnel") + "</td>" +
          "<td>" + (ok ? "✓ " : "") + n + "</td></tr>";
      });
      html += "</tbody></table></div>";
    }

    /* cohérence interdocumentaire */
    html += '<div class="card"><div class="card-head">' +
      '<div class="card-title">Cohérence entre les documents</div>' +
      '<div class="card-sub" id="dosCohSub">—</div>' +
      '<div class="ph-actions"><button class="btn ghost sm" id="dosCohLancer">' +
      "Analyser</button></div></div>" +
      '<div id="dosCoh">Cliquez sur « Analyser » pour comparer les documents ' +
      "entre eux.</div></div>";

    /* paquet de données */
    html += '<div class="card"><div class="card-head">' +
      '<div class="card-title">Paquet de données</div>' +
      '<div class="card-sub">Export structuré, séparé de tout envoi</div></div>' +
      '<div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">' +
      '<button class="btn sm" id="dosXlsx">Excel (.xlsx)</button>' +
      '<button class="btn ghost sm" id="dosJson">JSON</button>' +
      '<button class="btn ghost sm" id="dosZip">ZIP</button>' +
      '<label class="ph-check" for="dosDocs"><input type="checkbox" id="dosDocs">' +
      "<span>inclure les documents originaux dans le ZIP</span></label>" +
      "</div>" +
      '<div id="dosPaquet" class="card-sub" style="margin-top:10px">' +
      "Aucun paquet généré pour l'instant.</div></div>";

    /* Zones des modules frères : formulaire (étape 12) et traçabilité
       (étape 15). Elles sont créées ici parce que dessineDossier réécrit
       tout le contenu de dossierDetail à chaque ouverture — sans ces
       conteneurs, les modules frères n'ont nulle part où s'écrire et
       restent muets sans que rien ne le signale. */
    html += '<div class="card"><div class="card-head">' +
      '<div class="card-title">Formulaire du dossier</div>' +
      '<div class="card-sub">Ce que le dossier décrit, champ par champ</div>' +
      '</div><div id="dossierForm"></div></div>';
    html += '<div class="card"><div class="card-head">' +
      '<div class="card-title">Traçabilité et archivage</div>' +
      '<div class="card-sub">Ce qui s\'est passé sur ce dossier, et son ' +
      'archivage</div>' +
      '</div><div id="dossierTrace"></div></div>';
    html += '<div class="card"><div class="card-head">' +
      '<div class="card-title">Transmission du dossier</div>' +
      '<div class="card-sub">Envoyer les valeurs du dossier vers un ' +
      'connecteur — les documents ne partent pas</div>' +
      '</div><div id="dossierTransmission"></div></div>';

    box.innerHTML = html;

    /* câblage */
    el("dosRafraichir").addEventListener("click", () => ouvreDossier(d.id));
    const btnAdd = el("dosAjouter");
    if (btnAdd) {
      btnAdd.addEventListener("click", () => ajoutePiece(d.id));
    }
    el("dosCohLancer").addEventListener("click", () => analyseCoherence(d.id));
    el("dosXlsx").addEventListener("click", () => generePaquet(d.id, "xlsx"));
    el("dosJson").addEventListener("click", () => generePaquet(d.id, "json"));
    el("dosZip").addEventListener("click", () => generePaquet(d.id, "zip"));
    box.querySelectorAll("[data-retire]").forEach(b => {
      b.addEventListener("click", () => retirePiece(d.id, b.getAttribute("data-retire")));
    });
  }

  /* ─────────────────────── actions ─────────────────────── */

  async function creeDossier() {
    const label = (el("dossierLabel").value || "").trim();
    const profile = el("dossierProfile").value;
    if (!label) { toast("Donnez un libellé au dossier.", "error"); return; }
    if (occupation) return;
    occupation = true;
    try {
      const d = await api("/api/dossiers", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ label: label, profile: profile }),
      });
      el("dossierLabel").value = "";
      toast("Dossier créé : " + d.label, "success");
      dossierActif = d;
      dessineDossier(d);
      chargeDossiers();
    } catch (e) {
      toast("Création refusée : " + e.message, "error");
    } finally {
      occupation = false;
    }
  }

  async function ajoutePiece(dossierId) {
    const jobId = (el("dosJobId").value || "").trim();
    if (!jobId) { toast("Indiquez un identifiant de document (job_id).", "error"); return; }
    try {
      const d = await api("/api/dossiers/" + encodeURIComponent(dossierId) + "/pieces", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ job_id: jobId, filename: jobId }),
      });
      el("dosJobId").value = "";
      toast("Pièce ajoutée.", "success");
      dossierActif = d;
      dessineDossier(d);
      chargeDossiers();
    } catch (e) {
      toast("Ajout refusé : " + e.message, "error");
    }
  }

  async function retirePiece(dossierId, jobId) {
    try {
      const d = await api("/api/dossiers/" + encodeURIComponent(dossierId) +
        "/pieces/" + encodeURIComponent(jobId), { method: "DELETE" });
      toast("Pièce retirée du dossier. Le document n'est pas supprimé.", "info");
      dossierActif = d;
      dessineDossier(d);
      chargeDossiers();
    } catch (e) {
      toast("Retrait refusé : " + e.message, "error");
    }
  }

  async function analyseCoherence(dossierId) {
    const box = el("dosCoh");
    const sub = el("dosCohSub");
    if (!box) return;
    box.innerHTML = '<div class="card-sub">Comparaison des documents…</div>';
    try {
      const r = await api("/api/dossiers/" + encodeURIComponent(dossierId) + "/coherence");
      const constats = r.constats || [];
      if (sub) {
        sub.textContent = constats.length + " constat(s) sur " +
          (r.documents_analyses || 0) + " document(s) analysé(s) — " +
          (r.transmissible ? "transmission autorisée" : "transmission bloquée");
      }
      if (!constats.length) {
        box.innerHTML = '<div class="card-sub">Aucune divergence détectée entre ' +
          "les documents comparés.</div>";
        return;
      }
      let html = "";
      constats.forEach(c => {
        const sev = c.severity === "anomalie" ? "err" : "warning";
        html += '<div class="anom">' +
          '<div style="flex:1">' +
          '<div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">' +
          graviteBadge(c.severity) +
          '<span class="mono dim">' + esc(c.rule) + "</span>" +
          '<span class="pill">' + esc(c.status || "a_trancher") + "</span>" +
          "</div>" +
          '<div style="margin-top:6px">' + esc(c.explication || "") + "</div>";
        if (c.valeurs && c.valeurs.length) {
          html += '<div class="mono dim" style="margin-top:6px">Valeurs relevées : ' +
            esc(c.valeurs.join(" · ")) + "</div>";
        }
        if (c.documents && c.documents.length) {
          html += '<div class="dim" style="margin-top:4px">Documents : ' +
            esc(c.documents.join(", ")) + "</div>";
        }
        html += "</div></div>";
      });
      box.innerHTML = html;
      if (!r.transmissible) {
        toast("Un constat bloquant reste à trancher.", "error");
      }
    } catch (e) {
      box.innerHTML = '<div class="card-sub">Erreur : ' + esc(e.message) + "</div>";
    }
  }

  async function generePaquet(dossierId, fmt) {
    const box = el("dosPaquet");
    if (!box) return;
    const avecDocs = !!(el("dosDocs") && el("dosDocs").checked);
    box.textContent = "Génération du paquet " + fmt + "…";
    try {
      const r = await api("/api/dossiers/" + encodeURIComponent(dossierId) + "/package", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ format: fmt, include_documents: avecDocs }),
      });
      let html = '<div class="stat-row">';
      html += statCarte("Fichier", r.fichier);
      html += statCarte("Taille", octets(r.taille));
      html += statCarte("Documents", String(r.documents));
      html += statCarte("Anomalies", String(r.anomalies));
      html += statCarte("Pièces manquantes", String(r.pieces_manquantes));
      html += "</div>";
      html += '<div class="card-sub" style="margin-top:8px">' +
        "Paquet généré et enregistré côté serveur. Il n'est ni validé ni " +
        "envoyé : ce sont des décisions humaines séparées.</div>";
      box.innerHTML = html;
      toast("Paquet " + r.fichier + " généré (" + octets(r.taille) + ")", "success");
    } catch (e) {
      box.textContent = "Erreur : " + e.message;
      toast("Génération échouée : " + e.message, "error");
    }
  }

  function statCarte(label, valeur) {
    return '<div class="stat"><div class="stat-k">' + esc(label) +
      '</div><div class="stat-v">' + esc(valeur) + "</div></div>";
  }

  /* ─────────────────────── cycle de vie ─────────────────────── */

  async function loadAll() {
    await chargeReferences();
    await chargeDossiers();
    const box = el("dossierDetail");
    if (box && !dossierActif) {
      box.innerHTML = '<div class="card-sub">Sélectionnez un dossier, ou ' +
        "créez-en un, pour voir ses pièces, les contrôles de cohérence et " +
        "générer un paquet de données.</div>";
    }
  }

  function init() {
    const btn = el("dossierCreer");
    if (btn) btn.addEventListener("click", creeDossier);
    const champ = el("dossierLabel");
    if (champ) {
      champ.addEventListener("keydown", e => {
        if (e.key === "Enter") { e.preventDefault(); creeDossier(); }
      });
    }
  }

  return {
    init: init,
    loadAll: loadAll,
    ouvreDossier: ouvreDossier,
    analyseCoherence: analyseCoherence,
    generePaquet: generePaquet,
    creeDossier: creeDossier,
  };
})();

if (typeof document !== "undefined" && document.getElementById("dossierCreer")) {
  DossierUI.init();
}
/* ═══ DOSSIER:END ═══ */

/* ═══ FORMULAIRE:BEGIN — généré par tools/sync_web_module.py depuis web/formulaire.js.
   Ne pas modifier cette section à la main : éditer web/formulaire.js puis lancer
   « python3 tools/sync_web_module.py ». Le test tests/test_web_module_sync.py
   échoue si les deux copies divergent.                                       */
/* ═══ Form builder du dossier — module d'interface (source unique) ═══
   Éditer ce fichier puis lancer « python3 tools/sync_web_module.py ».

   Étape 12 du parcours. Ce module décrit la structure interne d'un dossier :
   quels champs, d'où vient chaque valeur, ce qui reste à remplir.

   Ce qu'il n'est PAS : un formulaire administratif, une soumission, un
   endpoint vers un système externe. Aucun champ n'est inventé — chacun vient
   d'une valeur extraite ou d'un ajout humain explicite, et son origine est
   affichée à côté de lui.

   Aucune ressource externe.                                                        */

const FormulaireUI = (function () {
  "use strict";

  let formulaireActif = null;
  let occupation = false;

  function el(id) { return document.getElementById(id); }

  function origineBadge(origine) {
    const libelles = {
      extrait: "extrait",
      ajoute: "ajout humain",
      calcule: "calculé",
    };
    const cls = { extrait: "info", ajoute: "ok", calcule: "warning" }[origine] || "info";
    return '<span class="badge ' + cls + '">' +
      esc(libelles[origine] || origine) + "</span>";
  }

  function typeBadge(type) { return '<span class="pill">' + esc(type) + "</span>"; }

  /* ─────────────────────────── chargement ─────────────────────────── */

  async function charge(dossierId) {
    const box = el("dossierForm");
    if (!box) return;
    if (!dossierId) {
      box.innerHTML = '<div class="card-sub">Ouvrez d\'abord un dossier.</div>';
      return;
    }
    box.innerHTML = '<div class="card-sub">Construction du formulaire…</div>';
    try {
      const f = await api("/api/dossiers/" + encodeURIComponent(dossierId) + "/formulaire");
      formulaireActif = f;
      dessine(f);
    } catch (e) {
      box.innerHTML = '<div class="card-sub">Erreur : ' + esc(e.message) + "</div>";
    }
  }

  function dessine(f) {
    const box = el("dossierForm");
    if (!box) return;
    const r = f.remplissage || {};

    let html = '<div class="page-head"><div>' +
      '<div class="ph-kicker">Formulaire</div>' +
      '<h3 class="ph-title">' + esc(f.label || "Formulaire du dossier") + "</h3>" +
      '<p class="ph-sub">' + esc(f.description || "") + "</p>" +
      "</div>" +
      '<div class="ph-actions">' +
      '<span class="pill">v' + esc(f.version || "?") + "</span>" +
      '<span class="pill">' + (r.total || 0) + " champ(s)</span>" +
      (r.complet
        ? '<span class="badge ok">complet</span>'
        : '<span class="badge warning">' + (r.requis_manquants || []).length +
          " requis manquant(s)</span>") +
      '<button class="btn ghost sm" id="frmRafraichir">↻ Reconstruire</button>' +
      "</div></div>";

    /* rappel de ce qu'est ce formulaire — et de ce qu'il n'est pas */
    html += '<div class="card-sub" style="margin-bottom:10px">' +
      "Chaque champ indique d'où vient sa valeur. Rien n'est envoyé à un " +
      "organisme : ce formulaire décrit la structure du dossier, il ne la " +
      "transmet pas.</div>";

    if (!(f.champs || []).length) {
      html += '<div class="card"><div class="card-sub">' +
        "Aucun champ : aucun document de ce dossier n'a fourni de valeur " +
        "extractible. Un formulaire vide est affiché comme tel, jamais " +
        "rempli de champs inventés.</div></div>";
      box.innerHTML = html;
      el("frmRafraichir").addEventListener("click",
        () => charge(f.dossier_id));
      return;
    }

    html += '<div class="card"><div class="card-head">' +
      '<div class="card-title">Champs</div>' +
      '<div class="card-sub">' + (r.remplis || 0) + " rempli(s), " +
      (r.valides || 0) + " validé(s) par un humain</div></div>";

    html += '<table class="tbl"><thead><tr><th>Champ</th><th>Clé</th>' +
      "<th>Valeur</th><th>Origine</th><th>État</th><th></th></tr></thead><tbody>";
    (f.champs || []).forEach(c => {
      const vide = c.valeur === null || c.valeur === undefined || c.valeur === "";
      html += "<tr>" +
        "<td>" + esc(c.label || c.key) +
        (c.required ? ' <span class="badge warning">requis</span>' : "") + "</td>" +
        '<td class="mono dim">' + esc(c.key) + "</td>" +
        '<td class="mono">' + (vide ? "—" : esc(String(c.valeur))) + "</td>" +
        "<td>" + origineBadge(c.origine) + " " + typeBadge(c.type) + "</td>" +
        "<td>" + (c.valide
          ? '<span class="badge ok">validé</span>'
          : (vide ? '<span class="badge info">vide</span>'
                  : '<span class="badge warning">à trancher</span>')) + "</td>" +
        '<td><button class="btn ghost sm" data-suppr="' + esc(c.key) +
        '" title="Retirer du formulaire (le document nest pas modifié)">✕</button></td>' +
        "</tr>";
    });
    html += "</tbody></table>";

    if (r.requis_manquants && r.requis_manquants.length) {
      html += '<div class="card-sub" style="margin-top:8px">Champs requis ' +
        "manquants : " + esc(r.requis_manquants.join(", ")) + "</div>";
    }
    html += "</div>";

    /* ajout humain explicite */
    html += '<div class="card"><div class="card-head">' +
      '<div class="card-title">Ajouter un champ</div>' +
      '<div class="card-sub">Un ajout est tracé comme tel, jamais présenté ' +
      "comme une valeur extraite</div></div>" +
      '<div style="display:flex;gap:8px;flex-wrap:wrap;align-items:flex-end">' +
      '<label class="ph-field" for="frmNewKey">Clé</label>' +
      '<input class="inp" id="frmNewKey" placeholder="reference_dossier" ' +
      'style="width:180px">' +
      '<label class="ph-field" for="frmNewLabel">Libellé</label>' +
      '<input class="inp" id="frmNewLabel" placeholder="Référence dossier" ' +
      'style="flex:1;min-width:180px">' +
      '<label class="ph-check" for="frmNewReq"><input type="checkbox" id="frmNewReq">' +
      "<span>requis</span></label>" +
      '<button class="btn" id="frmAjouter">+ Ajouter</button>' +
      "</div></div>";

    box.innerHTML = html;

    el("frmRafraichir").addEventListener("click", () => charge(f.dossier_id));
    el("frmAjouter").addEventListener("click", () => ajoute(f));
    box.querySelectorAll("[data-suppr]").forEach(b => {
      b.addEventListener("click", () => retire(f, b.getAttribute("data-suppr")));
    });
  }

  /* ─────────────────────────── actions ─────────────────────────── */

  async function ajoute(f) {
    const key = (el("frmNewKey").value || "").trim();
    const label = (el("frmNewLabel").value || "").trim();
    if (!key) { toast("La clé du champ est obligatoire.", "error"); return; }
    if (occupation) return;
    occupation = true;
    try {
      const maj = await api("/api/formulaires/" + encodeURIComponent(f.formulaire_id) +
        "/champs", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            key: key, label: label, type: "text",
            required: !!el("frmNewReq").checked,
          }),
        });
      el("frmNewKey").value = "";
      el("frmNewLabel").value = "";
      formulaireActif = maj;
      dessine(maj);
      toast("Champ ajouté, origine « ajout humain ».", "success");
    } catch (e) {
      toast("Ajout refusé : " + e.message, "error");
    } finally {
      occupation = false;
    }
  }

  async function retire(f, key) {
    try {
      const maj = await api("/api/formulaires/" + encodeURIComponent(f.formulaire_id) +
        "/champs/" + encodeURIComponent(key), { method: "DELETE" });
      formulaireActif = maj;
      dessine(maj);
      toast("Champ retiré du formulaire. Le document nest pas modifié.", "info");
    } catch (e) {
      toast("Retrait refusé : " + e.message, "error");
    }
  }

  return {
    charge: charge,
    dessine: dessine,
    ajoute: ajoute,
    retire: retire,
    get actif() { return formulaireActif; },
  };
})();
/* ═══ FORMULAIRE:END ═══ */

/* ═══ TRACABILITE:BEGIN — généré par tools/sync_web_module.py depuis web/tracabilite.js.
   Ne pas modifier cette section à la main : éditer web/tracabilite.js puis lancer
   « python3 tools/sync_web_module.py ». Le test tests/test_web_module_sync.py
   échoue si les deux copies divergent.                            */
/* ═══ Traçabilité du dossier — module d'interface (source unique) ═══
   Éditer ce fichier puis lancer « python3 tools/sync_web_module.py ».

   Étape 15 du parcours. Ce module montre ce qui s'est passé sur un dossier :
   création, ajout de pièces, changements d'état, archivage. Et il permet de
   l'archiver.

   Contrainte structurante, à ne jamais contourner : **le journal applicatif
   n'est pas une preuve inviolable.** Il est écrit par l'application dans un
   fichier texte sur cette machine ; quiconque a un accès administrateur peut
   le modifier. L'avertissement ci-dessous est donc affiché EN PERMANENCE à
   côté de la trace, jamais une fois pour toutes dans une page d'aide, jamais
   caché dans un repli. Si un jour quelqu'un veut le déplacer « pour faire
   plus propre », c'est que la contrainte a été oubliée.

   L'archivage est un état, pas une suppression : rien n'est effacé, et les
   pièces manquantes ne sont pas créées. Aucune ressource externe.            */

const TracabiliteUI = (function () {
  "use strict";

  let traceActive = null;
  let occupation = false;

  function el(id) { return document.getElementById(id); }

  /* libellés lisibles des événements réellement écrits par le journal */
  const LIBELLES = {
    dossier_created: "Dossier créé",
    dossier_piece_added: "Pièce ajoutée",
    dossier_piece_removed: "Pièce retirée",
    dossier_piece_recategorized: "Pièce reclassée",
    dossier_deleted: "Dossier supprimé",
    dossier_state_changed: "État recalculé",
    dossier_state_forced: "État forcé par un humain",
    dossier_archived: "Dossier archivé",
    dossier_form_saved: "Formulaire enregistré",
    dossier_form_deleted: "Formulaire supprimé",
    data_package_generated: "Paquet de données généré",
    job_created: "Document reçu",
    job_done: "Document traité",
    job_error: "Document en erreur",
    job_deduped: "Document déjà connu",
    document_classified: "Document classé",
    field_validated: "Valeur validée par un humain",
    field_decisions_restored: "Décisions humaines réappliquées",
  };

  /* l'acteur distingue l'état déduit de l'état posé à la main : c'est la
     seule façon de voir qu'un état a été forcé malgré ce que montraient
     les pièces réellement présentes. */
  function acteurBadge(detail) {
    const acteur = (detail && detail.acteur) || "systeme";
    if (acteur === "systeme") {
      return '<span class="badge info" title="État déduit des pièces ' +
        'réellement présentes">déduit</span>';
    }
    return '<span class="badge warning" title="État posé par ' +
      esc(acteur) + ', pas déduit des pièces">posé par ' +
      esc(acteur) + "</span>";
  }

  function libelleEvent(event) {
    return LIBELLES[event] || event;
  }

  function horodatage(ts) {
    if (typeof ts !== "number" || !ts) return "—";
    const d = new Date(ts * 1000);
    const pad = n => String(n).padStart(2, "0");
    return pad(d.getDate()) + "/" + pad(d.getMonth() + 1) + "/" +
      d.getFullYear() + " " + pad(d.getHours()) + ":" + pad(d.getMinutes()) +
      ":" + pad(d.getSeconds());
  }

  function resumeDetail(detail) {
    if (!detail) return "";
    const morceaux = [];
    if (detail.from && detail.to) morceaux.push(detail.from + " → " + detail.to);
    if (detail.filename) morceaux.push(esc(detail.filename));
    if (detail.category) morceaux.push(esc(detail.category));
    if (detail.motif) morceaux.push("motif : " + esc(detail.motif));
    if (detail.avertissements) {
      morceaux.push(detail.avertissements + " avertissement(s)");
    }
    if (!morceaux.length) {
      /* on montre le détail brut plutôt que de le taire : une clé qu'on ne
         sait pas résumer vaut mieux qu'une ligne vide. */
      Object.keys(detail).forEach(k => {
        if (k === "acteur") return;
        morceaux.push(k + "=" + esc(String(detail[k])));
      });
    }
    return morceaux.join(" · ");
  }

  /* ─────────────────────── avertissement permanent ─────────────────────── */

  function blocAvertissement(avertissement, garanties, limites) {
    /* Volontairement hors d'un repli : ce texte doit être vu à chaque fois
       qu'on regarde une trace. */
    return '<div class="card" style="border-left:3px solid var(--warn,#c77700)">' +
      '<div class="card-title" style="margin-bottom:6px">Ce que cette trace ' +
      "est — et ce qu'elle n'est pas</div>" +
      '<div class="card-sub" style="margin-bottom:8px">' +
      esc(avertissement || "") + "</div>" +
      '<div style="display:flex;gap:18px;flex-wrap:wrap">' +
      '<div style="flex:1;min-width:220px">' +
      '<div class="card-sub" style="font-weight:600;margin-bottom:4px">' +
      "L'archivage conserve :</div><ul style=\"margin:0;padding-left:18px\">" +
      (garanties || []).map(g => "<li>" + esc(g) + "</li>").join("") +
      "</ul></div>" +
      '<div style="flex:1;min-width:220px">' +
      '<div class="card-sub" style="font-weight:600;margin-bottom:4px">' +
      "L'archivage ne fait pas :</div><ul style=\"margin:0;padding-left:18px\">" +
      (limites || []).map(l => "<li>" + esc(l) + "</li>").join("") +
      "</ul></div></div></div>";
  }

  /* ─────────────────────────── chargement ─────────────────────────── */

  async function charge(dossierId) {
    const box = el("dossierTrace");
    if (!box) return;
    if (!dossierId) {
      box.innerHTML = '<div class="card-sub">Ouvrez d\'abord un dossier.</div>';
      return;
    }
    box.innerHTML = '<div class="card-sub">Lecture du journal…</div>';
    try {
      const t = await api("/api/dossiers/" + encodeURIComponent(dossierId) +
        "/trace");
      traceActive = t;
      dessine(t);
    } catch (e) {
      box.innerHTML = '<div class="card-sub">Erreur : ' + esc(e.message) + "</div>";
    }
  }

  async function chargeAvertissement() {
    try {
      return await api("/api/tracabilite/avertissement");
    } catch (e) {
      /* Même sans cet appel, l'avertissement minimal reste affiché : on ne
         laisse jamais une trace sans son correctif. */
      return {
        avertissement: "Journal applicatif, pas preuve inviolable : il est " +
          "écrit par l'application dans un fichier texte sur cette machine.",
        garanties: [],
        limites: [],
      };
    }
  }

  function dessine(t) {
    const box = el("dossierTrace");
    if (!box) return;
    const entrees = t.entrees || [];

    let html = '<div class="page-head"><div>' +
      '<div class="ph-kicker">Traçabilité</div>' +
      '<h3 class="ph-title">Ce qui s\'est passé sur ce dossier</h3>' +
      '<p class="ph-sub">' + (t.total || 0) + " événement(s) au journal, du " +
      "plus ancien au plus récent.</p></div>" +
      '<div class="ph-actions">' +
      '<span class="pill">' + esc(t.etat || "?") + "</span>" +
      '<button class="btn ghost sm" id="trcRafraichir">↻ Relire le journal</button>' +
      "</div></div>";

    /* l'avertissement est rendu en premier : il cadre la lecture de tout ce
       qui suit, il n'est pas une note de bas de page. */
    html += blocAvertissement(t.avertissement, t.garanties, t.limites);

    /* ── archivage ── */
    const dejaArchive = t.etat === "archive";
    html += '<div class="card"><div class="card-head">' +
      '<div class="card-title">Archiver ce dossier</div>' +
      '<div class="card-sub">L\'archivage est un état, pas une suppression ' +
      ": rien n'est effacé — et aucune pièce manquante n'est créée.</div></div>";
    if (dejaArchive) {
      html += '<div class="card-sub">Ce dossier est déjà archivé. ' +
        "Le rester n'ajoute rien.</div>";
    } else {
      html += '<div style="display:flex;gap:8px;flex-wrap:wrap;' +
        'align-items:flex-end">' +
        '<input class="inp" id="trcMotif" placeholder="Motif (optionnel)" ' +
        'style="flex:1;min-width:200px">' +
        '<button class="btn" id="trcArchiver">Archiver</button></div>';
    }
    html += "</div>";

    /* ── la trace ── */
    html += '<div class="card"><div class="card-head">' +
      '<div class="card-title">Journal</div>' +
      '<div class="card-sub">Les événements marqués « déduit » ont été ' +
      "calculés par l'application ; ceux marqués « posé par » viennent " +
      "d'une action humaine.</div></div>";

    if (!entrees.length) {
      html += '<div class="card-sub">Aucun événement pour ce dossier. Un ' +
        "journal vide est affiché comme tel.</div>";
    } else {
      html += '<table class="tbl"><thead><tr><th>Quand</th><th>Quoi</th>' +
        "<th>Détail</th><th>Acteur</th><th>Document</th></tr></thead><tbody>";
      entrees.forEach(e => {
        const evenementDoc = e.event && e.event.indexOf("job_") === 0 ||
          e.event === "document_classified" ||
          e.event === "field_validated" ||
          e.event === "field_decisions_restored";
        html += "<tr" + (evenementDoc ? ' class="dim"' : "") + ">" +
          '<td class="mono">' + horodatage(e.ts) + "</td>" +
          "<td>" + esc(libelleEvent(e.event)) +
          (evenementDoc
            ? ' <span class="pill" title="Événement du document, pas du dossier">document</span>'
            : "") + "</td>" +
          "<td>" + resumeDetail(e.detail) + "</td>" +
          "<td>" + acteurBadge(e.detail) + "</td>" +
          '<td class="mono">' + (e.job_id ? esc(e.job_id) : "—") + "</td>" +
          "</tr>";
      });
      html += "</tbody></table>";
    }
    html += "</div>";

    box.innerHTML = html;

    const r = el("trcRafraichir");
    if (r) r.addEventListener("click", () => charge(t.dossier_id));
    const a = el("trcArchiver");
    if (a) a.addEventListener("click", () => archiver(t.dossier_id));
  }

  /* ─────────────────────────── archivage ─────────────────────────── */

  async function archiver(dossierId) {
    const motif = (el("trcMotif") ? el("trcMotif").value : "") || "";
    if (occupation) return;
    /* Confirmation explicite : archiver change l'état du dossier de façon
       visible par tous, même si rien n'est supprimé. */
    if (!confirm("Archiver ce dossier ?\n\n" +
      "· aucun document n'est supprimé\n" +
      "· les valeurs extraites et les corrections restent en place\n" +
      "· les pièces manquantes ne sont PAS créées\n" +
      "· le dossier reste consultable et peut repasser en préparation\n\n" +
      "L'archivage ne rend rien inaltérable : le journal reste un fichier " +
      "modifiable sur cette machine.")) {
      return;
    }
    occupation = true;
    try {
      await api("/api/dossiers/" + encodeURIComponent(dossierId) + "/archiver", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ motif: motif.trim() }),
      });
      toast("Dossier archivé. Rien n'a été supprimé.", "success");
      await charge(dossierId);
      /* le reste de l'interface doit refléter le nouvel état */
      if (typeof DossierUI !== "undefined") {
        DossierUI.loadAll();
        DossierUI.ouvreDossier(dossierId);
      }
    } catch (e) {
      toast("Archivage refusé : " + e.message, "error");
    } finally {
      occupation = false;
    }
  }

  return {
    charge: charge,
    dessine: dessine,
    archiver: archiver,
    chargeAvertissement: chargeAvertissement,
    libelleEvent: libelleEvent,
    blocAvertissement: blocAvertissement,
    get actif() { return traceActive; },
  };
})();
/* ═══ TRACABILITE:END ═══ */

/* ═══ TRANSMISSION:BEGIN — généré par tools/sync_web_module.py depuis web/transmission.js.
   Ne pas modifier cette section à la main : éditer web/transmission.js puis lancer
   « python3 tools/sync_web_module.py ». Le test tests/test_web_module_sync.py
   échoue si les deux copies divergent.                            */
/* ═══ Transmission du dossier — module d'interface (source unique) ═══
   Éditer ce fichier puis lancer « python3 tools/sync_web_module.py ».

   Étape 14 du parcours. Ce module envoie le contenu d'un dossier vers un
   connecteur opérationnel — la même discipline que le Connecteur Hub, mais
   la source est le formulaire du dossier (étape 12) et non un document
   isolé.

   Contrainte structurante, à ne jamais contourner : **« envoyé » n'est pas
   « accepté ».** Tant qu'aucune preuve d'acceptation n'est revenue du
   système cible, le dossier n'est pas enregistré. Le rappel est donc rendu
   EN PERMANENCE à côté de tout envoi, jamais une fois pour toutes dans une
   page d'aide. Si un jour quelqu'un veut le déplacer « pour faire plus
   propre », c'est que la contrainte a été oubliée.

   L'envoi exige une confirmation humaine explicite quand le niveau de risque
   l'exige, et le refus vient du serveur — pas de ce module.

   Aucune ressource externe.                                                        */

const TransmissionUI = (function () {
  "use strict";

  let occupation = false;

  function el(id) { return document.getElementById(id); }

  const LIBELLES_ISSUE = {
    missing_required: "manquant",
    unknown_field: "sans correspondance",
    unvalidated_suggestion: "non validé par un humain",
    contradiction: "anomalie non tranchée",
    bad_format: "format douteux",
    ambiguous: "ambigu",
  };

  function severiteBadge(sev) {
    const cls = { error: "warning", warning: "info", info: "info" }[sev] || "info";
    const texte = { error: "bloquant", warning: "à signaler",
                    info: "information" }[sev] || sev;
    return '<span class="badge ' + cls + '">' + esc(texte) + "</span>";
  }

  /* ─────────────────── le rappel permanent, hors de tout repli ─────────────────── */

  function blocNeGarantitPas(neGarantitPas) {
    return '<div class="card" style="border-left:3px solid var(--warn,#c77700)">' +
      '<div class="card-title" style="margin-bottom:6px">Ce que l\'envoi ne ' +
      "garantit pas</div>" +
      '<div class="card-sub" style="margin-bottom:8px">' +
      "Un envoi est une intention. Tant qu'aucune preuve d'acceptation " +
      "n'est revenue du système cible, ce dossier n'est <strong>pas</strong> " +
      "enregistré chez lui.</div>" +
      '<ul style="margin:0;padding-left:18px">' +
      (neGarantitPas || []).map(g => "<li>" + esc(g) + "</li>").join("") +
      "</ul></div>";
  }

  /* ─────────────────────────── aperçu ─────────────────────────── */

  async function charge(dossierId, formId) {
    const box = el("dossierTransmission");
    if (!box) return;
    if (!dossierId) {
      box.innerHTML = '<div class="card-sub">Ouvrez d\'abord un dossier.</div>';
      return;
    }
    box.innerHTML = '<div class="card-sub">Préparation de l\'aperçu…</div>';
    try {
      const url = "/api/dossiers/" + encodeURIComponent(dossierId) +
        "/transmission" + (formId ? "?form_id=" + encodeURIComponent(formId) : "");
      const ap = await api(url);
      apercuActif = ap;
      dessine(ap);
    } catch (e) {
      box.innerHTML = '<div class="card-sub">Erreur : ' + esc(e.message) + "</div>";
    }
  }

  let apercuActif = null;

  function dessine(ap) {
    const box = el("dossierTransmission");
    if (!box) return;

    let html = '<div class="page-head"><div>' +
      '<div class="ph-kicker">Transmission</div>' +
      '<h3 class="ph-title">Envoyer ce dossier</h3>' +
      '<p class="ph-sub">Les valeurs du formulaire, mappées vers le ' +
      "formulaire cible. Les documents eux-mêmes ne partent pas.</p></div>" +
      '<div class="ph-actions">' +
      (ap.transmissible
        ? '<span class="badge ok">prêt à envoyer</span>'
        : '<span class="badge warning">envoi refusé</span>') +
      '<span class="pill">' + (ap.form_id || "aucun formulaire cible") + "</span>" +
      '<button class="btn ghost sm" id="txRafraichir">↻ Recalculer</button>' +
      "</div></div>";

    html += blocNeGarantitPas(ap.ne_garantit_pas);

    /* ce qui part réellement */
    const contenu = ap.contenu || {};
    const champs = contenu.champs || {};
    const cles = Object.keys(champs);
    html += '<div class="card"><div class="card-head">' +
      '<div class="card-title">Ce qui part</div>' +
      '<div class="card-sub">' + cles.length + " valeur(s), et " +
      (ap.pieces || 0) + " pièce(s) <strong>non</strong> jointe(s)</div></div>";
    if (!cles.length) {
      html += '<div class="card-sub">Rien à envoyer pour l\'instant : ' +
        "aucune valeur validée n'est prête.</div>";
    } else {
      html += '<table class="tbl"><thead><tr><th>Champ cible</th>' +
        "<th>Valeur</th></tr></thead><tbody>";
      cles.forEach(k => {
        html += "<tr><td>" + esc(k) + "</td>" +
          '<td class="mono">' + esc(String(champs[k])) + "</td></tr>";
      });
      html += "</tbody></table>";
    }
    html += "</div>";

    /* les points de contrôle */
    if ((ap.issues || []).length) {
      html += '<div class="card"><div class="card-head">' +
        '<div class="card-title">Points de contrôle</div>' +
        '<div class="card-sub">Ce qui bloque, et ce qui mérite d\'être ' +
        "signalé avant l'envoi</div></div>" +
        '<table class="tbl"><thead><tr><th>Quoi</th><th>Champ</th>' +
        "<th>Détail</th><th>Portée</th></tr></thead><tbody>";
      ap.issues.forEach(i => {
        html += "<tr><td>" +
          esc(LIBELLES_ISSUE[i.kind] || i.kind) + "</td>" +
          '<td class="mono">' + esc(i.field || "—") + "</td>" +
          "<td>" + esc(i.message) + "</td>" +
          "<td>" + severiteBadge(i.severity) + "</td></tr>";
      });
      html += "</tbody></table></div>";
    }

    /* suggestions de correspondance — jamais appliquées seules */
    if ((ap.suggestions_mapping || []).length) {
      html += '<div class="card"><div class="card-head">' +
        '<div class="card-title">Correspondances suggérées</div>' +
        '<div class="card-sub">Proposées par similarité de nom. ' +
        "Une suggestion ne remplit rien : à valider avant l'envoi." +
        "</div></div>" +
        '<table class="tbl"><thead><tr><th>Champ du dossier</th>' +
        "<th>Champ cible</th><th>Score</th></tr></thead><tbody>";
      ap.suggestions_mapping.forEach(s => {
        html += "<tr><td>" + esc(s.source_field || "") + "</td>" +
          "<td>" + esc(s.target_field || "") + "</td>" +
          "<td>" + esc(String(s.score != null ? s.score : "—")) + "</td></tr>";
      });
      html += "</tbody></table></div>";
    }

    /* l'envoi, ou la raison du refus */
    html += '<div class="card"><div class="card-head">' +
      '<div class="card-title">Envoyer</div>' +
      '<div class="card-sub">L\'envoi part vers le connecteur ' +
      "opérationnel configuré. Rien n'est envoyé sans votre confirmation." +
      "</div></div>";
    if (!ap.transmissible) {
      const bloquants = (ap.issues || []).filter(i => i.severity === "error");
      html += '<div class="card-sub">Envoi refusé : ' +
        esc(bloquants.map(b => b.message).join(" ; ") ||
            "le dossier n'est pas transmissible") + "</div>";
    } else {
      html += '<div style="display:flex;gap:8px;flex-wrap:wrap;' +
        'align-items:flex-end">' +
        '<label class="ph-field" for="txRisque">Niveau de risque</label>' +
        '<select class="inp" id="txRisque" style="width:180px">' +
        '<option value="low">faible</option>' +
        '<option value="medium" selected>moyen</option>' +
        '<option value="high">élevé</option>' +
        "</select>" +
        '<label class="ph-check" for="txConfirme">' +
        '<input type="checkbox" id="txConfirme"><span>je confirme ' +
        "l'envoi de ces valeurs</span></label>" +
        '<button class="btn" id="txEnvoyer">Envoyer</button></div>' +
        '<div class="card-sub" style="margin-top:6px">Un niveau ' +
        "moyen ou élevé exige la case cochée. Le refus vient du " +
        "serveur, pas de cette page.</div>";
    }
    html += "</div>";

    box.innerHTML = html;

    const r = el("txRafraichir");
    if (r) r.addEventListener("click", () => charge(ap.dossier_id, ap.form_id));
    const e = el("txEnvoyer");
    if (e) e.addEventListener("click", () => envoie(ap));
  }

  /* ─────────────────────────── envoi ─────────────────────────── */

  async function envoie(ap) {
    if (occupation) return;
    if (!el("txConfirme").checked) {
      toast("Cochez la confirmation : l'envoi exige une décision humaine.",
            "error");
      return;
    }
    if (!confirm("Envoyer ce dossier ?\n\n" +
      "· " + Object.keys((ap.contenu || {}).champs || {}).length +
      " valeur(s) partent vers le connecteur\n" +
      "· les documents originaux ne sont PAS joints\n" +
      "· « envoyé » ne veut pas dire « accepté » : sans preuve du système " +
      "cible, ce dossier n'est pas enregistré chez lui\n" +
      "· un second envoi du même contenu ne sera pas renvoyé\n\n" +
      "Confirmer l'envoi ?")) {
      return;
    }
    occupation = true;
    try {
      const regles = (ap.suggestions_mapping || [])
        .filter(s => s.source_field && s.target_field)
        .map(s => ({ source_field: s.source_field,
                     target_field: s.target_field, transform: "none" }));
      const res = await api("/api/dossiers/" +
        encodeURIComponent(ap.dossier_id) + "/transmission", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          form_id: ap.form_id || "",
          rules: regles,
          risk: el("txRisque").value,
          confirmed: true,
          confirmed_by: "utilisateur",
        }),
      });
      const statut = res.transmission.status;
      if (statut === "accepted") {
        toast("Accepté par le système cible — référence " +
              (res.transmission.reference || "?"), "success");
      } else if (statut === "sent") {
        toast("Envoyé. En attente d'une preuve d'acceptation : ce dossier " +
              "n'est pas encore enregistré chez le cible.", "info");
      } else if (statut === "pending_confirmation") {
        toast("Issue inconnue après l'envoi : à rapprocher, jamais supposé " +
              "enregistré.", "warning");
      } else {
        toast("Envoi non abouti (" + statut + ") : " +
              (res.transmission.errors || []).join(" ; "), "error");
      }
      await charge(ap.dossier_id, ap.form_id);
      if (typeof DossierUI !== "undefined") DossierUI.loadAll();
    } catch (e) {
      toast("Envoi refusé : " + e.message, "error");
    } finally {
      occupation = false;
    }
  }

  return {
    charge: charge,
    dessine: dessine,
    envoie: envoie,
    blocNeGarantitPas: blocNeGarantitPas,
    get actif() { return apercuActif; },
  };
})();
/* ═══ TRANSMISSION:END ═══ */

</script>
</body>
</html>
